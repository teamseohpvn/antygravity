---
// Khung chung cho các trang chính sách: breadcrumb, thẻ nội dung, ngày cập nhật, schema WebPage,
// và danh sách các chính sách khác ở cuối trang.
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { POLICY_LINKS, absUrl, breadcrumbSchema, ORG_ID } from '../lib/site';

interface Props {
  path: string;
  title: string;
  seoTitle?: string;
  description: string;
  /** Ngày cập nhật dạng YYYY-MM-DD. Chỉ đổi khi nội dung chính sách thay đổi thực chất. */
  updated: string;
  noindex?: boolean;
}

const { path, title, seoTitle, description, updated, noindex } = Astro.props;
const crumbs = [
  { name: 'Trang chủ', href: '/' },
  { name: title, href: path },
];
const [y, m, d] = updated.split('-');
const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    url: absUrl(path),
    inLanguage: 'vi-VN',
    dateModified: updated,
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': absUrl('/') + '#website' },
  },
  breadcrumbSchema(crumbs),
];
const others = POLICY_LINKS.filter((l) => l.href !== path);
---

<Layout {title} {seoTitle} {description} {noindex} {schemaData} modified={updated}>
  <div class="container policy-page">
    <Breadcrumbs items={crumbs} />
    <article class="policy-card">
      <h1>{title}</h1>
      <p class="updated">Cập nhật: <time datetime={updated}>{d}/{m}/{y}</time></p>
      <slot />
      <nav class="policy-others" aria-label="Chính sách khác">
        <h2>Chính sách khác</h2>
        <ul>{others.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    </article>
  </div>
</Layout>

<style>
  .policy-page { margin-bottom: 60px; }
  .policy-card { background: white; border: 1px solid var(--border-color); border-radius: 8px; padding: clamp(20px, 4vw, 48px); max-width: 900px; }
  .policy-card :global(h1) { color: var(--color-primary); font-size: clamp(1.6rem, 4vw, 2.2rem); line-height: 1.3; margin-bottom: 8px; }
  .policy-card :global(h2) { color: var(--color-primary); font-size: 1.35rem; margin: 32px 0 12px; }
  .policy-card :global(h3) { color: var(--color-primary); font-size: 1.1rem; margin: 20px 0 8px; }
  .policy-card :global(p) { margin-bottom: 14px; }
  .policy-card :global(ul), .policy-card :global(ol) { margin: 0 0 14px 22px; }
  .policy-card :global(li) { margin-bottom: 8px; }
  .policy-card :global(a) { color: var(--color-accent); }
  .policy-card :global(.table-wrap) { overflow-x: auto; margin-bottom: 14px; }
  .policy-card :global(table) { width: 100%; border-collapse: collapse; }
  .policy-card :global(th), .policy-card :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border-color); vertical-align: top; }
  .policy-card :global(th) { color: var(--color-primary); }
  .updated { color: var(--color-text-light); font-size: 0.9rem; margin-bottom: 20px; }
  .policy-others { margin-top: 40px; padding-top: 8px; border-top: 1px solid var(--border-color); }
</style>
