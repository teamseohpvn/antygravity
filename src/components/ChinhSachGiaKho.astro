---
// Chính sách kiểm chứng giá và tồn kho (nội dung người dùng gửi 06/11/2026, giữ ý gốc).
// Thử trên /mo-boi-tron-cong-nghiep trước, duyệt xong mới gắn vào các trang khác.
import { BUSINESS, LEGAL_SHORT } from '../lib/site';

interface Props {
  /** Link tới mục lịch cập nhật trên chính trang đó (ví dụ #cach-viet-bai). Bỏ trống thì trỏ tới /quy-trinh-bien-tap. */
  lichCapNhat?: string;
}
const { lichCapNhat = '/quy-trinh-bien-tap' } = Astro.props;
---

<section class="cs-gia-kho" id="chinh-sach-gia-kho" aria-labelledby="tieu-de-cs-gia-kho">
  <h2 id="tieu-de-cs-gia-kho">Chính sách kiểm chứng giá và tồn kho</h2>
  <ul>
    <li><strong>Hiệu lực báo giá:</strong> mọi mức giá niêm yết trên website chỉ mang tính chất tham khảo tại thời điểm cập nhật. Do biến động thị trường nguyên liệu và tỷ giá, giá chính thức sẽ được xác nhận lại khi quý khách gửi đơn hàng hoặc <a href="/bao-gia">yêu cầu báo giá (RFQ)</a>.</li>
    <li><strong>Thời điểm cập nhật:</strong> dữ liệu giá và tồn kho được cập nhật định kỳ theo <a href={lichCapNhat}>cách chúng tôi biên tập bài viết</a>: giá rà soát mỗi tuần một lần và cập nhật ngay trong ngày khi một mã bất kỳ đổi giá. Quý khách vui lòng liên hệ trực tiếp qua hotline <a href={`tel:${BUSINESS.phone}`} data-track="click_tel">{BUSINESS.phoneDisplay}</a> hoặc email <a href={`mailto:${BUSINESS.email}`} data-track="click_email">{BUSINESS.email}</a> để kiểm tra chính xác số lượng tồn kho thực tế tại kho.</li>
    <li><strong>Xác nhận đơn hàng:</strong> đơn hàng chỉ có hiệu lực pháp lý khi được nhân viên kinh doanh của {LEGAL_SHORT} xác nhận bằng văn bản (email hoặc xác nhận đơn hàng chính thức).</li>
  </ul>
</section>

<style>
  .cs-gia-kho { margin-top: 24px; padding: 18px clamp(14px, 3vw, 24px); background: #f7f9fb; border: 1px solid var(--border-color); border-left: 4px solid var(--color-primary); border-radius: 8px; }
  .cs-gia-kho h2 { margin: 0 0 10px; font-size: 1.35rem; color: var(--color-primary); line-height: 1.3; }
  .cs-gia-kho ul { margin: 0 0 0 20px; line-height: 1.7; }
  .cs-gia-kho li { margin-bottom: 8px; }
  .cs-gia-kho a { color: var(--color-accent); text-decoration: underline; }
</style>
