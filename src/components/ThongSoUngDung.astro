---
// Bảng thông số kỹ thuật (theo TDS) và mục Ứng dụng của trang sản phẩm.
// Mặc định đứng trước thân bài; trang có thong_so_cuoi: true thì đặt sau phần phân tích.
import { tachPhuongPhap } from '../lib/tieu-chuan';
import type { CollectionEntry } from 'astro:content';

interface Props {
  d: CollectionEntry<'sanpham'>['data'];
  /** Thân bài có đoạn gắn nhãn "Nhận định của HT VINA" */
  coNhanDinh?: boolean;
  /** Đặt bên trong khung thân bài (thong_so_cuoi): bỏ khung riêng */
  nested?: boolean;
}
const { d, coNhanDinh = false, nested = false } = Astro.props;
---

    {d.specs && d.specs.length > 0 && (
      <section class:list={['product-content', { nested }]}>
        <h2 id="thong-so-ky-thuat">Thông số kỹ thuật điển hình</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Chỉ tiêu</th><th>Giá trị</th><th>Phương pháp thử</th><th>TCVN tương đương</th></tr></thead>
            <tbody>
              {d.specs.map((s) => {
                const parts = s.method ? tachPhuongPhap(s.method) : [];
                const tcvn = parts.find((p) => p.tc?.tcvn)?.tc;
                return (
                  <tr>
                    <td>{s.name}</td>
                    <td>{s.value}</td>
                    <td>{parts.length ? parts.map((p, i) => <>{i > 0 && ' / '}{p.tc ? <a href={p.tc.url} target="_blank" rel="noopener">{p.text}</a> : p.text}</>) : '–'}</td>
                    <td>{tcvn ? <a href={tcvn.tcvnUrl} target="_blank" rel="noopener" title={tcvn.tcvnNote}>{tcvn.tcvn}</a> : '–'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="note">Giá trị điển hình theo bảng thông số của nhà sản xuất{d.tds_date ? ` (TDS ${d.tds_date})` : ''}, có thể thay đổi theo lô.{coNhanDinh && ' Bảng này là số liệu của hãng; các đoạn gắn nhãn “Nhận định của HT VINA” là ý kiến tư vấn của chúng tôi.'} Phương pháp thử dẫn tới công bố của ASTM, ISO; TCVN tương đương tra tại Viện Tiêu chuẩn Chất lượng Việt Nam.</p>
      </section>
    )}

    {(d.applications?.length || d.not_for?.length) && (
      <section class:list={['product-content', { nested }]}>
        <h2 id="ung-dung">Ứng dụng và khuyến cáo sử dụng</h2>
        {d.applications?.length && <ul>{d.applications.map((a) => <li>{a}</li>)}</ul>}
        {d.not_for?.length && (
          <p><strong>Không nên dùng cho:</strong> {d.not_for.join('; ')}.</p>
        )}
      </section>
    )}

<style>
  .product-content { background: white; padding: clamp(20px, 4vw, 40px); border-radius: 8px; border: 1px solid var(--border-color); margin-bottom: 30px; }
  .product-content.nested { padding: 0; border: 0; border-radius: 0; margin: 32px 0 0; }
  .product-content h2 { color: var(--color-primary); margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color); }
  .table-wrap { overflow-x: auto; }
  .product-content table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  .product-content th, .product-content td { border: 1px solid var(--border-color); padding: 8px 12px; text-align: left; }
  .product-content th { background: #f1f5f9; }
  .note { margin-top: 10px; font-size: 0.9rem; color: var(--color-text-light); }
  .product-content > ul { margin: 0 0 16px 20px; }
  .product-content > ul li { margin-bottom: 6px; }
</style>
