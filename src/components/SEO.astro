---
interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  keywords?: string[];
  canonical?: string;
  type?: 'website' | 'article' | 'product';
  schemaData?: any;
}

const { title, seoTitle, description, keywords, canonical, type = 'website', schemaData } = Astro.props;
const siteName = "Chuyên Trang Dầu Công Nghiệp Chính Hãng";
const fullTitle = seoTitle ? seoTitle : `${title} | ${siteName}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonical || Astro.url.href} />

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteName} />

{schemaData && (
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
)}
