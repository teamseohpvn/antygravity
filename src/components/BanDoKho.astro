---
// Bản đồ kho trên Google Maps + nút chỉ đường mở hồ sơ Google Business (cid). Dùng ở /contact và /about.
// iframe tải lười (loading="lazy") để không làm chậm phần đầu trang.
import { BUSINESS, ADDRESS_FULL, MAP_EMBED_URL } from '../lib/site';
---

<figure class="ban-do-kho">
  <iframe
    src={MAP_EMBED_URL}
    title={`Bản đồ kho Dầu Công Nghiệp HP: ${ADDRESS_FULL}`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
  <figcaption>
    {ADDRESS_FULL} ·
    <a href={BUSINESS.gbpUrl} target="_blank" rel="noopener" data-track="click_directions">Chỉ đường đến kho trên Google Maps</a>
  </figcaption>
</figure>

<style>
  .ban-do-kho { margin: 24px 0; }
  .ban-do-kho iframe { display: block; width: 100%; height: 400px; border: 1px solid var(--border-color); border-radius: 8px; }
  .ban-do-kho figcaption { margin-top: 8px; font-size: 0.9rem; }
  .ban-do-kho a { color: var(--color-accent); font-weight: 600; }
  @media (max-width: 600px) { .ban-do-kho iframe { height: 300px; } }
</style>
