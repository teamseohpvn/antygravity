---
// Trang một bài viết blog. Dùng chung cho /ho-tro-ky-thuat/<tên file> và bài có URL riêng (duong_dan).
import Layout from '../layouts/Layout.astro';
import ContentBody from '../components/ContentBody.astro';
import NoiDungBai from '../components/NoiDungBai.astro';
import MucLuc from '../components/MucLuc.astro';
import { mucLuc } from '../lib/muc-luc';
import { render } from 'astro:content';
import { postPath } from '../lib/content';
import type { CollectionEntry } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CoTheQuanTam from '../components/CoTheQuanTam.astro';
import { absUrl, breadcrumbSchema, ORG_ID, SITE_NAME } from '../lib/site';
import { DEFAULT_REVIEWER_ID, bylineLabel, personRef, personSchema, personUrl, timNhanSu } from '../lib/nhan-su';
import { ngayBai } from '../lib/ngay';

interface Props { post: CollectionEntry<'blog'> }

const { post } = Astro.props;
const { Content, headings } = await render(post);
// Mục lục H2 + H3, chèn ngay sau đoạn mở đầu (đoạn trả lời nhanh vẫn ở trên cùng).
const tocItems = mucLuc(headings, { voiH3: true, tat: post.data.muc_luc === false });

const pagePath = postPath(post);
// Bài đã tự viết mục "Xem thêm" (thẻ ảnh trong thân bài) thì khối "Có thể bạn cũng quan tâm" bỏ phần thẻ.
const coXemThem = /^##\s*Xem thêm|\*\*Xem thêm:?\*\*/m.test(post.body ?? '');
// Tác giả có hồ sơ trong nhan-su.ts (author = id hoặc họ tên) thì link tới trang hồ sơ và gắn schema Person đầy đủ.
const authorP = timNhanSu(post.data.author);
// Người duyệt nội dung: reviewed_by, mặc định TS. Lập (bỏ qua nếu trùng tác giả).
const reviewerRaw = timNhanSu(post.data.reviewed_by) ?? timNhanSu(DEFAULT_REVIEWER_ID);
const reviewerP = reviewerRaw && reviewerRaw.id !== authorP?.id ? reviewerRaw : undefined;
// Ngày đăng / cập nhật: cùng một giá trị cho chữ trên trang, schema và thẻ meta.
const ngay = ngayBai(post.data);
const crumbs = [
  { name: 'Trang chủ', href: '/' },
  { name: 'Hỗ trợ kỹ thuật', href: '/ho-tro-ky-thuat' },
  { name: post.data.title, href: pagePath },
];

// @id để khối articleBody (NoiDungBai) gộp vào đúng thực thể Article.
const ARTICLE_ID = absUrl(pagePath) + '#article';
const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': ARTICLE_ID,
    headline: post.data.title,
    description: post.data.description,
    url: absUrl(pagePath),
    ...(post.data.image ? { image: absUrl(post.data.image) } : {}),
    mainEntityOfPage: absUrl(pagePath),
    // Chưa có tác giả thật thì ghi doanh nghiệp, không dùng tên giả định.
    author: authorP
      ? personRef(authorP)
      : post.data.author
      ? { '@type': 'Person', name: post.data.author, ...(post.data.author_title ? { jobTitle: post.data.author_title } : {}) }
      : { '@id': ORG_ID },
    datePublished: ngay.published,
    dateModified: ngay.modified,
    publisher: { '@id': ORG_ID },
    ...(post.data.citations?.length ? { citation: post.data.citations } : {}),
  },
  // reviewedBy là thuộc tính của WebPage, nên gắn vào khối WebPage bao bài viết.
  ...(reviewerP
    ? [{
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        url: absUrl(pagePath),
        name: post.data.seo_title ?? post.data.title,
        inLanguage: 'vi-VN',
        reviewedBy: personRef(reviewerP),
        ...(ngay.modified ? { lastReviewed: ngay.modified } : {}),
        publisher: { '@id': ORG_ID },
      }]
    : []),
  ...(authorP ? [personSchema(authorP)] : []),
  ...(reviewerP && reviewerP.id !== authorP?.id ? [personSchema(reviewerP)] : []),
  breadcrumbSchema(crumbs),
];
---

<Layout 
  title={post.data.title}
  seoTitle={post.data.seo_title}
  description={post.data.description}
  image={post.data.image}
  type="article"
  published={ngay.published}
  modified={ngay.modified}
  schemaData={schemaData}
>
  <div class="container blog-container">
    <Breadcrumbs items={crumbs} />

    <article class="blog-post">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <div class="meta">
          Đăng ngày <time datetime={ngay.published}>{ngay.publishedText}</time>
          {ngay.modified !== ngay.published && <> · Cập nhật ngày <time datetime={ngay.modified}>{ngay.modifiedText}</time></>}
          {' · '}{authorP
            ? <a href={personUrl(authorP)} rel="author">{bylineLabel(authorP)}</a>
            : <span>{post.data.author ?? SITE_NAME}</span>}
          {reviewerP && <> · Duyệt nội dung: <a href={personUrl(reviewerP)}>{bylineLabel(reviewerP)}</a></>}
        </div>
        {post.data.tags && (
          <div class="tags">
            {post.data.tags.map(tag => (
              <span class="badge">{tag}</span>
            ))}
          </div>
        )}
      </header>

      {post.data.image && (
        <div class="featured-image">
          <img src={post.data.image} alt={post.data.image_alt ?? post.data.title} width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
        </div>
      )}

      <div class="markdown-body">
        <NoiDungBai articleId={ARTICLE_ID}>
          <ContentBody><Content /><MucLuc slot="sau-doan-dau" items={tocItems} /></ContentBody>
          <CoTheQuanTam {post} boThe={coXemThem} />
        </NoiDungBai>
      </div>
    </article>
  </div>
</Layout>

<style>
  .blog-container { max-width: 900px; margin: 40px auto; }
  .breadcrumbs { margin-bottom: 30px; color: var(--color-text-light); font-size: 0.9rem; }
  .breadcrumbs a { color: var(--color-primary); }
  
  .blog-post { background: white; padding: 50px; border-radius: 8px; border: 1px solid var(--border-color); }
  .post-header { margin-bottom: 30px; text-align: center; }
  .post-header h1 { color: var(--color-primary); font-size: 2.5rem; line-height: 1.3; margin-bottom: 15px; }
  .meta { color: var(--color-text-light); font-size: 0.95rem; margin-bottom: 15px; }
  
  .tags { display: flex; justify-content: center; gap: 10px; margin-bottom: 20px; }
  .badge { background: #e2e8f0; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 500; }
  
  .featured-image { margin-bottom: 40px; }
  .featured-image img { width: 100%; border-radius: 8px; }
  
  /* Markdown Content Styles */
  .markdown-body { font-size: 1.1rem; line-height: 1.8; color: var(--color-text); }
  /* Khối "Tóm tắt" viết bằng blockquote trong Markdown. */
  .markdown-body :global(blockquote) { margin: 20px 0 28px; padding: 14px 18px; background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-left: 4px solid var(--color-primary); border-radius: 6px; }
  .markdown-body :global(blockquote p) { margin: 0 0 6px; }
  .markdown-body :global(blockquote ul) { margin: 0 0 0 20px; }
  .markdown-body :global(blockquote li) { margin-bottom: 6px; }
  .markdown-body h2 { color: var(--color-primary); margin: 30px 0 15px; font-size: 1.8rem; }
  .markdown-body h3 { color: var(--color-primary); margin: 25px 0 10px; font-size: 1.4rem; }
  .markdown-body p { margin-bottom: 20px; }
  .markdown-body ul, .markdown-body ol { margin-left: 20px; margin-bottom: 20px; }
  .markdown-body li { margin-bottom: 10px; }
  .markdown-body strong { color: #111; }

  /* Bảng trong bài (khung do src/lib/bang-markdown.mjs bọc), cùng kiểu bảng trang /bao-gia-mo-boi-tron. */
  .markdown-body :global(.table-wrap) { overflow-x: auto; margin: 8px 0 20px; }
  .markdown-body :global(table.match) { width: 100%; border-collapse: collapse; font-size: 0.95rem; line-height: 1.55; }
  .markdown-body :global(.match th), .markdown-body :global(.match td) { border: 1px solid var(--border-color, #e2e8f0); padding: 10px 12px; text-align: left; vertical-align: top; }
  .markdown-body :global(.match th) { background: #f1f5f9; font-weight: 600; }
  .markdown-body :global(.match a) { color: var(--color-primary); text-decoration: underline; }

  @media (max-width: 640px) {
    .blog-container { margin: 16px auto; }
    .blog-post { padding: 20px 16px; }
    .post-header h1 { font-size: 1.7rem; }
    .markdown-body { font-size: 1rem; }
    .markdown-body h2 { font-size: 1.45rem; }
    .markdown-body h3 { font-size: 1.2rem; }
    /* Mỗi dòng bảng thành một thẻ: ô đầu làm tiêu đề thẻ, các ô sau ghi "Tên cột: giá trị". */
    .markdown-body :global(.match thead) { display: none; }
    .markdown-body :global(.match), .markdown-body :global(.match tbody), .markdown-body :global(.match tr), .markdown-body :global(.match td) { display: block; width: 100%; }
    .markdown-body :global(.match tr) { border: 1px solid var(--border-color, #e2e8f0); border-radius: 6px; margin-bottom: 10px; overflow: hidden; }
    .markdown-body :global(.match td) { border: 0; border-top: 1px solid #eef1f4; padding: 8px 12px; }
    .markdown-body :global(.match td:first-child) { border-top: 0; background: #f1f5f9; font-weight: 600; color: var(--color-primary); }
    .markdown-body :global(.match td[data-label]:not(:first-child)::before) { content: attr(data-label) ': '; font-weight: 600; color: #555; }
  }
</style>
