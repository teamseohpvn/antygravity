---
// Bọc phần nội dung chính của một trang: hiển thị nguyên HTML, đồng thời thêm khối JSON-LD bổ sung văn bản thuần
// của chính phần này (articleBody cho Article, text cho WebPage) vào thực thể có cùng @id. Không viết thêm chữ nào.
interface Props {
  /** @id của thực thể trong schema của trang, ví dụ https://.../bao-gia-dau-thuy-luc#article */
  articleId: string;
  /** @type trùng với thực thể gốc (mặc định Article) */
  type?: string | string[];
  /** articleBody cho Article, text cho WebPage/ItemPage/CollectionPage */
  field?: 'articleBody' | 'text';
}
const { articleId, type = 'Article', field = 'articleBody' } = Astro.props;
const html = await Astro.slots.render('default');
const text = html
  .replace(/<(script|style|noscript|svg|form|aside)[\s\S]*?<\/\1>/gi, ' ')
  .replace(/<\/(p|li|h[1-6]|tr|div|section|blockquote|figcaption)>/gi, '$&\n')
  .replace(/<[^>]+>/g, ' ')
  .replace(/&nbsp;/g, ' ')
  .replace(/&amp;/g, '&')
  .replace(/&quot;/g, '"')
  .replace(/&#39;/g, "'")
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/[ \t]+/g, ' ')
  .replace(/\s*\n\s*/g, '\n')
  .trim();
const schema = {
  '@context': 'https://schema.org',
  '@type': type,
  '@id': articleId,
  [field]: text,
  wordCount: text.split(/\s+/).filter(Boolean).length,
};
---

<Fragment set:html={html} />
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
