---
// Mục lục cố định cột phải cho bài dài (màn hình ≥ 1100px). Mục đang đọc được tô đậm theo vị trí cuộn.
// Cùng danh sách mục với MucLuc.astro (mục lục trong thân bài); trên điện thoại chỉ hiện mục lục trong thân bài.
// Quy tắc hiển thị: docs/CAU-TRUC-NOI-DUNG.md mục "Mục lục".
import type { MucLucItem } from '../lib/muc-luc';

interface Props {
  items: MucLucItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <nav class="muc-luc-ben" aria-label="Mục lục bài viết" data-muc-luc-ben>
    <p class="mlb-tieu-de">Nội dung chính</p>
    <ol>
      {items.map((h) => (
        <li class={h.depth === 3 ? 'cap-3' : undefined}>
          <a href={`#${h.slug}`} data-muc={h.slug}>{h.text}</a>
        </li>
      ))}
    </ol>
    <a class="mlb-len-dau" href="#">↑ Lên đầu trang</a>
  </nav>
)}

<script>
  // Tô đậm mục đang đọc: mục cuối cùng có tiêu đề đã cuộn qua mép trên (dưới thanh header dính).
  function khoiTao() {
    const nav = document.querySelector<HTMLElement>('[data-muc-luc-ben]');
    if (!nav) return;
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[data-muc]'));
    const muc = links
      .map((a) => ({ a, h: document.getElementById(a.dataset.muc ?? '') }))
      .filter((m): m is { a: HTMLAnchorElement; h: HTMLElement } => !!m.h);
    if (!muc.length) return;

    const MEP_TREN = 120; // header dính khoảng 90px + khoảng đệm
    let dangChon: HTMLAnchorElement | null = null;
    let cho = false;

    function capNhat() {
      cho = false;
      let hienTai = muc[0];
      for (const m of muc) {
        if (m.h.getBoundingClientRect().top - MEP_TREN <= 0) hienTai = m;
        else break;
      }
      // Cuộn sát cuối trang thì chọn mục cuối (mục ngắn cuối bài không bao giờ chạm mép trên).
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
        hienTai = muc[muc.length - 1];
      }
      if (hienTai.a === dangChon) return;
      dangChon?.removeAttribute('aria-current');
      hienTai.a.setAttribute('aria-current', 'location');
      dangChon = hienTai.a;
      // Giữ mục đang chọn trong vùng nhìn thấy của cột mục lục (mục lục dài hơn màn hình).
      const top = hienTai.a.offsetTop - nav.clientHeight / 3;
      nav.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    }

    window.addEventListener('scroll', () => {
      if (!cho) { cho = true; requestAnimationFrame(capNhat); }
    }, { passive: true });
    window.addEventListener('resize', capNhat);
    capNhat();
  }
  khoiTao();
</script>

<style>
  .muc-luc-ben {
    position: sticky;
    top: 90px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    padding: 14px 4px 14px 0;
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .mlb-tieu-de { margin: 0 0 10px 14px; font-weight: 700; color: var(--color-primary); text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.04em; }
  .muc-luc-ben ol { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--border-color, #e2e8f0); }
  .muc-luc-ben li { margin: 0; }
  .muc-luc-ben li.cap-3 a { padding-left: 26px; font-size: 0.86rem; }
  .muc-luc-ben a[data-muc] {
    display: block;
    padding: 6px 10px 6px 12px;
    margin-left: -2px;
    border-left: 2px solid transparent;
    color: var(--color-text-light, #64748b);
    text-decoration: none;
  }
  .muc-luc-ben a[data-muc]:hover { color: var(--color-primary); }
  .muc-luc-ben a[aria-current] {
    color: var(--color-primary);
    font-weight: 700;
    border-left-color: var(--color-primary);
    background: #f1f5f9;
  }
  .mlb-len-dau { display: inline-block; margin: 14px 0 0 14px; font-size: 0.85rem; color: var(--color-text-light, #64748b); text-decoration: none; }
  .mlb-len-dau:hover { color: var(--color-primary); text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) {
    .muc-luc-ben { scroll-behavior: auto; }
  }
</style>
