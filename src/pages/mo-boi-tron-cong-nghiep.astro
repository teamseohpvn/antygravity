---
// Trang danh mục mỡ bôi trơn (phát hành 05/11/2026, viết theo audit check_EEAT và điều tra trải nghiệm).
// Trang này thay mẫu src/pages/[category]/index.astro cho riêng danh mục này, gồm lưới sản phẩm và bảng so sánh riêng.
// Thân bài nằm ở src/nhap/mo-boi-tron/; src/content/danhmuc/mo-boi-tron-cong-nghiep.md chỉ còn giữ frontmatter cho menu và sitemap.
import Layout from '../layouts/Layout.astro';
import NoiDungBai from '../components/NoiDungBai.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteCta from '../components/QuoteCta.astro';
import ContentBody from '../components/ContentBody.astro';
import { Content as ChonMo } from '../nhap/mo-boi-tron/1-chon-mo.md';
import { Content as DocBang } from '../nhap/mo-boi-tron/2-doc-bang.md';
import { Content as DoiChieu } from '../nhap/mo-boi-tron/3-doi-chieu.md';
import { Content as VanHanh } from '../nhap/mo-boi-tron/4-van-hanh.md';
import { Content as SuCo } from '../nhap/mo-boi-tron/5-su-co.md';
import { Content as Cuoi } from '../nhap/mo-boi-tron/6-cuoi.md';
import giaJson from '../data/gia-cong-khai.json';
import { timNhanSu, bylineLabel, personUrl, personRef, personSchema, bylineTitle } from '../lib/nhan-su';
import { absUrl, breadcrumbSchema, ORG_ID, webpSrcset, productImages, BUSINESS } from '../lib/site';
import { getActiveProducts } from '../lib/content';

const pagePath = '/mo-boi-tron-cong-nghiep';
const CAT = '/mo-boi-tron-cong-nghiep';
const IMAGE = '/images/danh-muc/mo-boi-tron-cong-nghiep.webp';
const NGAY_DANG = '2026-09-21';
const title = 'Mỡ Bôi Trơn Công Nghiệp (Mỡ Bò) | Chính Hãng Giá Tốt';
const description = 'Cách chọn mỡ bôi trơn (mỡ bò) theo cấp NLGI, nhiệt độ & vị trí làm việc, tải gối đỡ & trục, loại máy. Xem TDS từng mã các hãng Shell, Sinopec, ENEOS, VHP.';
const tacGia = timNhanSu('nguyen-thi-hong')!;
const reviewer = timNhanSu('vu-minh-toan')!;
const NGAY = '2026-11-06';
const NGAY_GIA = (giaJson as any).cau_hinh.ngay_ra_soat as string;
const fmtNgay = (s: string) => s.split('-').reverse().join('/');
const THANG_GIA = fmtNgay(NGAY_GIA).slice(3); // MM/YYYY, đổi theo ngày rà soát giá.

// NGUỒN KHO DUY NHẤT của trang: stock_status + packaging trong src/content/sanpham/*.md (đọc tay 03/11/2026).
// Không dùng san-pham-kho.json (chỉ có 3 dòng mỡ, sinh từ file kho tháng 10).
type Dong = {
  ten: string; link: string; lam_dac: string; cap: string; dau40: string; nho_giot: string; lam_viec: string; hbi: string;
  co_san: string; nhan_dat?: string; ghi_chu?: string;
};
const BANG: Dong[] = [
  { ten: 'Shell Gadus S2 V220 2', link: `${CAT}/shell-gadus-s2-v220-2`, lam_dac: 'Lithium', cap: '2', dau40: '220 cSt', nho_giot: '180 °C', lam_viec: '-20 đến 130 °C', hbi: 'Có phụ gia EP, TDS không ghi số', co_san: 'NLGI 2: xô 18 kg' },
  { ten: 'ENEOS Epnoc Grease AP(N)', link: `${CAT}/eneos-epnoc-ap`, lam_dac: 'Lithium', cap: '0 / 1 / 2 / 3', dau40: '– (TDS ghi ở 100 °C: 13,3–16,4 mm²/s)', nho_giot: '195–203 °C', lam_viec: '-20 đến 125 °C', hbi: '3.090 N (khoảng 315 kg)', co_san: 'Liên hệ để xác nhận cấp và quy cách', ghi_chu: 'cho' },
  { ten: 'Sinopec Crystal Grease NLGI 3', link: `${CAT}/sinopec-crystal-grease-nlgi-3`, lam_dac: 'Lithium', cap: '2 / 3', dau40: '– (TDS ghi ở 100 °C: 9–13 cSt)', nho_giot: '≥ 180 °C', lam_viec: '-20 đến 120 °C', hbi: '–', co_san: 'NLGI 2, NLGI 3: xô 17 kg, phuy 180 kg', nhan_dat: 'NLGI 1' },
  { ten: 'Sinopec Crystal Grease T3', link: `${CAT}/sinopec-crystal-grease-t3`, lam_dac: 'Lithium', cap: 'T3', dau40: '–', nho_giot: '≥ 180 °C', lam_viec: '-20 đến 120 °C', hbi: '–', co_san: 'T3: xô 17 kg, phuy 180 kg' },
  { ten: 'Sinopec Golden Grease', link: `${CAT}/sinopec-golden-grease`, lam_dac: 'Xà phòng kim loại', cap: '2 / 3', dau40: '–', nho_giot: '152–155 °C', lam_viec: '-20 đến 110 °C', hbi: '–', co_san: 'NLGI 2, NLGI 3: xô 17 kg, phuy 180 kg' },
  { ten: 'VHP Lithium Grease', link: `${CAT}/vhp-lithium-grease`, lam_dac: 'Lithium', cap: '00 / 0 / 3 / 4', dau40: '220 cSt', nho_giot: '≥ 190 °C', lam_viec: '-10 đến 120 °C', hbi: '200 kg', co_san: 'L4: xô 17 kg', nhan_dat: 'L00, L0, L3' },
  { ten: 'VHP MP Grease', link: `${CAT}/vhp-mp-grease`, lam_dac: 'Lithium', cap: '2 / 3 / 4', dau40: '150 cSt', nho_giot: '≥ 180 °C', lam_viec: '-10 đến 120 °C', hbi: '200 kg', co_san: 'L2: phuy 180 kg · L3: xô 15 kg, xô 17 kg, phuy 180 kg · L4: xô 17 kg', nhan_dat: 'L0, L00, L000' },
  { ten: 'VHP Licas Grease', link: `${CAT}/licas-grease`, lam_dac: 'Lithium-canxi', cap: '2 / 3', dau40: '150 cSt', nho_giot: '≥ 130 °C', lam_viec: '-10 đến 110 °C', hbi: '180 kg', co_san: 'No3: thùng 30 ống 400 g', nhan_dat: 'No2' },
  { ten: 'VHP Caxilium Grease', link: `${CAT}/vhp-caxilium-grease`, lam_dac: 'Lithium-canxi', cap: '2 / 3', dau40: '–', nho_giot: '141 °C (No2)', lam_viec: '-10 đến 110 °C', hbi: '–', co_san: 'No2, No3: phuy 180 kg' },
  { ten: 'VHP Opal Grease', link: `${CAT}/vhp-opal-grease`, lam_dac: 'Lithium-canxi', cap: '3 / 4', dau40: '–', nho_giot: '140 °C (NLGI 3)', lam_viec: '-10 đến 120 °C', hbi: '–', co_san: 'NLGI 3: phuy 180 kg · NLGI 4: xô 15 kg' },
  { ten: 'PVOIL PV Grease', link: `${CAT}/pvoil-pv-grease`, lam_dac: 'Hãng chưa công bố trong bảng thông số', cap: '2 / 3', dau40: '–', nho_giot: '≥ 140 °C', lam_viec: 'Xem ghi chú dưới bảng', hbi: '–', co_san: 'No2, No3: phuy 180 kg' },
  { ten: 'Calix Ceno No3', link: `${CAT}/calix-ceno-grease`, lam_dac: 'Canxi tổng hợp', cap: '3', dau40: '–', nho_giot: '≥ 120 °C', lam_viec: '-10 đến 100 °C', hbi: '–', co_san: 'No3: phuy 180 kg' },
  { ten: 'Shell Gadus S3 V220C 2 (nhóm mỡ chịu nhiệt)', link: '/mo-chiu-nhiet/shell-gadus-s3-v220c-2', lam_dac: 'Lithium complex', cap: '2', dau40: '220 cSt', nho_giot: '240 °C', lam_viec: '-20 đến 140 °C (đỉnh 150 °C)', hbi: '315 kg (tối thiểu)', co_san: 'NLGI 2: xô 18 kg' },
];

// Lưới sản phẩm: thứ tự và thông số lấy từ BANG, tên và ảnh lấy từ trang sản phẩm. Gadus S3 thuộc /mo-chiu-nhiet nên ghi rõ nhóm trên thẻ.
const VI_TRI = [
  { ma: 'goi-do', ten: 'Gối đỡ, khớp nối tải thường', ids: ['vhp-caxilium-grease', 'licas-grease', 'vhp-opal-grease', 'vhp-mp-grease', 'sinopec-crystal-grease-nlgi-3', 'sinopec-crystal-grease-t3', 'sinopec-golden-grease'] },
  { ma: 'tai-nang', ten: 'Tải nặng, va đập', ids: ['shell-gadus-s2-v220-2', 'eneos-epnoc-ap'] },
  { ma: 'bom-tap-trung', ten: 'Hệ bơm mỡ tập trung', ids: ['vhp-lithium-grease', 'eneos-epnoc-ap'] },
  { ma: 'vo-o-90-100', ten: 'Vỏ ổ 90–100 °C, tải thường', ids: ['vhp-mp-grease', 'sinopec-crystal-grease-nlgi-3', 'vhp-opal-grease'] },
  { ma: 'o-nong', ten: 'Vỏ ổ 100–120 °C', ids: ['shell-gadus-s3-v220c-2'] },
];
const sanPham = await getActiveProducts();
const THE = BANG.map((d) => {
  const id = d.link.split('/').pop()!;
  const p = sanPham.find((x) => x.id === id);
  if (!p) return null;
  const caps = d.cap.split('/').map((c) => c.trim());
  return { d, id, ten: p.data.title, hang: p.data.brand, anh: productImages(p.data)[0], caps, viTri: VI_TRI.filter((v) => v.ids.includes(id)).map((v) => v.ma), chiuNhiet: !d.link.startsWith(CAT) };
}).filter(Boolean) as { d: Dong; id: string; ten: string; hang: string; anh?: { src: string; alt: string }; caps: string[]; viTri: string[]; chiuNhiet: boolean }[];
const CAC_HANG = [...new Set(THE.map((t) => t.hang))].sort();
const CAC_CAP = ['00', '0', '1', '2', '3', 'T3', '4'].filter((c) => THE.some((t) => t.caps.includes(c)));
const NHOM_LOC = [
  { nhom: 'vi-tri', ten: 'Theo vị trí', muc: VI_TRI.map((v) => [v.ma, v.ten]) },
  { nhom: 'hang', ten: 'Theo hãng', muc: CAC_HANG.map((h) => [h, h]) },
  { nhom: 'cap', ten: 'Theo cấp NLGI', muc: CAC_CAP.map((c) => [c, `NLGI ${c}`]) },
];

// Chi phí: chỉ lấy khoảng giá từ gia-cong-khai.json, không ghi tay.
const G_DIEM_NAM = 60; // 6310: Gp ≈ 15 g × 4 lần/năm, chỉ để minh họa
const hang = (giaJson as any).rows as any[];
const dong = (ten: string, kg?: number) => {
  const r = hang.find((x) => x.ten === ten);
  if (!r?.thap) return null;
  const thap = r.thap_don_vi ?? (kg ? r.thap / kg : null);
  const cao = r.cao_don_vi ?? (kg ? r.cao / kg : null);
  return thap && cao ? { ten: r.ten, qc: r.quy_cach, link: `/${r.danh_muc}/${r.trang}`, thap, cao } : null;
};
const CHI_PHI = [
  dong('PVOIL PV Grease No2'), dong('PVOIL PV Grease No3'), dong('VHP Caxilium Grease No2'), dong('Calix Ceno Grease No3'),
  dong('VHP Opal Grease NLGI 3'), dong('VHP Licas Grease No3', 12), dong('VHP Opal Grease NLGI 4'), dong('VHP Lithium Grease L4'),
  dong('Shell Gadus S3 V220C 2'), dong('Shell Gadus S2 V220 2'),
  dong('VHP MP Grease L3'), dong('Sinopec Golden Grease NLGI 2, NLGI 3'), dong('Sinopec Crystal Grease NLGI 3'), dong('Sinopec Crystal Grease T3'),
].filter(Boolean).sort((a: any, b: any) => a.thap - b.thap) as { ten: string; qc: string; link: string; thap: number; cao: number }[];
const vnd = (n: number) => n.toLocaleString('vi-VN');
const lam100 = (n: number) => Math.round(n / 100) * 100;

// Danh sách TDS hiển thị (audit #6). "Ngày tra cứu" là ngày đã mở lại nguồn.
const TDS = [
  { ten: 'Shell Gadus S2 V220 2, tờ giới thiệu tiếng Việt', ban: 'v3.1, 03/07/2016', tra: '03/11/2026', url: '/tai-lieu/tds/shell-gadus-s2-v220-2.pdf' },
  { ten: 'ENEOS Epnoc Grease AP(N)', ban: '02/2023', tra: '03/11/2026', url: 'https://www.eneos.co.jp/english/products/lubricants/pdf/grs-7037-2507e.pdf' },
  { ten: 'Sinopec Crystal Grease', ban: '10/2012', tra: '05/11/2026', url: '/tai-lieu/tds/sinopec-crystal-grease.pdf' },
  { ten: 'Sinopec Golden Grease', ban: '11/2022', tra: '05/11/2026', url: '/tai-lieu/tds/sinopec-golden-grease.pdf' },
  { ten: 'VHP MP Grease L2, L3, L4', ban: 'Không in ngày, file PDF tạo 29/02/2024', tra: '05/11/2026', url: '/tai-lieu/tds/vhp-mp-grease.pdf' },
  { ten: 'VHP Lithium Grease', ban: 'Trang hãng, 29/06/2023', tra: '03/11/2026', url: 'https://hoadauvhp.com/lithiumgrease-nid24.html' },
  { ten: 'VHP Licas Grease', ban: 'Trang hãng, 29/06/2023', tra: '03/11/2026', url: 'https://hoadauvhp.com/licasgreaseno-nid23.html' },
  { ten: 'VHP Caxilium Grease', ban: 'Trang hãng, 27/06/2023', tra: '03/11/2026', url: 'https://hoadauvhp.com/caxiliumgreasenovhp-nid4.html' },
  { ten: 'VHP Opal Grease', ban: 'Trang hãng, 27/06/2023', tra: '03/11/2026', url: 'https://hoadauvhp.com/opalgreaselvhpgremil-nid3.html' },
  { ten: 'PVOIL PV Grease', ban: 'Trang hãng, sửa lần cuối 20/05/2026', tra: '03/11/2026', url: 'http://pvoillube.vn/san-pham/san-pham-dan-dung/mo-da-dung/pv-grease-lithium-l1-l2-l3-mo-da-dung/' },
  { ten: 'Calix Ceno No3', ban: 'Trang hãng, không ghi ngày', tra: '10/2026 (03/11/2026 chưa mở lại được)', url: 'http://calixlube.com/mo-chiu-nhiet-calix-no3' },
  { ten: 'Shell Gadus S3 V220C 2', ban: 'Chưa có tệp TDS công khai trên trang', tra: '10/2026', url: '' },
];

const MUC_LUC = [
  ['chon-nhanh', 'Chọn nhanh theo vị trí'], ['nlgi', 'Chọn theo cấp NLGI'], ['chat-lam-dac', 'Chọn theo chất làm đặc'], ['so-sanh', 'So sánh và trạng thái kho'],
  ['dong-co', 'Vòng bi động cơ điện'], ['chi-phi', 'Giá mỗi kg và chi phí mỗi năm'], ['mo-kho', 'Vì sao mỡ bò khô cứng'], ['tra-mo', 'Tra bao nhiêu, bao lâu'],
  ['quy-trinh', 'Quy trình bơm mỡ bò an toàn'], ['kinh-nghiem', 'Kinh nghiệm người sử dụng'], ['su-co', 'Dấu hiệu mỡ hỏng'], ['hoi-dap', 'Câu hỏi thường gặp'], ['cach-viet-bai', 'Cách chúng tôi viết và cập nhật bài'],
];

const crumbs = [{ name: 'Trang chủ', href: '/' }, { name: 'Mỡ bôi trơn (mỡ bò)', href: CAT }];
const PAGE_ID = absUrl(pagePath) + '#webpage';
const citation = [
  ...TDS.map((t) => t.url).filter((u) => u.startsWith('http')),
  'https://www.skf.com/us/products/rolling-bearings/principles-of-rolling-bearing-selection/bearing-selection-process/lubrication/selecting-a-suitable-grease',
  'https://www.skf.com/us/products/rolling-bearings/principles-of-rolling-bearing-selection/bearing-selection-process/lubrication/grease-life-and-relubrication',
  'https://cdn.skfmediahub.skf.com/api/public/0901d1968024f02a/pdf_preview_medium/0901d1968024f02a_pdf_preview_medium.pdf',
  'https://www.mobil.com/lubricants/-/media/project/wep/mobil/mobil-row-us-1/new-pdf/82414-technical-topic-grease-its-components-consistency-and-compatibility-en.pdf',
  'https://www.machinerylubrication.com/Read/1865/grease-compatibility',
  'https://www.lelubricants.com/wp-content/uploads/Grease-Compatibility-Chart-Domestic.pdf',
  'https://doi.org/10.1080/10402004.2021.1943088', 'https://doi.org/10.1016/j.triboint.2023.108785',
  'https://www.stle.org/files/TLTArchives/2010/10_October/Technical_Analysis.aspx', 'https://www.osha.gov/laws-regs/regulations/standardnumber/1910/1910.147',
];
const schemaData = [
  { '@context': 'https://schema.org', '@type': ['CollectionPage', 'WebPage'], '@id': PAGE_ID, name: title, description, url: absUrl(pagePath), dateModified: NGAY, author: personRef(tacGia), reviewedBy: personRef(reviewer), citation, inLanguage: 'vi-VN', publisher: { '@id': ORG_ID } },
  personSchema(tacGia), personSchema(reviewer), breadcrumbSchema(crumbs),
  { '@context': 'https://schema.org', '@type': 'VideoObject', name: 'Nhồi mỡ vòng bi bằng dụng cụ ép', description: 'Video trên kênh HT VINA: nhồi mỡ cho nhiều vòng bi côn bằng dụng cụ ép để mỡ vào đều và làm nhanh.', thumbnailUrl: 'https://i.ytimg.com/vi/dir69EUPOvU/maxresdefault.jpg', uploadDate: '2026-11-05T02:09:13-08:00', duration: 'PT0M39S', embedUrl: 'https://www.youtube.com/embed/dir69EUPOvU' },
  { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: THE.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: absUrl(t.d.link), name: t.ten })) },
];
---
<Layout {title} seoTitle="Mỡ Bôi Trơn Công Nghiệp (Mỡ Bò) NLGI 0-4 | Cách Chọn & TDS" {description} image={IMAGE} published={NGAY_DANG} modified={NGAY} author={tacGia.name} {schemaData}>
  <div class="container trang">
    <Breadcrumbs items={crumbs} />
    <NoiDungBai articleId={PAGE_ID} type={['CollectionPage', 'WebPage']} field="text">
      <header class="dau">
        <h1>{title}</h1>
        <p class="byline">Đăng ngày <time datetime={NGAY_DANG}>{fmtNgay(NGAY_DANG)}</time> · Cập nhật ngày <time datetime={NGAY}>{fmtNgay(NGAY)}</time> · <a href={personUrl(tacGia)} rel="author">{bylineLabel(tacGia)}</a> · Duyệt nội dung: <a href={personUrl(reviewer)}>{bylineLabel(reviewer)}</a> · <a href="#cach-viet-bai">Cách chúng tôi viết bài</a></p>
        <p class="mo-dau">Nhiều anh em thợ xưởng cứ thấy vòng bi kêu là với tay lấy súng bơm mỡ, bơm đến khi mỡ trào ra mép phớt mới thôi. Bơm quá đầy như vậy dễ làm ổ nóng rực ngay sau đó, mỡ chảy lòng thòng ra ngoài, lâu dần hỏng cả vòng bi. Lỗi nhiều khi không nằm ở chỗ lười tra mỡ, mà ở chỗ chọn sai cấp NLGI, bơm quá nhiều hoặc dùng lẫn các loại mỡ với nhau.</p>
        <p class="mo-dau"><strong>Mỡ bôi trơn công nghiệp</strong>, ngoài xưởng quen gọi là <strong>mỡ bò</strong>, là chất bôi trơn máy móc dạng sệt pha từ dầu gốc, chất làm đặc và phụ gia, không phải mỡ động vật. Công dụng chính của mỡ là giảm ma sát và mài mòn, bám lại ở vị trí tra, làm kín ổ trước bụi, nước và chống gỉ cho chi tiết máy. Bạn nên chọn theo ba điều: <strong>nhiệt độ đo trên vỏ ổ</strong>, <strong>tải và tốc độ</strong> của vị trí tra, rồi mới đến giá. Với vòng bi và gối đỡ thông thường, cấp phổ biến nhất là NLGI 2. Nếu vỏ ổ nóng liên tục từ 100 °C trở lên, hãy xem <a href="/mo-chiu-nhiet">mỡ chịu nhiệt</a>.</p>
        <p class="goi-y-menu">Bạn đang cần gì? Bấm chọn nhanh bên dưới:</p>
        <nav class="menu-nhanh" aria-label="Đi nhanh tới nội dung">
          <a class="nut-nhanh" href="#san-pham"><strong>Danh sách mỡ bôi trơn phổ biến</strong><span class="nut-xem">Xem ngay →</span></a>
          <a class="nut-nhanh" href="#huong-dan"><strong>Hướng dẫn cách chọn mỡ</strong><span class="nut-xem">Xem ngay →</span></a>
          <a class="nut-nhanh" href="#chi-phi"><strong>Bảng giá mỡ bôi trơn tháng {THANG_GIA}</strong><span class="nut-xem">Xem ngay →</span></a>
        </nav>
      </header>

      <section class="sp" id="san-pham" aria-labelledby="tieu-de-sp">
        <h2 id="tieu-de-sp">Các mã mỡ bôi trơn, mỡ bò HT VINA đang cung cấp</h2>
        <div class="loc" id="loc-mo">
          {NHOM_LOC.map((n) => (
            <div class="loc-nhom" data-nhom={n.nhom} role="group" aria-label={n.ten}>
              <span class="loc-ten">{n.ten}</span>
              <div class="loc-nut">
                <button type="button" data-gt="" aria-pressed="true">Tất cả</button>
                {n.muc.map(([gt, nhan]) => <button type="button" data-gt={gt} aria-pressed="false">{nhan}</button>)}
              </div>
            </div>
          ))}
        </div>
        <div class="luoi" id="luoi-mo">
          {THE.map((t) => (
            <article class="the" data-vi-tri={t.viTri.join(' ')} data-hang={t.hang} data-cap={t.caps.join(' ')}>
              {t.anh && <img src={t.anh.src} srcset={webpSrcset(t.anh.src)} sizes="(max-width: 640px) 96px, 300px" alt={t.anh.alt} width="300" height="180" loading="lazy" decoding="async" />}
              <div class="the-noi-dung">
                <p class="the-nhan"><span>{t.hang}</span><span>NLGI {t.d.cap}</span>{t.chiuNhiet && <span class="nhan-nong">Mỡ chịu nhiệt</span>}</p>
                <h3><a href={t.d.link}>{t.ten}</a></h3>
                <dl>
                  <div><dt>Chất làm đặc</dt><dd>{t.d.lam_dac}</dd></div>
                  <div><dt>Nhiệt độ làm việc</dt><dd>{t.d.lam_viec}</dd></div>
                  <div><dt>Kho</dt><dd>{t.d.ghi_chu === 'cho' ? <span class="cho">{t.d.co_san}</span> : <><strong>Có sẵn:</strong> {t.d.co_san}</>}{t.d.nhan_dat && <><br /><strong>Nhận đặt:</strong> {t.d.nhan_dat}</>}</dd></div>
                </dl>
                <div class="the-nut">
                  <a href={t.d.link}>Xem chi tiết →</a>
                  <a class="nut-gia" href={`/bao-gia?sp=${encodeURIComponent(t.ten)}`} data-track="add_to_quote">Báo giá</a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p class="loc-trong" id="loc-trong" hidden>Chưa có mã khớp với lựa chọn này. Bạn hãy bỏ bớt bộ lọc hoặc gọi <a href="tel:0901511313">0901 511 313</a> để chúng tôi kiểm tra.</p>
        <button type="button" class="xem-them" id="xem-them-mo" aria-controls="luoi-mo" aria-expanded="false" hidden>Xem thêm</button>
        <script is:inline>
          // Đặt ngay sau lưới để thu gọn trước khi trang hiện, không gây giật bố cục. Không có JavaScript thì vẫn thấy đủ các thẻ.
          (() => {
            const loc = document.getElementById('loc-mo');
            const luoi = document.getElementById('luoi-mo');
            const cacThe = [...luoi.querySelectorAll('.the')];
            const trong = document.getElementById('loc-trong');
            const nut = document.getElementById('xem-them-mo');
            const dienThoai = matchMedia('(max-width: 640px)');
            let moRong = false;
            // Máy tính: đúng một hàng. Điện thoại: thẻ xếp một cột nên hiện 3 thẻ.
            const soGon = () => dienThoai.matches ? 3 : getComputedStyle(luoi).gridTemplateColumns.split(' ').length;
            const chon = (nhom) => loc.querySelector(`[data-nhom="${nhom}"] button[aria-pressed="true"]`)?.getAttribute('data-gt') ?? '';
            const khop = (gt, ds) => !gt || ds.includes(gt);
            const capNhat = () => {
              const viTri = chon('vi-tri'), hang = chon('hang'), cap = chon('cap');
              const dangLoc = Boolean(viTri || hang || cap);
              const gon = soGon();
              const gioiHan = dangLoc || moRong ? Infinity : gon;
              let con = 0;
              cacThe.forEach((the) => {
                const dung = khop(viTri, (the.dataset.viTri ?? '').split(' ')) && khop(hang, [the.dataset.hang]) && khop(cap, (the.dataset.cap ?? '').split(' '));
                the.hidden = !dung || con >= gioiHan;
                if (dung) con++;
              });
              trong.hidden = con > 0;
              // Khi đang lọc thì hiện đủ các mã khớp, không cần nút.
              nut.hidden = dangLoc || cacThe.length <= gon;
              nut.textContent = moRong ? 'Thu gọn' : `Xem thêm ${cacThe.length - gon} mã mỡ`;
              nut.setAttribute('aria-expanded', String(moRong));
            };
            loc.addEventListener('click', (e) => {
              const bam = e.target.closest('button');
              if (!bam) return;
              bam.parentElement.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === bam)));
              capNhat();
            });
            nut.addEventListener('click', () => { moRong = !moRong; capNhat(); });
            addEventListener('resize', capNhat);
            capNhat();
          })();
        </script>
      </section>

      <div class="seo-content markdown-body" id="huong-dan">
        <blockquote class="tom-tat">
          <p><strong>Tóm tắt</strong></p>
          <ul>
            <li>Gối đỡ tải thường, vỏ ổ dưới 90 °C: mỡ lithium-canxi là đủ.</li>
            <li>Vỏ ổ 90–100 °C, tải thường: mỡ có TDS ghi tới 120 °C. Vỏ ổ 100–120 °C: mỡ lithium complex.</li>
            <li>Tải nặng, va đập: mỡ công bố phụ gia cực áp (EP).</li>
            <li><strong>Vòng bi động cơ điện: kho chưa có mã chuyên</strong>, hãy gửi mã vòng bi và tốc độ để chúng tôi tính.</li>
            <li>Bơm theo công thức, không bơm theo cảm giác. Không trộn mỡ khi chưa kiểm tra tương thích.</li>
          </ul>
        </blockquote>
        <nav class="muc-luc" aria-label="Mục lục"><strong>Mục lục</strong><ol>{MUC_LUC.map(([id, ten]) => <li><a href={`#${id}`}>{ten}</a></li>)}</ol></nav>
        <ContentBody><ChonMo /></ContentBody>

        <h2 id="so-sanh">So sánh các mã mỡ theo TDS và trạng thái kho</h2>
        <p>Số trong bảng là giá trị điển hình hoặc cam kết ghi trên TDS, có thể dao động nhẹ giữa các lô. Ô "–" là TDS không ghi chỉ tiêu đó. Cột cuối là trạng thái theo từng cấp và quy cách. Bạn vẫn nên hỏi lại số lượng trước khi đặt.</p>
        <div class="bang"><table class="the-dt">
          <thead><tr><th>Mã mỡ</th><th>Chất làm đặc</th><th>Cấp NLGI</th><th>Dầu gốc ở 40 °C</th><th>Nhỏ giọt</th><th>Nhiệt độ làm việc</th><th>Tải hàn dính 4 bi</th><th>Trạng thái kho</th></tr></thead>
          <tbody>{BANG.map((d) => <tr>
            <td class="the-ten"><a href={d.link}>{d.ten}</a></td><td data-nhan="Chất làm đặc">{d.lam_dac}</td><td data-nhan="Cấp NLGI">{d.cap}</td><td data-nhan="Dầu gốc ở 40 °C">{d.dau40}</td><td data-nhan="Nhỏ giọt">{d.nho_giot}</td><td data-nhan="Nhiệt độ làm việc">{d.lam_viec}</td><td data-nhan="Tải hàn dính 4 bi">{d.hbi}</td>
            <td class="the-kho" data-nhan="Trạng thái kho"><div>{d.ghi_chu === 'cho' ? <span class="cho">{d.co_san}</span> : <><strong>Có sẵn:</strong> {d.co_san}</>}{d.nhan_dat && <><br /><strong>Nhận đặt:</strong> {d.nhan_dat}</>}</div></td>
          </tr>)}</tbody>
        </table></div>
        <ContentBody><DocBang /></ContentBody>

        <h2 id="chi-phi">Giá mỡ mỗi kg và chi phí cho một vòng bi mỗi năm</h2>
        <p>Bảng dưới đây quy khoảng giá của từng loại mỡ ra mỗi kg, rồi tính xem <strong>một vòng bi hết bao nhiêu tiền mỡ trong một năm</strong>. Để dễ so sánh, chúng tôi lấy ví dụ vòng bi 6310, mỗi lần tra khoảng 15 g, tra bốn lần một năm, tức là dùng hết {G_DIEM_NAM} g mỡ mỗi năm. Giá chưa gồm VAT, tính từ giá kho đến mức cao hơn giá kho 15%, rà soát ngày {fmtNgay(NGAY_GIA)}; giá thực tế còn tùy số lượng và lô hàng. Muốn biết giá theo từng xô, phuy, bạn hãy <a href="/bao-gia">gửi yêu cầu báo giá</a>.</p>
        <div class="bang"><table>
          <thead><tr><th>Loại mỡ và quy cách</th><th>Giá mỗi kg (đồng)</th><th>Tiền mỡ cho một vòng bi mỗi năm (đồng)</th></tr></thead>
          <tbody>{CHI_PHI.map((c) => <tr><td><a href={c.link}>{c.ten}</a> · {c.qc}</td><td>{vnd(lam100(c.thap))} – {vnd(lam100(c.cao))}</td><td>{vnd(lam100(c.thap * G_DIEM_NAM / 1000))} – {vnd(lam100(c.cao * G_DIEM_NAM / 1000))}</td></tr>)}</tbody>
        </table></div>
        <p class="nho">Bảng chưa có <a href={`${CAT}/eneos-epnoc-ap`}>ENEOS Epnoc AP(N)</a> vì cấp và quy cách của loại mỡ này còn phải xác nhận theo từng lô. Giá mỗi kg của VHP Licas được quy đổi từ giá thùng 30 ống 400 g (12 kg).</p>
        <ContentBody><DoiChieu /></ContentBody>
        <ContentBody><VanHanh /></ContentBody>
        <ContentBody><SuCo /></ContentBody>

        <ContentBody><Cuoi /></ContentBody>

        <section class="cach-viet" id="cach-viet-bai" aria-labelledby="tieu-de-cach-viet">
          <h2 id="tieu-de-cach-viet">Cách chúng tôi viết và cập nhật bài này</h2>
          <p><strong>Người viết:</strong> <a href={personUrl(tacGia)}>{tacGia.name}</a>, {tacGia.role.toLowerCase()} HT VINA. <strong>Người duyệt:</strong> <a href={personUrl(reviewer)}>{reviewer.name}</a>, {reviewer.role.toLowerCase()} HT VINA, kỹ sư Công nghệ ô tô. Mọi thay đổi về thông số và giá đều qua người duyệt trước khi lên trang.</p>
          <ul>
            <li><strong>Giá:</strong> rà soát toàn bộ <strong>mỗi tuần một lần</strong>. Ngoài kỳ rà soát, chỉ cần <strong>một mã bất kỳ đổi giá</strong> là chúng tôi cập nhật ngay trong ngày. Lần rà soát gần nhất: <time datetime={NGAY_GIA}>{fmtNgay(NGAY_GIA)}</time>.</li>
            <li><strong>Thông số kỹ thuật:</strong> chỉ cần hãng sửa <strong>một thông số bất kỳ của một mã</strong> (phát hành TDS mới), chúng tôi sửa bài ngay khi nhận được TDS đó.</li>
            <li><strong>Nội dung bài:</strong> sửa lần gần nhất ngày <time datetime={NGAY}>{fmtNgay(NGAY)}</time>.</li>
          </ul>
          <details>
            <summary><span class="mo">Xem đầy đủ quy trình biên tập</span><span class="dong">Thu gọn</span></summary>

            <h3>1. Quy trình biên tập một bài</h3>
            <ol>
              <li><strong>Thu thập tài liệu ({tacGia.name}).</strong> Lấy TDS (bảng thông số kỹ thuật) mới nhất của từng mã từ hãng hoặc nhà phân phối, ghi lại bản phát hành và ngày tra cứu vào bảng nguồn ở cuối mục này.</li>
              <li><strong>Nhập thông số ({tacGia.name}).</strong> Chép số từ TDS vào bảng so sánh, thẻ sản phẩm và trang sản phẩm. Số nào TDS không ghi thì để trống hoặc ghi "TDS không ghi", không tự điền theo mã tương tự.</li>
              <li><strong>Viết hướng dẫn ({tacGia.name}).</strong> Phần cách chọn, cách tra mỡ dựa trên tài liệu của nhà sản xuất vòng bi và hãng dầu mỡ, có link nguồn ngay trong câu. Ý kiến người dùng lấy từ chia sẻ công khai trên mạng, ghi rõ nguồn và không coi là khảo sát.</li>
              <li><strong>Lập khoảng giá ({tacGia.name}).</strong> Giá lấy từ bảng giá kho của HT VINA. Trang chỉ công bố khoảng giá, từ giá kho đến mức cao hơn giá kho 15%, chưa gồm VAT, vì giá thực tế còn tùy số lượng và lô hàng.</li>
              <li><strong>Duyệt ({reviewer.name}).</strong> Đối chiếu từng thông số với TDS, kiểm tra lời khuyên kỹ thuật và duyệt khoảng giá. Phần nào chưa đủ căn cứ thì trả lại để sửa, chưa đăng.</li>
              <li><strong>Đăng và ghi ngày.</strong> Bài lên trang cùng ngày sửa, ngày rà soát giá và ngày tra cứu TDS tương ứng.</li>
            </ol>

            <h3>2. Khi nào sửa bài và sửa những gì</h3>
            <div class="bang"><table class="the-dt">
              <thead><tr><th>Việc</th><th>Khi nào</th><th>Sửa những gì trên trang</th><th>Ai làm</th></tr></thead>
              <tbody>
                <tr><td class="the-ten">Rà soát giá định kỳ</td><td data-nhan="Khi nào">Mỗi tuần một lần, kể cả khi không mã nào đổi giá</td><td data-nhan="Sửa những gì">Kiểm tra lại giá kho của mọi mã; đổi ngày rà soát giá. Nếu không có giá nào đổi thì chỉ đổi ngày rà soát.</td><td data-nhan="Ai làm">{tacGia.name} rà soát, {reviewer.name} duyệt</td></tr>
                <tr><td class="the-ten">Một mã bất kỳ đổi giá</td><td data-nhan="Khi nào">Ngay trong ngày hãng hoặc nhà phân phối báo giá mới, không chờ kỳ rà soát tuần</td><td data-nhan="Sửa những gì">Khoảng giá mỗi kg và chi phí mỗi năm của mã đó trong bảng chi phí, giá trên trang sản phẩm, ngày rà soát giá</td><td data-nhan="Ai làm">{tacGia.name} cập nhật, {reviewer.name} duyệt</td></tr>
                <tr><td class="the-ten">Một mã bất kỳ đổi thông số</td><td data-nhan="Khi nào">Ngay khi nhận được TDS mới của hãng, dù chỉ đổi một con số</td><td data-nhan="Sửa những gì">Thông số trong bảng so sánh, thẻ sản phẩm, trang sản phẩm; bản phát hành và ngày tra cứu trong bảng nguồn; lời khuyên nào dựa trên số cũ thì viết lại</td><td data-nhan="Ai làm">{tacGia.name} sửa, {reviewer.name} đối chiếu với TDS và duyệt</td></tr>
                <tr><td class="the-ten">Kho đổi hàng hoặc quy cách</td><td data-nhan="Khi nào">Khi một mã hết hàng, có hàng lại, hoặc lô mới đổi quy cách xô, phuy</td><td data-nhan="Sửa những gì">Cột trạng thái kho (có sẵn hay nhận đặt), quy cách trên thẻ sản phẩm</td><td data-nhan="Ai làm">{tacGia.name}</td></tr>
                <tr><td class="the-ten">Thêm hoặc ngừng bán một mã</td><td data-nhan="Khi nào">Khi HT VINA bắt đầu hoặc ngừng nhập mã đó</td><td data-nhan="Sửa những gì">Lưới sản phẩm, bảng so sánh, bảng chi phí, bảng nguồn TDS</td><td data-nhan="Ai làm">{tacGia.name} sửa, {reviewer.name} duyệt</td></tr>
                <tr><td class="the-ten">Có người báo sai sót</td><td data-nhan="Khi nào">Ngay khi nhận được báo</td><td data-nhan="Sửa những gì">Kiểm tra lại với TDS hoặc bảng giá kho; sai ở đâu sửa ở đó</td><td data-nhan="Ai làm">{tacGia.name} kiểm tra, {reviewer.name} duyệt</td></tr>
                <tr><td class="the-ten">Hướng dẫn kỹ thuật cần bổ sung</td><td data-nhan="Khi nào">Khi tài liệu tham khảo đổi khuyến nghị, hoặc khách hỏi một vấn đề bài chưa có</td><td data-nhan="Sửa những gì">Thêm hoặc sửa đoạn hướng dẫn, mục câu hỏi thường gặp, kèm link nguồn</td><td data-nhan="Ai làm">{tacGia.name} viết, {reviewer.name} duyệt</td></tr>
              </tbody>
            </table></div>

            <h3>3. Cách ghi ngày</h3>
            <ul>
              <li><strong>Ngày rà soát giá</strong> (ở bảng chi phí và đầu mục này) đổi sau mỗi lần rà soát hằng tuần và mỗi lần một mã đổi giá.</li>
              <li><strong>Ngày "Cập nhật" ở đầu bài</strong> chỉ đổi khi nội dung bài thật sự thay đổi: thông số, giá, kho, hướng dẫn. Tuần nào rà soát mà không có gì đổi thì giữ nguyên ngày này.</li>
              <li><strong>Ngày tra cứu TDS</strong> trong bảng nguồn ghi ngày chúng tôi mở lại tài liệu của hãng gần nhất.</li>
            </ul>

            <h3>4. Báo sai sót</h3>
            <p>Nếu thấy thông số hoặc giá chưa đúng, bạn gọi hoặc nhắn Zalo <a href={`tel:${BUSINESS.phone}`}>{BUSINESS.phoneDisplay}</a>, hoặc gửi email <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>. Chúng tôi kiểm tra lại với TDS của hãng, sửa bài và ghi ngày cập nhật.</p>
            <h3 id="nguon">5. Nguồn số liệu</h3>
            <p>Trang này chưa liệt kê phê duyệt của hãng sản xuất máy, vì chúng tôi chưa đối chiếu đủ tài liệu của từng mã. Nguyên tắc biên tập chung của website có ở trang <a href="/quy-trinh-bien-tap">quy trình biên tập</a>.</p>
            <div class="bang"><table>
              <thead><tr><th>Tài liệu</th><th>Bản hoặc ngày phát hành</th><th>Ngày tra cứu</th><th>Liên kết</th></tr></thead>
              <tbody>{TDS.map((t) => <tr><td>{t.ten}</td><td>{t.ban}</td><td>{t.tra}</td><td>{t.url ? <a href={t.url} rel="nofollow noopener">Mở tài liệu</a> : '–'}</td></tr>)}</tbody>
            </table></div>
          </details>
        </section>
        <QuoteCta item="Mỡ bôi trơn (mỡ bò)" />
      </div>
    </NoiDungBai>
  </div>
