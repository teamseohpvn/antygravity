---
import Layout from '../../layouts/Layout.astro';
import ContentBody from '../../components/ContentBody.astro';
import ThongSoUngDung from '../../components/ThongSoUngDung.astro';
import MucLuc from '../../components/MucLuc.astro';
import { mucLuc } from '../../lib/muc-luc';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NoiDungBai from '../../components/NoiDungBai.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { getEntry, render } from 'astro:content';
import { getActiveProducts } from '../../lib/content';
import { tachPhuongPhap } from '../../lib/tieu-chuan';
import { giaSanPham } from '../../lib/gia-json';
import { bangSoSanh } from '../../lib/so-sanh';
import { fmtVnd, fmtNgay } from '../../lib/gia-tinh';
import { ngayBai } from '../../lib/ngay';
import { timNhanSu, DEFAULT_REVIEWER_ID, DEFAULT_PRODUCT_AUTHOR_ID, displayName, personRef, personUrl, personSchema, bylineTitle } from '../../lib/nhan-su';
import { BUSINESS, absUrl, breadcrumbSchema, packagingLabel, productImages, webpSrcset, ORG_ID, SITE_NAME, LEGAL_SHORT } from '../../lib/site';

export async function getStaticPaths() {
  const products = await getActiveProducts();
  return products.map((product) => ({
    params: { category: product.data.category, slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content, headings } = await render(product);
const d = product.data;
const categoryEntry = await getEntry('danhmuc', d.category);
const categoryLabel = categoryEntry?.data.nav_label ?? d.categoryName;
const pagePath = `/${d.category}/${product.id}`;
const gallery = productImages(d);
const mainImage = gallery[0];
const grade = d.vg ? `ISO VG ${d.vg}` : d.nlgi ? `NLGI ${d.nlgi}` : null;
const sku = d.sku ?? d.packaging?.map((p) => (typeof p === 'string' ? undefined : p.sku)).find(Boolean);
const STOCK_TEXT = {
  'co-san': 'Có sẵn tại kho TP Hải Phòng (Hải Dương cũ). Liên hệ để nhận báo giá.',
  'dat-hang': 'Hàng đặt theo yêu cầu. Liên hệ để biết thời gian giao.',
  'ngung-ban': 'Sản phẩm đã ngừng kinh doanh. Liên hệ để được tư vấn mã thay thế.',
} as const;
// Sản phẩm tương đương: gắn link nếu tên khớp một trang sản phẩm đang bật, còn lại để chữ thường.
const norm = (t: string) => t.toLowerCase().replace(/^dầu thủy lực\s+/, '').replace(/\s*\(.*\)\s*$/, '').trim();
const activeProducts = await getActiveProducts();
const equivalents = (d.equivalents ?? []).map((name) => {
  const match = activeProducts.find((p) => p.id !== product.id && norm(p.data.title) === norm(name));
  return { name, href: match ? `/${match.data.category}/${match.id}` : undefined };
});
// So sánh với 2–4 mã cùng công dụng đang bán trên web (dầu thủy lực với dầu thủy lực, mỡ với mỡ…).
const soSanh = bangSoSanh(product, activeProducts);
// Mục lục: các mục cố định của template + tiêu đề H2 trong thân bài, đúng thứ tự trên trang.
const coSpecs = !!d.specs?.length;
const coUngDung = !!(d.applications?.length || d.not_for?.length);
const coBaoQuan = !!(d.warnings?.length || d.storage || d.shelf_life);
const mucThongSo = [
  ...(coSpecs ? [{ depth: 2, slug: 'thong-so-ky-thuat', text: 'Thông số kỹ thuật điển hình' }] : []),
  ...(coUngDung ? [{ depth: 2, slug: 'ung-dung', text: 'Ứng dụng và khuyến cáo sử dụng' }] : []),
];
// Thân bài có đoạn "Nhận định của HT VINA" thì ghi chú dưới bảng thông số phân biệt số liệu hãng / ý kiến tư vấn.
const coNhanDinh = (product.body ?? '').includes('Nhận định của HT VINA');
const tocItems = mucLuc([
  ...(d.thong_so_cuoi ? [] : mucThongSo),
  { depth: 2, slug: 'gioi-thieu', text: `Giới thiệu ${d.title}` },
  ...headings,
  ...(d.thong_so_cuoi ? mucThongSo : []),
  ...(soSanh ? [{ depth: 2, slug: 'so-sanh-cung-loai', text: `So sánh với các ${soSanh.tenNhom} khác` }] : []),
  ...(equivalents.length ? [{ depth: 2, slug: 'san-pham-tuong-duong', text: 'Sản phẩm tương đương' }] : []),
  ...(coBaoQuan ? [{ depth: 2, slug: 'bao-quan-an-toan', text: 'Bảo quản và an toàn' }] : []),
], { tat: d.muc_luc === false });
// **đậm** trong tom_tat → <strong>, phần còn lại được escape.
const dam = (t: string) =>
  t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
// Khoảng giá công khai (src/data/gia-cong-khai.json, cùng số với trang bảng giá). Có giá thì hiện trên trang
// và đưa vào schema AggregateOffer; chưa có giá thì không thêm offers (không bịa giá).
const gia = giaSanPham(d.category, product.id);
// Trang gộp nhiều mã (Rosia EP 100/150/220…): ghi tên mã trước quy cách.
const nhieuMa = new Set(gia.rows.map((r) => r.ten)).size > 1;
const AVAILABILITY = { 'co-san': 'InStock', 'dat-hang': 'BackOrder', 'ngung-ban': 'Discontinued' } as const;
const offers = gia.rows.length
  ? {
      '@type': 'AggregateOffer',
      priceCurrency: 'VND',
      lowPrice: Math.min(...gia.rows.map((r) => r.thap!)),
      highPrice: Math.max(...gia.rows.map((r) => r.cao!)),
      offerCount: gia.rows.length,
      availability: `https://schema.org/${AVAILABILITY[d.stock_status ?? 'co-san']}`,
      url: absUrl(pagePath),
      seller: { '@id': ORG_ID },
    }
  : undefined;
const stockText = d.stock_status ? STOCK_TEXT[d.stock_status] : 'Liên hệ để nhận báo giá và kiểm tra tồn kho.';

const crumbs = [
  { name: 'Trang chủ', href: '/' },
  { name: categoryLabel, href: `/${d.category}` },
  { name: d.title, href: pagePath },
];

// Ngày cập nhật và người biên soạn: hiển thị trên trang, thẻ meta và schema (E-E-A-T).
const ngay = ngayBai(d);
// Tác giả: nhân viên HT VINA (mặc định Ms. Hồng); người duyệt nội dung: TS. Lập. Hiển thị và schema khớp nhau.
const tacGia = timNhanSu(d.tac_gia) ?? timNhanSu(DEFAULT_PRODUCT_AUTHOR_ID);
const reviewer = timNhanSu(d.reviewed_by) ?? timNhanSu(DEFAULT_REVIEWER_ID);
const authorName = tacGia ? tacGia.name : `${SITE_NAME} (${LEGAL_SHORT})`;
const tenNgan = (p: NonNullable<typeof tacGia>) => p.bylineName ?? displayName(p);

const additionalProperty = [
  ...(grade ? [{ '@type': 'PropertyValue', name: d.vg ? 'Cấp độ nhớt' : 'Cấp NLGI', value: grade }] : []),
  ...(d.sae ? [{ '@type': 'PropertyValue', name: 'Cấp SAE', value: d.sae }] : []),
  ...(d.api ? [{ '@type': 'PropertyValue', name: 'Cấp API', value: d.api }] : []),
  ...(d.specs ?? []).map((s) => ({ '@type': 'PropertyValue', name: s.name, value: s.value, ...(s.method ? { description: s.method } : {}) })),
];

// Nguồn dẫn trên trang: TDS của hãng + công bố gốc ASTM/ISO và TCVN của các phương pháp thử trong bảng thông số.
const citation = [
  ...new Set([
    ...(d.tds_url ? [d.tds_url] : []),
    ...(d.specs ?? []).flatMap((s) => (s.method ? tachPhuongPhap(s.method) : []).flatMap((x) => [x.tc?.url, x.tc?.tcvnUrl])),
  ].filter((u): u is string => Boolean(u))),
];

const PAGE_ID = absUrl(pagePath) + '#webpage';
const PAGE_TYPE = ['ItemPage', 'WebPage'];

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': absUrl(pagePath) + '#product',
    name: d.title,
    description: d.description,
    url: absUrl(pagePath),
    brand: { '@type': 'Brand', name: d.brand },
    category: categoryLabel,
    ...(sku ? { sku } : {}),
    ...(d.origin ? { countryOfOrigin: d.origin } : {}),
    ...(gallery.length ? { image: gallery.map((img) => absUrl(img.src)) } : {}),
    ...(additionalProperty.length ? { additionalProperty } : {}),
    // offers chỉ khi có khoảng giá công khai; không thêm aggregateRating khi chưa có đánh giá thật.
    ...(offers ? { offers } : {}),
  },
  {
    '@context': 'https://schema.org',
    // Thêm WebPage cạnh ItemPage (ItemPage vốn là WebPage): một số công cụ kiểm tra E-E-A-T chỉ nhận WebPage/Article.
    '@type': PAGE_TYPE,
    '@id': PAGE_ID,
    name: d.seo_title ?? d.title,
    description: d.description,
    about: { '@type': 'Thing', name: categoryLabel },
    url: absUrl(pagePath),
    inLanguage: 'vi-VN',
    ...(ngay.published ? { datePublished: ngay.published } : {}),
    ...(ngay.modified ? { dateModified: ngay.modified } : {}),
    author: tacGia ? personRef(tacGia) : { '@id': ORG_ID },
    ...(reviewer ? { reviewedBy: personRef(reviewer) } : {}),
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': absUrl('/') + '#website' },
    mainEntity: { '@id': absUrl(pagePath) + '#product' },
    ...(citation.length ? { citation } : {}),
  },
  // Khối Person đầy đủ của người kiểm duyệt, để công cụ và AI đọc được tác giả ngay trên trang.
  ...(tacGia ? [personSchema(tacGia)] : []),
  ...(reviewer && reviewer.id !== tacGia?.id ? [personSchema(reviewer)] : []),
  breadcrumbSchema(crumbs),
];
---

<Layout
  title={`${d.title} Chính Hãng`}
  seoTitle={d.seo_title}
  description={d.description}
  image={mainImage?.src}
  type="product"
  published={ngay.published}
  modified={ngay.modified}
  author={authorName}
  {schemaData}
>
  <div class="container product-page">
    <Breadcrumbs items={crumbs} />

    <NoiDungBai articleId={PAGE_ID} type={PAGE_TYPE} field="text">
    <div class="product-top">
      <div class="product-image">
        {mainImage && <img src={mainImage.src} srcset={webpSrcset(mainImage.src)} sizes="(max-width: 700px) 100vw, 600px" alt={mainImage.alt} width="600" height="600" loading="eager" fetchpriority="high" decoding="async" />}
        {gallery.length > 1 && (
          <div class="thumbnail-gallery">
            {gallery.map((img) => <img src={img.src} alt={img.alt} width="80" height="80" loading="lazy" />)}
          </div>
        )}
      </div>
      <div class="product-summary">
        <h1>{d.title}</h1>
        <p class="byline">
          {ngay.published && <>Đăng ngày <time datetime={ngay.published}>{ngay.publishedText}</time></>}
          {ngay.modified && ngay.modified !== ngay.published && <> · Cập nhật ngày <time datetime={ngay.modified}>{ngay.modifiedText}</time></>}
          {' · '}<a href={personUrl(tacGia!)} rel="author">{tenNgan(tacGia!)}</a>
          {reviewer && reviewer.id !== tacGia?.id && <> · Duyệt nội dung: <a href={personUrl(reviewer)}>{tenNgan(reviewer)}</a></>}
        </p>
        <div class="tags">
          <span class="badge">{d.brand}</span>
          {grade && <span class="badge badge-outline">{grade}</span>}
          {d.sae && <span class="badge badge-outline">SAE {d.sae}</span>}
          {d.api && <span class="badge badge-outline">API {d.api}</span>}
          {d.standards?.map((s) => <span class="badge badge-outline">{s}</span>)}
        </div>
        <p class="description">{d.description}</p>
        {d.doc_gia && <p class="doc-gia">{d.doc_gia}</p>}
        {d.tom_tat && d.tom_tat.length > 0 && (
          <div class="tom-tat">
            <p class="tom-tat__label">Hãy chọn ngay nếu bạn thực sự cần những tiêu chí sau</p>
            <ul>{d.tom_tat.map((t) => <li set:html={dam(t)} />)}</ul>
          </div>
        )}

        {d.packaging && d.packaging.length > 0 && (
          <p class="packaging"><strong>Quy cách:</strong> {d.packaging.map(packagingLabel).join(' · ')}</p>
        )}
        {(d.origin || d.base_oil) && (
          <p class="packaging">
            {d.origin && <><strong>Xuất xứ:</strong> {d.origin}</>}
            {d.origin && d.base_oil && ' · '}
            {d.base_oil && <><strong>Dầu gốc:</strong> {d.base_oil}</>}
          </p>
        )}

        <div class="cta-box">
          <p class="status">{stockText}</p>
          {gia.rows.length > 0 && (
            <div class="gia">
              <p><strong>Giá tham khảo tháng {fmtNgay(gia.cauHinh.ngay_ra_soat, 'thang')} ({gia.cauHinh.gom_vat ? 'đã gồm VAT' : 'chưa VAT'}):</strong></p>
              <ul>
                {gia.rows.map((r) => <li>{nhieuMa ? `${r.ten} – ${r.quy_cach}` : r.quy_cach}: {fmtVnd(r.thap)} – {fmtVnd(r.cao)} đ</li>)}
              </ul>
              <p class="gia-note">Giá thay đổi theo số lượng và nơi giao.{d.category === 'dau-thuy-luc' && <> Xem <a href="/bao-gia-dau-thuy-luc">bảng giá dầu thủy lực</a>.</>}</p>
            </div>
          )}
          <p class="cta-row">
            <a href={`/bao-gia?sp=${encodeURIComponent(d.title)}`} class="btn-primary" data-track="add_to_quote">Nhận báo giá</a>
            <span>hoặc gọi <a href={`tel:${BUSINESS.phone}`} data-track="click_tel">{BUSINESS.phoneDisplay}</a></span>
          </p>
          {(d.tds_url || d.sds_url) && (
            <div class="docs">
              {d.tds_url && <a href={d.tds_url} class="btn-outline" target="_blank" rel="noopener" data-track="download_tds">Tải thông số kỹ thuật (TDS)</a>}
              {d.sds_url && <a href={d.sds_url} class="btn-outline" target="_blank" rel="noopener" data-track="download_tds">Tải phiếu an toàn (SDS)</a>}
            </div>
          )}
        </div>
      </div>
    </div>

    <MucLuc items={tocItems} />

    {!d.thong_so_cuoi && <ThongSoUngDung {d} {coNhanDinh} />}

    <section class="product-content">
      <h2 id="gioi-thieu">Giới thiệu {d.title}</h2>
      <div class="markdown-body">
        <ContentBody><Content /></ContentBody>
      </div>
      {d.thong_so_cuoi && <ThongSoUngDung {d} {coNhanDinh} nested />}
      {soSanh && (
        <>
          <h2 id="so-sanh-cung-loai">So sánh {d.title} với các {soSanh.tenNhom} khác</h2>
          <p>Bảng đặt {d.title} cạnh {soSanh.dong.length - 1} mã cùng công dụng đang bán tại HT VINA. Cột "Chọn khi" giúp chọn nhanh; thông số chi tiết xem ở trang từng sản phẩm.</p>
          <div class="table-wrap">
            <table class="so-sanh">
              <thead><tr><th>Sản phẩm</th>{soSanh.cot.map((c) => <th>{c}</th>)}<th>Chọn khi</th></tr></thead>
              <tbody>
                {soSanh.dong.map((r) => (
                  <tr class:list={{ 'trang-nay': r.laTrangNay }}>
                    <th scope="row">{r.laTrangNay ? <>{r.ten}<br /><small>(trang này)</small></> : <a href={r.href}>{r.ten}</a>}</th>
                    {r.giaTri.map((v) => <td>{v ? v.split(' · ').map((x, i) => <>{i > 0 && <br />}{x}</>) : '–'}</td>)}
                    <td>{r.chonKhi ?? '–'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="note">Số liệu lấy từ bảng thông số kỹ thuật (TDS) của từng hãng, giá trị điển hình có thể thay đổi theo lô. Giá trị ghi "tối thiểu", "tối đa" là mức hãng cam kết, không phải giá trị đo điển hình. Dấu "–": hãng không công bố chỉ tiêu này hoặc HT VINA chưa có TDS của mã đó. Luôn chọn theo cấp và tiêu chuẩn ghi trong tài liệu hướng dẫn sử dụng kèm theo máy.</p>
        </>
      )}
      {equivalents.length > 0 && (
        <>
          <h2 id="san-pham-tuong-duong">Sản phẩm tương đương</h2>
          <p>{equivalents.map((e, i) => <>{i > 0 && ' · '}{e.href ? <a href={e.href}>{e.name}</a> : e.name}</>)}</p>
        </>
      )}
      {(d.warnings?.length || d.storage || d.shelf_life) && (
        <>
          <h2 id="bao-quan-an-toan">Bảo quản và an toàn</h2>
          <ul>
            {d.storage && <li><strong>Bảo quản:</strong> {d.storage}</li>}
            {d.shelf_life && <li><strong>Hạn sử dụng:</strong> {d.shelf_life}</li>}
            {d.warnings?.map((w) => <li>{w}</li>)}
          </ul>
        </>
      )}
      <QuoteCta item={d.title} />
      <p class="back-link">Xem thêm các sản phẩm khác trong danh mục <a href={`/${d.category}`}>{categoryLabel}</a>.</p>
    </section>
    </NoiDungBai>
  </div>
</Layout>

<style>
  .product-page { margin-bottom: 60px; }

  .product-top { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; margin-bottom: 30px; background: white; padding: clamp(20px, 4vw, 40px); border-radius: 8px; border: 1px solid var(--border-color); }
  @media (max-width: 860px) { .product-top { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
  .product-image img { width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--border-color); }
  .thumbnail-gallery { display: flex; gap: 10px; margin-top: 15px; overflow-x: auto; }
  .thumbnail-gallery img { width: 80px; height: 80px; object-fit: cover; }

  .product-summary h1 { font-size: clamp(1.6rem, 4vw, 2.2rem); color: var(--color-primary); margin-bottom: 15px; line-height: 1.25; }
  .tags { margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 6px; }
  .badge { background: #e2e8f0; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; }
  .badge-outline { background: transparent; border: 1px solid #cbd5e1; }
  .description { font-size: 1.05rem; color: var(--color-text-light); margin-bottom: 20px; }
  .packaging { margin-bottom: 20px; }

  .so-sanh th[scope='row'] { font-weight: 600; min-width: 150px; }
  .so-sanh td { min-width: 90px; }
  .so-sanh td:last-child { min-width: 220px; }
  .so-sanh tr.trang-nay > * { background: #eff6ff; }
  .so-sanh small { font-weight: 400; color: var(--color-text-light); }
  .cta-box { background: #f8fafc; padding: 22px; border-radius: 8px; border: 1px dashed var(--border-color); }
  .status { font-weight: 600; color: var(--color-primary); }
  .gia ul { margin: 4px 0 4px 20px; }
  .gia p { margin: 4px 0; }
  .gia-note { font-size: 0.9rem; }
  .docs { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-top: 16px; }
  .btn-outline { display: block; text-align: center; padding: 10px; border: 1px solid var(--border-color); border-radius: 6px; background: white; font-size: 0.9rem; }
  .btn-outline:hover { background: #f1f5f9; }

  .product-content { background: white; padding: clamp(20px, 4vw, 40px); border-radius: 8px; border: 1px solid var(--border-color); margin-bottom: 30px; }
  .product-content h2 { color: var(--color-primary); margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color); }
  .product-content h3 { margin: 24px 0 8px; color: var(--color-primary); }
  .table-wrap { overflow-x: auto; }
  .product-content table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  .product-content th, .product-content td { border: 1px solid var(--border-color); padding: 8px 12px; text-align: left; }
  .product-content th { background: #f1f5f9; }
  .doc-gia { font-size: 0.95rem; font-style: italic; color: var(--color-text-light); margin: -6px 0 12px; }
  .tom-tat { background: var(--color-bg); border-left: 4px solid var(--color-primary); border-radius: 4px; padding: 12px 16px; margin: 0 0 16px; }
  .tom-tat__label { font-weight: 700; color: var(--color-primary); margin-bottom: 6px; }
  .tom-tat ul { margin: 0 0 0 18px; }
  .tom-tat li { margin-bottom: 4px; }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 12px 0 0; }
  .byline { font-size: 0.85rem; color: var(--color-text-light); margin: -4px 0 12px; }
  .byline a { color: inherit; }
  .note { margin-top: 10px; font-size: 0.9rem; color: var(--color-text-light); }
  .back-link { margin-top: 24px; }
  .product-content > ul { margin: 0 0 16px 20px; }
  .product-content > ul li { margin-bottom: 6px; }
  .back-link a { color: var(--color-accent); text-decoration: underline; }

  :global(.markdown-body h3) { margin: 20px 0 10px; color: var(--color-primary); }
  :global(.markdown-body p) { margin-bottom: 12px; }
  :global(.markdown-body ul) { margin-left: 20px; margin-bottom: 20px; }
  :global(.markdown-body li) { margin-bottom: 8px; }
