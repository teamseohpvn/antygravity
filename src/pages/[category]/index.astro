---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { getCollection, render } from 'astro:content';
import { absUrl, breadcrumbSchema, ORG_ID } from '../../lib/site';

export async function getStaticPaths() {
  const products = await getCollection('sanpham');
  const categories = await getCollection('danhmuc');

  return categories.map((cat) => ({
    params: { category: cat.id },
    props: {
      products: products.filter((p) => p.data.category === cat.id),
      categoryInfo: cat,
    },
  }));
}

const { category } = Astro.params;
const { products, categoryInfo } = Astro.props;
const { Content } = await render(categoryInfo);
const { title, nav_label, description, seo_title, image, reviewed_by, updated } = categoryInfo.data;
const pagePath = `/${category}`;

const crumbs = [
  { name: 'Trang chủ', href: '/' },
  { name: nav_label ?? title, href: pagePath },
];

// Bộ lọc chỉ hiện khi có từ 2 giá trị trở lên, lấy từ sản phẩm thật trong danh mục.
const brands = [...new Set(products.map((p) => p.data.brand))].sort();
const grades = [...new Set(products.map((p) => (p.data.vg ? `VG ${p.data.vg}` : p.data.nlgi ? `NLGI ${p.data.nlgi}` : null)).filter(Boolean))] as string[];
const showFilter = products.length >= 4 && (brands.length > 1 || grades.length > 1);

const productGrade = (p: (typeof products)[number]) =>
  p.data.vg ? `VG ${p.data.vg}` : p.data.nlgi ? `NLGI ${p.data.nlgi}` : null;

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: absUrl(pagePath),
    ...(image ? { image: absUrl(image) } : {}),
    isPartOf: { '@id': absUrl('/') + '#website' },
    publisher: { '@id': ORG_ID },
  },
  breadcrumbSchema(crumbs),
  ...(products.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        itemListElement: products.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: absUrl(`/${category}/${p.id}`),
          name: p.data.title,
        })),
      }]
    : []),
];
---

<Layout
  title={title}
  seoTitle={seo_title}
  {description}
  {image}
  {schemaData}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />

    <header class="category-header">
      <h1>{title}</h1>
      <p>{description}</p>
      <QuoteCta item={nav_label ?? title} compact />
    </header>

    <div class:list={['layout-grid', { 'no-filter': !showFilter }]}>
      {showFilter && (
        <aside class="sidebar">
          <div class="filter-box" id="product-filter">
            <p class="filter-title">Lọc sản phẩm</p>
            {brands.length > 1 && (
              <fieldset class="filter-group">
                <legend>Thương hiệu</legend>
                {brands.map((b) => <label><input type="checkbox" name="brand" value={b} /> {b}</label>)}
              </fieldset>
            )}
            {grades.length > 1 && (
              <fieldset class="filter-group">
                <legend>Cấp độ nhớt / độ cứng</legend>
                {grades.map((g) => <label><input type="checkbox" name="grade" value={g} /> {g}</label>)}
              </fieldset>
            )}
          </div>
        </aside>
      )}

      <div class="products-area">
        {products.length > 0 ? (
          <div class="grid" id="product-grid">
            {products.map((product) => (
              <article class="product-card" data-brand={product.data.brand} data-grade={productGrade(product) ?? ''}>
                {(product.data.images?.[0] ?? product.data.image) && (
                  <img src={product.data.images?.[0] ?? product.data.image} alt={product.data.title} width="400" height="200" loading="lazy" decoding="async" />
                )}
                <div class="product-info">
                  <div class="tags">
                    <span class="badge">{product.data.brand}</span>
                    {productGrade(product) && <span class="badge badge-outline">{productGrade(product)}</span>}
                  </div>
                  <h2><a href={`/${category}/${product.id}`}>{product.data.title}</a></h2>
                  <p>{product.data.description.length > 110 ? product.data.description.slice(0, 110) + '…' : product.data.description}</p>
                  <div class="card-actions">
                    <a href={`/${category}/${product.id}`} class="btn-view">Xem chi tiết →</a>
                    <a href={`/bao-gia?sp=${encodeURIComponent(product.data.title)}`} class="btn-quote" data-track="add_to_quote">Báo giá</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p><strong>Danh sách sản phẩm {(nav_label ?? title).toLowerCase()} đang được cập nhật.</strong></p>
            <p>Các mã hàng phổ biến và sản phẩm tương đương được liệt kê trong phần nội dung bên dưới. Gửi yêu cầu để nhận báo giá và kiểm tra tồn kho.</p>
            <QuoteCta item={nav_label ?? title} compact />
          </div>
        )}

        <div class="seo-content markdown-body">
          <Content />
          <QuoteCta item={nav_label ?? title} />
          {(reviewed_by || updated) && (
            <p class="review-meta">
              {reviewed_by && <>Nội dung được duyệt kỹ thuật bởi {reviewed_by}. </>}
              {updated && <>Cập nhật: {updated.toLocaleDateString('vi-VN')}.</>}
            </p>
          )}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Lọc sản phẩm phía client theo hãng và cấp độ nhớt / NLGI.
  const box = document.getElementById('product-filter');
  const cards = document.querySelectorAll<HTMLElement>('#product-grid .product-card');
  box?.addEventListener('change', () => {
    const picked = (name: string) =>
      [...box.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value);
    const brands = picked('brand');
    const grades = picked('grade');
    cards.forEach((card) => {
      const okBrand = !brands.length || brands.includes(card.dataset.brand ?? '');
      const okGrade = !grades.length || grades.includes(card.dataset.grade ?? '');
      card.hidden = !(okBrand && okGrade);
    });
  });
</script>

<style>
  .category-header { background: white; padding: 32px; border-radius: 8px; margin: 0 0 30px; border: 1px solid var(--border-color); }
  .category-header h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); color: var(--color-primary); margin-bottom: 10px; line-height: 1.25; text-wrap: balance; }
  .category-header p { max-width: 75ch; color: var(--color-text-light); }

  .layout-grid { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 40px; margin-bottom: 60px; }
  .layout-grid.no-filter { grid-template-columns: minmax(0, 1fr); }
  @media (max-width: 860px) { .layout-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; } }

  .sidebar .filter-box { background: white; padding: 20px; border-radius: 8px; border: 1px solid var(--border-color); position: sticky; top: 90px; }
  .filter-title { font-weight: 700; color: var(--color-primary); }
  .filter-group { border: 0; margin-top: 16px; }
  .filter-group legend { font-weight: 600; margin-bottom: 8px; }
  .filter-group label { display: block; margin-bottom: 6px; color: var(--color-text-light); cursor: pointer; }

  .products-area .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-bottom: 40px; }
  .product-card { background: white; border-radius: 8px; overflow: hidden; border: 1px solid var(--border-color); display: flex; flex-direction: column; }
  .product-card[hidden] { display: none; }
  .product-card img { width: 100%; height: 200px; object-fit: cover; }
  .product-info { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
  .product-info h2 { margin: 12px 0 8px; font-size: 1.1rem; color: var(--color-primary); }
  .product-info p { color: var(--color-text-light); font-size: 0.95rem; margin-bottom: 16px; flex-grow: 1; }
  .card-actions { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .btn-view { color: var(--color-primary); font-weight: 600; }
  .btn-quote { color: var(--color-accent); font-weight: 600; }
  .badge { background: #e2e8f0; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; margin-right: 5px; }
  .badge-outline { background: transparent; border: 1px solid #cbd5e1; }

  .empty-state { background: white; border: 1px dashed #cbd5e1; border-radius: 8px; padding: 24px; margin-bottom: 30px; }
  .empty-state p + p { margin-top: 8px; color: var(--color-text-light); }

  .seo-content { background: white; padding: clamp(20px, 4vw, 40px); border-radius: 8px; border: 1px solid var(--border-color); overflow-wrap: anywhere; }
  .review-meta { margin-top: 20px; font-size: 0.9rem; color: var(--color-text-light); }
  :global(.seo-content h2) { color: var(--color-primary); margin: 32px 0 14px; font-size: 1.6rem; line-height: 1.3; }
  :global(.seo-content h3) { color: var(--color-primary); margin: 22px 0 10px; font-size: 1.25rem; }
  :global(.seo-content p) { margin-bottom: 15px; line-height: 1.7; font-size: 1.05rem; max-width: 80ch; }
  :global(.seo-content ul), :global(.seo-content ol) { margin: 0 0 15px 22px; line-height: 1.7; font-size: 1.05rem; }
  :global(.seo-content li) { margin-bottom: 8px; }
  :global(.seo-content strong) { font-weight: 700; color: #111; }
  :global(.seo-content a) { color: var(--color-accent); text-decoration: underline; }
  :global(.seo-content table) { display: block; overflow-x: auto; border-collapse: collapse; margin: 10px 0 20px; font-size: 0.95rem; }
  :global(.seo-content th), :global(.seo-content td) { border: 1px solid var(--border-color); padding: 8px 12px; text-align: left; vertical-align: top; }
  :global(.seo-content th) { background: #f1f5f9; }
  :global(.seo-content hr) { border: 0; border-top: 1px solid var(--border-color); margin: 30px 0; }
</style>
