---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('sanpham');
  const categories = await getCollection('danhmuc');
  
  return categories.map(cat => {
    const categoryProducts = products.filter(p => p.data.category === cat.id);
    return {
      params: { category: cat.id },
      props: { 
        products: categoryProducts, 
        categoryName: cat.data.title,
        categoryInfo: cat
      }
    };
  });
}

const { category } = Astro.params;
const { products, categoryName, categoryInfo } = Astro.props;
const { Content } = await render(categoryInfo);

// Schema Category
const schemaData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${categoryName} Chính Hãng`,
  "description": `Danh mục sản phẩm ${categoryName} nhập khẩu trực tiếp.`
};
---

<Layout 
  title={`${categoryName} Chính Hãng | Báo Giá Tốt Nhất 2026`}
  seoTitle={categoryInfo.data.seo_title}
  description={categoryInfo.data.description || `Tổng hợp các loại ${categoryName.toLowerCase()} chất lượng cao, đầy đủ độ nhớt, hàng nhập khẩu chính hãng 100%.`}
  keywords={categoryInfo.data.keywords}
  canonical={categoryInfo.data.canonical_url}
  schemaData={schemaData}
>
  <div class="container">
    <div class="category-header">
      <h1>{categoryName}</h1>
      <p>Lựa chọn sản phẩm tối ưu nhất cho hệ thống máy móc của bạn. Phân phối chính thức hàng Castrol, Shell, Total.</p>
    </div>

    <div class="layout-grid">
      <!-- Sidebar / Faceted Filter -->
      <aside class="sidebar">
        <div class="filter-box">
          <h3>Bộ Lọc Sản Phẩm</h3>
          <div class="filter-group">
            <h4>Thương hiệu</h4>
            <label><input type="checkbox" /> Castrol</label>
            <label><input type="checkbox" /> Shell</label>
            <label><input type="checkbox" /> Total</label>
          </div>
          <div class="filter-group">
            <h4>Độ nhớt ISO VG</h4>
            <label><input type="checkbox" /> VG 32</label>
            <label><input type="checkbox" /> VG 46</label>
            <label><input type="checkbox" /> VG 68</label>
          </div>
        </div>
      </aside>

      <!-- Products Grid -->
      <div class="products-area">
        <div class="grid">
          {products.map(product => (
            <div class="product-card">
              <img src={product.data.image} alt={product.data.title} />
              <div class="product-info">
                <div class="tags">
                  <span class="badge">{product.data.brand}</span>
                  <span class="badge badge-outline">VG {product.data.vg}</span>
                </div>
                <h3><a href={`/${category}/${product.id}`}>{product.data.title}</a></h3>
                <p>{product.data.description.substring(0, 100)}...</p>
                <a href={`/${category}/${product.id}`} class="btn-view">Xem chi tiết &rarr;</a>
              </div>
            </div>
          ))}
        </div>
        
        <!-- SEO Content Area (At bottom) -->
        <div class="seo-content markdown-body">
          <Content />
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .category-header { background: white; padding: 40px; border-radius: 8px; margin: 40px 0; border: 1px solid var(--border-color); text-align: center; }
  .category-header h1 { font-size: 2.5rem; color: var(--color-primary); margin-bottom: 10px; }
  
  .layout-grid { display: grid; grid-template-columns: 250px 1fr; gap: 40px; margin-bottom: 60px; }
  
  .sidebar .filter-box { background: white; padding: 20px; border-radius: 8px; border: 1px solid var(--border-color); position: sticky; top: 100px; }
  .filter-group { margin-top: 20px; }
  .filter-group h4 { margin-bottom: 10px; font-size: 1rem; }
  .filter-group label { display: block; margin-bottom: 8px; color: var(--color-text-light); cursor: pointer; }
  
  .products-area .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 40px; }
  
  .product-card { background: white; border-radius: 8px; overflow: hidden; border: 1px solid var(--border-color); display: flex; flex-direction: column; }
  .product-card img { width: 100%; height: 200px; object-fit: cover; }
  .product-info { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
  .product-info h3 { margin: 15px 0 10px; font-size: 1.1rem; }
  .product-info p { color: var(--color-text-light); font-size: 0.95rem; margin-bottom: 20px; flex-grow: 1; }
  .btn-view { color: var(--color-accent); font-weight: 600; }
  .badge { background: #e2e8f0; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; margin-right: 5px; }
  
  .seo-content { background: white; padding: 40px; border-radius: 8px; border: 1px solid var(--border-color); }
  :global(.seo-content h2) { color: var(--color-primary); margin: 30px 0 15px; font-size: 1.8rem; }
  :global(.seo-content h3) { color: var(--color-primary); margin: 25px 0 10px; font-size: 1.4rem; }
  :global(.seo-content p) { margin-bottom: 15px; line-height: 1.7; font-size: 1.05rem; }
  :global(.seo-content ul), :global(.seo-content ol) { margin: 0 0 15px 20px; line-height: 1.7; font-size: 1.05rem; }
  :global(.seo-content li) { margin-bottom: 8px; }
  :global(.seo-content strong) { font-weight: 700; color: #111; }
</style>
