---
import Layout from '../../layouts/Layout.astro';
import ContentBody from '../../components/ContentBody.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NoiDungBai from '../../components/NoiDungBai.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import StockTable from '../../components/StockTable.astro';
import NutBaoGia from '../../components/NutBaoGia.astro';
import PriceTable from '../../components/PriceTable.astro';
import CachVietBai from '../../components/CachVietBai.astro';
import ChinhSachGiaKho from '../../components/ChinhSachGiaKho.astro';
import ThongTinDoanhNghiep from '../../components/ThongTinDoanhNghiep.astro';
import { bangGiaTuJson } from '../../lib/gia-json';
import { fmtNgay, fmtKhoang } from '../../lib/gia-tinh';
import type { DongGiaCongKhai } from '../../lib/gia';
import { trangBaoGiaCua } from '../../lib/bao-gia-danh-muc';
import stockRows from '../../data/san-pham-kho.json';
import { render } from 'astro:content';
import { getActiveProducts, getActiveCategories } from '../../lib/content';
import { ngayBai } from '../../lib/ngay';
import { timNhanSu, DEFAULT_REVIEWER_ID, DEFAULT_PRODUCT_AUTHOR_ID, bylineLabel, personRef, personUrl, personSchema } from '../../lib/nhan-su';
import { absUrl, breadcrumbSchema, ORG_ID, publicImageExists, webpSrcset, productImages } from '../../lib/site';

export async function getStaticPaths() {
  const products = await getActiveProducts();
  const categories = await getActiveCategories();

  // /mo-boi-tron-cong-nghiep dùng trang riêng src/pages/mo-boi-tron-cong-nghiep.astro.
  return categories.filter((cat) => cat.id !== 'mo-boi-tron-cong-nghiep').map((cat) => ({
    params: { category: cat.id },
    props: {
      products: products.filter((p) => p.data.category === cat.id),
      categoryInfo: cat,
    },
  }));
}

const { category } = Astro.params;
// Danh mục có trang báo giá riêng: một link chữ rõ nghĩa trước lưới; các nút "Báo giá" là <button> (NutBaoGia).
const trangGia = trangBaoGiaCua(category);
const { products, categoryInfo } = Astro.props;
const { Content } = await render(categoryInfo);
const { nav_label, reviewed_by, tac_gia, updated, bang_gia } = categoryInfo.data;

// Danh mục gộp báo giá (trường bang_gia, 20/11/2026): bảng giá nằm ngay trong trang danh mục.
const giaJson = bang_gia ? bangGiaTuJson(category!) : undefined;
const thangGia = fmtNgay(giaJson?.cauHinh.ngay_ra_soat, 'thang');
const coThang = (t: string) => t.replace('{thang}', thangGia).replace(/\s*\{thang\}/, '');
const title = coThang(categoryInfo.data.title);
const seo_title = categoryInfo.data.seo_title ? coThang(categoryInfo.data.seo_title) : undefined;
const description = coThang(categoryInfo.data.description);
const rowsGia: DongGiaCongKhai[] = giaJson ? [
  ...giaJson.rows.filter((r) => r.thap && r.cao),
  ...(bang_gia?.lien_he ?? []).map((r) => ({ ...r, trang: r.trang ?? null, thap: null, cao: null, thap_don_vi: null, cao_don_vi: null, don_vi_do: 'L' as const })),
] : [];
type Khoang = { thap: number; cao: number; lThap: number; lCao: number };
const khoangCua = (xs: DongGiaCongKhai[]): Khoang | null => {
  const co = xs.filter((r) => r.thap && r.cao && r.thap_don_vi && r.cao_don_vi);
  return co.length ? {
    thap: Math.min(...co.map((r) => r.thap!)), cao: Math.max(...co.map((r) => r.cao!)),
    lThap: Math.min(...co.map((r) => r.thap_don_vi!)), lCao: Math.max(...co.map((r) => r.cao_don_vi!)),
  } : null;
};
const kPhuy = khoangCua(rowsGia.filter((r) => /phuy/i.test(r.quy_cach)));
const kCan = khoangCua(rowsGia.filter((r) => /can|xô/i.test(r.quy_cach)));
const ngay = ngayBai(categoryInfo.data);
// Bỏ ảnh khi file chưa được tạo (tránh og:image và schema trỏ tới ảnh 404).
const image = publicImageExists(categoryInfo.data.image) ? categoryInfo.data.image : undefined;
const pagePath = `/${category}`;
const hasStock = stockRows.some((r) => r.danh_muc === category);
// Cắt mô tả ở ranh giới từ, không cắt giữa chữ.
const catGon = (t: string, n: number) => (t.length > n ? t.slice(0, t.lastIndexOf(' ', n) > 0 ? t.lastIndexOf(' ', n) : n) + '…' : t);
const activePages = new Set(products.map((p) => p.id));
const tdsTheoTrang = Object.fromEntries(products.map((p) => [p.id, p.data.tds_url as string | undefined]));
// Danh mục có trang báo giá riêng (12/11/2026): trang danh mục lo chọn và mua, không đặt nút "Báo giá"/"Nhận giá sỉ";
// thay bằng link sang trang báo giá để hai trang không tranh từ khóa giá.
const BANG_GIA: Record<string, { href: string; label: string; tuVan: string }> = {
  'dau-thuy-luc': { href: '/bao-gia-dau-thuy-luc', label: 'Xem bảng giá dầu thủy lực', tuVan: 'Cần tư vấn chọn dầu thủy lực?' },
};
const bangGia = category ? BANG_GIA[category] : undefined;

const crumbs = [
  { name: 'Trang chủ', href: '/' },
  { name: nav_label ?? title, href: pagePath },
];

// Bộ lọc chỉ hiện khi có từ 2 giá trị trở lên, lấy từ sản phẩm thật trong danh mục.
const brands = [...new Set(products.map((p) => p.data.brand))].sort();
const grades = [...new Set(products.map((p) => (p.data.vg ? `VG ${p.data.vg}` : p.data.nlgi ? `NLGI ${p.data.nlgi}` : null)).filter(Boolean))] as string[];
const showFilter = products.length >= 4 && (brands.length > 1 || grades.length > 1);

const productGrade = (p: (typeof products)[number]) =>
  p.data.vg ? `VG ${p.data.vg}` : p.data.nlgi ? `NLGI ${p.data.nlgi}` : null;

// Tác giả: Ms. Hồng (tac_gia); duyệt nội dung: TS. Lập (reviewed_by). Giống trang sản phẩm.
const tacGia = timNhanSu(tac_gia) ?? timNhanSu(DEFAULT_PRODUCT_AUTHOR_ID);
const reviewer = timNhanSu(reviewed_by) ?? timNhanSu(DEFAULT_REVIEWER_ID);
// Nguồn dẫn: TDS của các sản phẩm trong danh mục + liên kết ra ngoài site trong nội dung bài danh mục.
const citation = [...new Set([
  ...products.map((p) => p.data.tds_url),
  ...((categoryInfo.body ?? '').match(/https?:\/\/[^\s)"'<>]+/g) ?? []),
].filter((u): u is string => Boolean(u) && !u!.includes('daucongnghiephp.com.vn')))];

const PAGE_ID = absUrl(pagePath) + '#webpage';
const PAGE_TYPE = ['CollectionPage', 'WebPage'];

const schemaData = [
  {
    '@context': 'https://schema.org',
    // Thêm WebPage cạnh CollectionPage: một số công cụ kiểm tra E-E-A-T chỉ nhận WebPage/Article.
    '@type': PAGE_TYPE,
    '@id': PAGE_ID,
    name: title,
    description,
    about: { '@type': 'Thing', name: nav_label ?? title },
    url: absUrl(pagePath),
    ...(image ? { image: absUrl(image) } : {}),
    ...(ngay.published ? { datePublished: ngay.published } : {}),
    ...(ngay.modified ? { dateModified: ngay.modified } : {}),
    ...(tacGia ? { author: personRef(tacGia) } : {}),
    ...(reviewer ? { reviewedBy: personRef(reviewer) } : {}),
    ...(citation.length ? { citation } : {}),
    inLanguage: 'vi-VN',
    isPartOf: { '@id': absUrl('/') + '#website' },
    publisher: { '@id': ORG_ID },
  },
  ...(tacGia ? [personSchema(tacGia)] : []),
  ...(reviewer && reviewer.id !== tacGia?.id ? [personSchema(reviewer)] : []),
  breadcrumbSchema(crumbs),
  ...(products.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        itemListElement: products.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: absUrl(`/${category}/${p.id}`),
          name: p.data.title,
        })),
      }]
    : []),
];
---

<Layout
  title={title}
  seoTitle={seo_title}
  {description}
  {image}
  published={ngay.published}
  modified={ngay.modified}
  author={tacGia?.name}
  {schemaData}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />

    <NoiDungBai articleId={PAGE_ID} type={PAGE_TYPE} field="text">
    <header class="category-header">
      <h1>{title}</h1>
      {tacGia && (
        <p class="byline">
          {ngay.published && <>Đăng ngày <time datetime={ngay.published}>{ngay.publishedText}</time> · </>}
          {ngay.modified && ngay.modified !== ngay.published && <>Cập nhật ngày <time datetime={ngay.modified}>{ngay.modifiedText}</time> · </>}
          <a href={personUrl(tacGia)} rel="author">{bylineLabel(tacGia)}</a>
          {reviewer && reviewer.id !== tacGia.id && <> · Duyệt nội dung: <a href={personUrl(reviewer)}>{bylineLabel(reviewer)}</a></>}
        </p>
      )}
      <p>{description}</p>
      {!bangGia && trangGia && <p class="link-bang-gia"><a href={trangGia.href}>{trangGia.chuDanhMuc} →</a></p>}
      <QuoteCta item={nav_label ?? title} danhMuc={category} compact bangGia={bangGia} />
    </header>

    {category === 'dau-thuy-luc' && <PromoBanner />}

    {bang_gia && (
      <div class="seo-content markdown-body gop-truoc">
        <ContentBody phan="truoc">
          <Content />
          <section slot="sau-doan-dau" class="gia-gop" id="bang-gia" aria-labelledby="tieu-de-bang-gia">
            <h2 id="tieu-de-bang-gia">{coThang(bang_gia.tieu_de)}</h2>
            <ul class="gia-gop__tom-tat">
              {kPhuy && <li><strong>Phuy 200–209 L:</strong> {fmtKhoang(kPhuy.thap, kPhuy.cao)} đ/phuy, quy đổi {fmtKhoang(kPhuy.lThap, kPhuy.lCao)} đ/lít.</li>}
              {kCan && <li><strong>Can, xô 18 L:</strong> {fmtKhoang(kCan.thap, kCan.cao)} đ/can, quy đổi {fmtKhoang(kCan.lThap, kCan.lCao)} đ/lít.</li>}
              <li>Giá {giaJson!.cauHinh.gom_vat ? 'đã gồm' : 'chưa gồm'} VAT, rà soát ngày <time datetime={giaJson!.cauHinh.ngay_ra_soat}>{fmtNgay(giaJson!.cauHinh.ngay_ra_soat)}</time>. Mỗi dòng là khoảng từ giá kho đến giá kho cộng 15%, giá chốt theo số lượng và nơi giao.</li>
            </ul>
            <PriceTable rows={rowsGia} {activePages} category={category!} gomVat={giaJson!.cauHinh.gom_vat} tds={tdsTheoTrang} gon />
          </section>
        </ContentBody>
      </div>
    )}

    <div class:list={['layout-grid', { 'no-filter': !showFilter }]}>
      {showFilter && (
        <aside class="sidebar">
          <div class="filter-box" id="product-filter">
            <p class="filter-title">Lọc sản phẩm</p>
            {brands.length > 1 && (
              <fieldset class="filter-group">
                <legend>Thương hiệu</legend>
                {brands.map((b) => <label><input type="checkbox" name="brand" value={b} /> {b}</label>)}
              </fieldset>
            )}
            {grades.length > 1 && (
              <fieldset class="filter-group">
                <legend>Cấp độ nhớt / độ cứng</legend>
                {grades.map((g) => <label><input type="checkbox" name="grade" value={g} /> {g}</label>)}
              </fieldset>
            )}
          </div>
        </aside>
      )}

      <div class="products-area">
        {bang_gia && products.length > 0 && <h2 class="tieu-de-luoi">Các mã {(nav_label ?? title).toLowerCase()} có tại kho</h2>}
        {products.length > 0 ? (
          <div class="grid" id="product-grid">
            {products.map((product) => (
              <article class="product-card" data-brand={product.data.brand} data-grade={productGrade(product) ?? ''}>
                {productImages(product.data)[0] && (
              <img src={productImages(product.data)[0].src} srcset={webpSrcset(productImages(product.data)[0].src)} sizes="(max-width: 600px) 100vw, 400px" alt={productImages(product.data)[0].alt} width="400" height="200" loading="lazy" decoding="async" />
            )}
                <div class="product-info">
                  <div class="tags">
                    <span class="badge">{product.data.brand}</span>
                    {productGrade(product) && <span class="badge badge-outline">{productGrade(product)}</span>}
                  </div>
                  {bang_gia
                    ? <h3 class="ten-sp"><a href={`/${category}/${product.id}`}>{product.data.title}</a></h3>
                    : <h2><a href={`/${category}/${product.id}`}>{product.data.title}</a></h2>}
                  <p>{catGon(product.data.description, 110)}</p>
                  <div class="card-actions">
                    <a href={`/${category}/${product.id}`} class="btn-view">Xem chi tiết →</a>
                    {!bangGia && <NutBaoGia sp={product.data.title} danhMuc={category} class="btn-quote">Báo giá</NutBaoGia>}
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : !hasStock && (
          <div class="empty-state">
            <p><strong>Danh sách sản phẩm {(nav_label ?? title).toLowerCase()} đang được cập nhật.</strong></p>
            <p>Các mã hàng phổ biến và sản phẩm tương đương được liệt kê trong phần nội dung bên dưới. Gửi yêu cầu để nhận báo giá và kiểm tra tồn kho.</p>
            <QuoteCta item={nav_label ?? title} danhMuc={category} compact />
          </div>
        )}

        {!bang_gia && <StockTable category={category!} label={nav_label ?? title} pages={products.map((p) => p.id)} coTrangGia={Boolean(bangGia)} />}

        <div class="seo-content markdown-body">
          <ContentBody phan={bang_gia ? 'sau' : undefined}><Content /></ContentBody>
          <QuoteCta item={nav_label ?? title} danhMuc={category} bangGia={bangGia} heading={bangGia?.tuVan} />
          {!tacGia && (reviewed_by || updated) && (
            <p class="review-meta">
              {reviewed_by && <>Nội dung được duyệt kỹ thuật bởi {reviewed_by}. </>}
              {ngay.modified && <>Cập nhật: <time datetime={ngay.modified}>{ngay.modifiedText}</time>.</>}
            </p>
          )}
          {bang_gia && tacGia && reviewer && ngay.modified && (
            <>
              <CachVietBai tacGia={tacGia} nguoiDuyet={reviewer} chucDanhDuyet={reviewer.id === 'vu-minh-toan' ? 'kỹ sư Công nghệ ô tô, 6 năm phụ trách dầu làm mát và bôi trơn tại nhà máy (2009–2015)' : undefined} ngayGia={giaJson!.cauHinh.ngay_ra_soat || undefined} ngayCapNhat={ngay.modified} />
              <ChinhSachGiaKho />
              <ThongTinDoanhNghiep />
            </>
          )}
        </div>
      </div>
    </div>
    </NoiDungBai>
  </div>
</Layout>

<script>
  // Lọc sản phẩm phía client theo hãng và cấp độ nhớt / NLGI.
  const box = document.getElementById('product-filter');
  const cards = document.querySelectorAll<HTMLElement>('#product-grid .product-card');
  box?.addEventListener('change', () => {
    const picked = (name: string) =>
      [...box.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value);
    const brands = picked('brand');
    const grades = picked('grade');
    cards.forEach((card) => {
      const okBrand = !brands.length || brands.includes(card.dataset.brand ?? '');
      const okGrade = !grades.length || grades.includes(card.dataset.grade ?? '');
      card.hidden = !(okBrand && okGrade);
    });
  });
</script>

<style>
  .category-header { background: white; padding: 32px; border-radius: 8px; margin: 0 0 30px; border: 1px solid var(--border-color); }
  .category-header h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); color: var(--color-primary); margin-bottom: 10px; line-height: 1.25; text-wrap: balance; }
  .category-header p { max-width: 75ch; color: var(--color-text-light); }
  .category-header .byline { font-size: 0.85rem; margin: -4px 0 10px; }
  .category-header .byline a { color: inherit; text-decoration: underline; }

  .layout-grid { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 40px; margin-bottom: 60px; }
  .layout-grid.no-filter { grid-template-columns: minmax(0, 1fr); }
  @media (max-width: 860px) { .layout-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; } }

  .sidebar .filter-box { background: white; padding: 20px; border-radius: 8px; border: 1px solid var(--border-color); position: sticky; top: 90px; }
  .filter-title { font-weight: 700; color: var(--color-primary); }
  .filter-group { border: 0; margin-top: 16px; }
  .filter-group legend { font-weight: 600; margin-bottom: 8px; }
  .filter-group label { display: block; margin-bottom: 6px; color: var(--color-text-light); cursor: pointer; }

  .products-area .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-bottom: 40px; }
  .product-card { background: white; border-radius: 8px; overflow: hidden; border: 1px solid var(--border-color); display: flex; flex-direction: column; }
  .product-card[hidden] { display: none; }
  .product-card img { width: 100%; height: 200px; object-fit: cover; }
  .product-info { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
  .tieu-de-luoi { color: var(--color-primary); margin: 0 0 16px; font-size: 1.5rem; }
  .product-info .ten-sp { margin: 12px 0 8px; font-size: 1.1rem; color: var(--color-primary); }
  .product-info h2 { margin: 12px 0 8px; font-size: 1.1rem; color: var(--color-primary); }
  .product-info p { color: var(--color-text-light); font-size: 0.95rem; margin-bottom: 16px; flex-grow: 1; }
  .card-actions { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .btn-view { color: var(--color-primary); font-weight: 600; }
  .btn-quote { color: var(--color-accent); font-weight: 600; }
  .link-bang-gia { margin: 6px 0 0; }
  .link-bang-gia a { color: var(--color-accent); font-weight: 600; }
  .badge { background: #e2e8f0; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; margin-right: 5px; }
  .badge-outline { background: transparent; border: 1px solid #cbd5e1; }

  .empty-state { background: white; border: 1px dashed #cbd5e1; border-radius: 8px; padding: 24px; margin-bottom: 30px; }
  .empty-state p + p { margin-top: 8px; color: var(--color-text-light); }

  .gop-truoc { margin-bottom: 30px; }
  .gia-gop__tom-tat { background: #f8fafc; border: 1px solid var(--border-color); border-radius: 8px; padding: 14px 18px 14px 34px; }
  .seo-content { background: white; padding: clamp(20px, 4vw, 40px); border-radius: 8px; border: 1px solid var(--border-color); overflow-wrap: anywhere; }
  .review-meta { margin-top: 20px; font-size: 0.9rem; color: var(--color-text-light); }
  :global(.seo-content h2) { color: var(--color-primary); margin: 32px 0 14px; font-size: 1.6rem; line-height: 1.3; }
  :global(.seo-content h3) { color: var(--color-primary); margin: 22px 0 10px; font-size: 1.25rem; }
  :global(.seo-content p) { margin-bottom: 15px; line-height: 1.7; font-size: 1.05rem; max-width: 80ch; }
  :global(.seo-content ul), :global(.seo-content ol) { margin: 0 0 15px 22px; line-height: 1.7; font-size: 1.05rem; }
  :global(.seo-content li) { margin-bottom: 8px; }
  :global(.seo-content strong) { font-weight: 700; color: #111; }
  /* Chỉ link chữ trong bài; nút (btn-primary, btn-secondary) giữ màu riêng, nếu không chữ nút cam bị tô cam trùng nền. */
  :global(.seo-content a:not(.btn-primary):not(.btn-secondary)) { color: var(--color-accent); text-decoration: underline; }
  :global(.seo-content table) { display: block; overflow-x: auto; border-collapse: collapse; margin: 10px 0 20px; font-size: 0.95rem; }
  :global(.seo-content th), :global(.seo-content td) { border: 1px solid var(--border-color); padding: 8px 12px; text-align: left; vertical-align: top; }
  :global(.seo-content th) { background: #f1f5f9; }
  :global(.seo-content hr) { border: 0; border-top: 1px solid var(--border-color); margin: 30px 0; }
</style>
