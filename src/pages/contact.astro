---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteCta from '../components/QuoteCta.astro';
import { BUSINESS, ADDRESS_TEXT, ADDRESS_FULL, AREA_TEXT, LEGAL_NAME, TAX_ID, KCN_NEAR, KCN_FAR, breadcrumbSchema, absUrl, ORG_ID } from '../lib/site';

const crumbs = [
  { name: 'Trang chủ', href: '/' },
  { name: 'Liên hệ', href: '/contact' },
];
// TODO: khi có Google Business Profile, thay bằng link địa điểm (maps.app.goo.gl/...) và nhúng bản đồ.
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ADDRESS_TEXT)}`;
---

<Layout
  title="Liên Hệ"
  seoTitle="Liên Hệ Dầu Công Nghiệp HP – Kho Hải Phòng (Hải Dương cũ)"
  description={`Liên hệ Dầu Công Nghiệp HP (${LEGAL_NAME}): kho ${ADDRESS_FULL}. Hotline/Zalo ${BUSINESS.phoneDisplay}. Báo giá dầu nhớt công nghiệp.`}
  schemaData={[
    {
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      name: 'Liên hệ',
      url: absUrl('/contact'),
      inLanguage: 'vi-VN',
      mainEntity: { '@id': ORG_ID },
      isPartOf: { '@id': absUrl('/') + '#website' },
    },
    breadcrumbSchema(crumbs),
  ]}
>
  <div class="container contact-page">
    <Breadcrumbs items={crumbs} />
    <div class="contact-card">
      <h1>Liên hệ</h1>
      <dl>
        <dt>Doanh nghiệp</dt>
        <dd>{LEGAL_NAME}<br />Mã số thuế: {TAX_ID}</dd>
        <dt>Địa chỉ kho</dt>
        <dd>{ADDRESS_FULL} · <a href={mapsUrl} target="_blank" rel="noopener">Xem bản đồ</a></dd>
        <dt>Hotline / Zalo</dt>
        <dd><a href={`tel:${BUSINESS.phone}`} data-track="click_tel">{BUSINESS.phoneDisplay}</a> · <a href={BUSINESS.zaloUrl} target="_blank" rel="noopener" data-track="click_zalo">Nhắn Zalo</a></dd>
        <dt>Khu vực giao hàng</dt>
        <dd>{AREA_TEXT}, Bắc Ninh, Hưng Yên, Quảng Ninh, Hà Nội và các tỉnh miền Bắc. Gần kho: KCN {KCN_NEAR.join(', ')}. Giao thêm tới KCN {KCN_FAR.join(', ')}.</dd>
        <!-- TODO: bổ sung giờ làm việc và email khi có. -->
      </dl>
      <QuoteCta heading="Gửi danh sách sản phẩm cần mua" />
    </div>
  </div>
</Layout>

<style>
  .contact-page { margin-bottom: 60px; }
  .contact-card { background: white; border: 1px solid var(--border-color); border-radius: 8px; padding: clamp(20px, 4vw, 40px); max-width: 800px; }
  .contact-card h1 { color: var(--color-primary); margin-bottom: 20px; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 12px 20px; }
  @media (max-width: 600px) { dl { grid-template-columns: 1fr; gap: 4px; } dd { margin-bottom: 12px; } }
  dt { font-weight: 700; color: var(--color-primary); }
  dd a { color: var(--color-accent); }
</style>
