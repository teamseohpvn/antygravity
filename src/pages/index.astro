---
import Layout from '../layouts/Layout.astro';
import QuoteCta from '../components/QuoteCta.astro';
import PromoBanner from '../components/PromoBanner.astro';
import { getActiveProducts, getActiveCategories, getActivePosts } from '../lib/content';
import { AREA_TEXT, BRANDS, KCN_NEAR, KCN_FAR, publicImageExists, webpSrcset, productImages } from '../lib/site';

const products = await getActiveProducts();
const categories = (await getActiveCategories()).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
const posts = (await getActivePosts())
  .sort((a, b) => new Date(b.data.date ?? 0).valueOf() - new Date(a.data.date ?? 0).valueOf())
  .slice(0, 3);

const grade = (p: (typeof products)[number]) =>
  p.data.vg ? `VG ${p.data.vg}` : p.data.nlgi ? `NLGI ${p.data.nlgi}` : null;
---

<Layout
  title="Dầu Nhớt Công Nghiệp, Mỡ Bôi Trơn Chính Hãng"
  seoTitle="Dầu Nhớt Công Nghiệp, Mỡ Bôi Trơn – Hải Phòng (Hải Dương cũ)"
  description="Dầu thủy lực, mỡ bò, dầu bánh răng, dầu máy nén khí Shell, Castrol, Mobil cho nhà máy. Kho tại TP Hải Phòng (Hải Dương cũ). Có CO/CQ, VAT, báo giá sỉ."
  image="/images/hero-trang-chu.webp"
>
  <section class="hero">
    <img
      class="hero-bg"
      src="/images/hero-trang-chu.webp"
      srcset={webpSrcset('/images/hero-trang-chu.webp')}
      sizes="100vw"
      alt="Kỹ thuật viên rót dầu thủy lực vào bồn chứa của cụm bơm thủy lực trong nhà xưởng"
      width="1200"
      height="1200"
      fetchpriority="high"
      decoding="async"
    />
    <div class="container hero-content">
      <h1>Dầu nhớt công nghiệp và mỡ bôi trơn chính hãng cho nhà máy</h1>
      <p>Kho tại {AREA_TEXT}. Dầu thủy lực, mỡ bò, dầu bánh răng, dầu truyền nhiệt, dầu máy nén khí {BRANDS.slice(0, 4).join(', ')}. Có CO/CQ, hóa đơn VAT, tư vấn chọn sản phẩm tương đương. Giao tại các KCN Hải Phòng và các tỉnh miền Bắc.</p>
      <div class="hero-actions">
        <a href="/bao-gia" class="btn-primary" data-track="add_to_quote">Nhận báo giá sỉ</a>
        <a href="/dau-thuy-luc" class="btn-secondary">Xem dầu thủy lực</a>
      </div>
    </div>
  </section>

  <div class="container"><PromoBanner /></div>

  <section class="categories container" aria-labelledby="cat-title">
    <h2 class="section-title" id="cat-title">Danh mục sản phẩm</h2>
    <div class="grid">
      {categories.map((c) => (
        <a href={`/${c.id}`} class="category-card">
          {publicImageExists(c.data.image) && (
            <img
              class="card-bg"
              src={c.data.image}
              srcset={webpSrcset(c.data.image)}
              sizes="(max-width: 600px) 100vw, 380px"
              alt={c.data.image_alt ?? c.data.title}
              width="600"
              height="400"
              loading="lazy"
              decoding="async"
            />
          )}
          <h3>{c.data.nav_label ?? c.data.title}</h3>
          {c.data.summary && <p>{c.data.summary}</p>}
        </a>
      ))}
    </div>
  </section>

  <section class="why container" aria-labelledby="why-title">
    <h2 class="section-title" id="why-title">Vì sao nhà máy chọn Dầu Công Nghiệp HP</h2>
    <ul class="why-grid">
      <li><strong>Hàng chính hãng, đủ giấy tờ</strong><span>CO/CQ theo lô, hóa đơn VAT, TDS và SDS cho hồ sơ mua hàng.</span></li>
      <li><strong>Tư vấn sản phẩm tương đương</strong><span>Đối chiếu {BRANDS.join(', ')} theo cấp độ nhớt và tiêu chuẩn.</span></li>
      <li><strong>Kho tại Hải Dương cũ, giao nhanh KCN lân cận</strong><span>Phục vụ KCN {KCN_NEAR.slice(0, 3).join(', ')}, và {KCN_FAR.slice(0, 4).join(', ')}.</span></li>
    </ul>
    <QuoteCta />
  </section>

  {products.length > 0 && (
    <section class="products container" aria-labelledby="prod-title">
      <h2 class="section-title" id="prod-title">Sản phẩm tiêu biểu</h2>
      <div class="grid">
        {products.map((product) => (
          <article class="product-card">
            {productImages(product.data)[0] && (
              <img src={productImages(product.data)[0].src} srcset={webpSrcset(productImages(product.data)[0].src)} sizes="(max-width: 600px) 100vw, 400px" alt={productImages(product.data)[0].alt} width="400" height="200" loading="lazy" decoding="async" />
            )}
            <div class="product-info">
              <span class="badge">{product.data.brand}</span>
              {grade(product) && <span class="badge badge-outline">{grade(product)}</span>}
              <h3><a href={`/${product.data.category}/${product.id}`}>{product.data.title}</a></h3>
              <p>{product.data.description.length > 90 ? product.data.description.slice(0, 90) + '…' : product.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="posts container" aria-labelledby="post-title">
      <h2 class="section-title" id="post-title">Kiến thức kỹ thuật</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li><a href={`/ho-tro-ky-thuat/${post.id}`}>{post.data.title}</a><span>{post.data.description}</span></li>
        ))}
      </ul>
    </section>
  )}
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-primary);
    color: white;
    padding: 100px 0;
    text-align: center;
  }
  .hero-bg, .card-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(rgba(0, 51, 102, 0.8), rgba(0, 51, 102, 0.9)); z-index: 1; }
  .hero-content { position: relative; z-index: 2; }
  .category-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.7)); z-index: 1; }
  .category-card > h3, .category-card > p { position: relative; z-index: 2; }
  .hero h1 { font-size: clamp(1.9rem, 5vw, 3rem); margin-bottom: 20px; line-height: 1.2; text-wrap: balance; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .hero-actions .btn-primary, .hero-actions .btn-secondary { padding: 14px 26px; font-size: 1.05rem; }
  .hero p { font-size: 1.15rem; max-width: 720px; margin: 0 auto 30px; opacity: 0.9; }
  
  .section-title { text-align: center; font-size: 2rem; margin: 60px 0 30px; color: var(--color-primary); }
  
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 30px; margin-bottom: 40px; }
  
  .category-card { 
    position: relative;
    overflow: hidden;
    background-color: #333; 
    background-size: cover; 
    background-position: center; 
    padding: 60px 20px; 
    text-align: center; 
    border-radius: 8px; 
    box-shadow: 0 4px 6px rgba(0,0,0,0.1); 
    transition: transform 0.2s, box-shadow 0.2s; 
    border: none; 
    color: white; 
    text-decoration: none; 
    display: flex; 
    flex-direction: column; 
    justify-content: center; 
    min-height: 220px;
  }
  .category-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); }
  .category-card h3 { color: white; margin-bottom: 10px; font-size: 1.5rem; text-shadow: 0 2px 4px rgba(0,0,0,0.7); }
  .category-card p { text-shadow: 0 1px 3px rgba(0,0,0,0.7); font-size: 1rem; opacity: 0.9; color: white; }
  
  .product-card { background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border: 1px solid var(--border-color); }
  .product-card img { width: 100%; height: 200px; object-fit: cover; }
  .product-info { padding: 20px; }
  .product-info h3 { margin: 15px 0 10px; font-size: 1.25rem; }
  .product-info h3 a { color: var(--color-primary); }
  .product-info h3 a:hover { color: var(--color-accent); }
  .badge { background: #e2e8f0; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; margin-right: 5px; }
  .badge-outline { background: transparent; border: 1px solid #cbd5e1; }
  .hero { padding: clamp(60px, 10vw, 100px) 0; }
  .category-card { background-color: var(--color-primary); }
  .why-grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 20px; }
  .why-grid li { background: white; border: 1px solid var(--border-color); border-radius: 8px; padding: 20px; display: flex; flex-direction: column; gap: 6px; }
  .why-grid strong { color: var(--color-primary); }
  .why-grid span { color: var(--color-text-light); }
  .post-list { list-style: none; display: grid; gap: 12px; }
  .post-list li { background: white; border: 1px solid var(--border-color); border-radius: 8px; padding: 16px 20px; display: flex; flex-direction: column; gap: 4px; }
  .post-list a { color: var(--color-primary); font-weight: 600; }
  .post-list span { color: var(--color-text-light); font-size: 0.95rem; }
</style>
