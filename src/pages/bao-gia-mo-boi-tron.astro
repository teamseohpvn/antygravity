---
// Trang báo giá mỡ bôi trơn, mỡ bò. Phát hành 10/11/2026 (thay bản 09/11), nội dung từ bản nháp bannhap04 của chủ site.
// Giá đọc từ gia-cong-khai.json; trạng thái duyệt và kỳ hiệu lực ở src/data/bao-gia-mo-boi-tron.ts.
import Layout from '../layouts/Layout.astro';
import NoiDungBai from '../components/NoiDungBai.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteCta from '../components/QuoteCta.astro';
import CachVietBai from '../components/CachVietBai.astro';
import ChinhSachGiaKho from '../components/ChinhSachGiaKho.astro';
import ThongTinDoanhNghiep from '../components/ThongTinDoanhNghiep.astro';
import PriceTable from '../components/PriceTable.astro';
import { getActiveProducts } from '../lib/content';
import { fmtNgay, fmtVnd } from '../lib/gia-tinh';
import type { DongGiaCongKhai } from '../lib/gia';
import { bangGiaTuJson } from '../lib/gia-json';
import { timNhanSu, bylineLabel, personUrl, personRef, personSchema } from '../lib/nhan-su';
import { AN_DONG, KG_QUY_CACH, GIA_DA_DUYET, HIEU_LUC } from '../data/bao-gia-mo-boi-tron';
import { absUrl, breadcrumbSchema, ORG_ID, BUSINESS, ADDRESS_TEXT, KHO_GIAO_HANG } from '../lib/site';

const pagePath = '/bao-gia-mo-boi-tron';
const HUB = '/mo-boi-tron-cong-nghiep';
const HUB_NHIET = '/mo-chiu-nhiet';
const IMAGE = '/images/san-pham/vhp-lithium-grease-l4-xo-kho.webp';
const IMAGE_ALT = 'Xô mỡ VHP Lithium Grease L4 màu vàng nâu xếp chồng trong kho, phía trước là thẻ thông tin HT VINA có địa chỉ và số điện thoại';

const nguoiGia = timNhanSu('nguyen-thi-hong')!;
const nguoiDuyet = timNhanSu('vu-minh-toan')!;
const nguoiKho = timNhanSu('pham-van-huu')!;

// Giá đọc từ gia-cong-khai.json, giống trang /bao-gia-mo-boi-tron.
const thuong = bangGiaTuJson('mo-boi-tron-cong-nghiep');
const nhiet = bangGiaTuJson('mo-chiu-nhiet');
const cauHinh = thuong.cauHinh;
const sanPham = await getActiveProducts();
const danhMucCua = Object.fromEntries(sanPham.map((p) => [p.id, p.data.category as string]));
const activePages = new Set(sanPham.map((p) => p.id));
const tdsTheoTrang = Object.fromEntries(sanPham.map((p) => [p.id, p.data.tds_url as string | undefined]));
const MA_NHIET = new Set(nhiet.rows.map((r) => r.trang));

const lam100 = (n: number) => Math.round(n / 100) * 100;
const kgTrongTen = (qc: string) => Number(qc.match(/(\d+)\s*kg/i)?.[1]) || KG_QUY_CACH[qc] || null;
const rows: DongGiaCongKhai[] = [...nhiet.rows, ...thuong.rows]
  .filter((r) => !AN_DONG.includes(r.ten) && r.thap && r.cao)
  .map((r) => {
    const kg = kgTrongTen(r.quy_cach);
    const coKg = r.don_vi_do === 'kg' && r.thap_don_vi;
    return {
      ...r,
      ten: MA_NHIET.has(r.trang) ? `${r.ten} (chịu nhiệt)` : r.ten,
      ...(!coKg && kg ? { don_vi_do: 'kg', thap_don_vi: lam100(r.thap! / kg), cao_don_vi: lam100(r.cao! / kg) } : {}),
    };
  });
const hrefSp = (r: DongGiaCongKhai) => (r.trang && activePages.has(r.trang) ? `/${danhMucCua[r.trang]}/${r.trang}` : undefined);

type Khoang = { thap: number; cao: number; kgThap: number; kgCao: number };
const khoang = (xs: DongGiaCongKhai[]): Khoang | null => xs.length ? {
  thap: Math.min(...xs.map((r) => r.thap!)), cao: Math.max(...xs.map((r) => r.cao!)),
  kgThap: Math.min(...xs.map((r) => r.thap_don_vi!)), kgCao: Math.max(...xs.map((r) => r.cao_don_vi!)),
} : null;
const laPhuy = (r: DongGiaCongKhai) => /phuy/i.test(r.quy_cach);
const laXo = (r: DongGiaCongKhai) => /xô/i.test(r.quy_cach);
const tatCa = khoang(rows)!;
const kTrongNuocPhuy = khoang(rows.filter((r) => laPhuy(r) && r.nguon === 'trong-nuoc'))!;
const kTrongNuocXo = khoang(rows.filter((r) => laXo(r) && r.nguon === 'trong-nuoc'))!;
const kNhapPhuy = khoang(rows.filter((r) => laPhuy(r) && r.nguon === 'nhap-khau'))!;
const kNhapXo = khoang(rows.filter((r) => laXo(r) && r.nguon === 'nhap-khau'))!;
const kOng = khoang(rows.filter((r) => /ống/i.test(r.quy_cach)));
const nghin = (n: number) => fmtVnd(n);

// So phuy với xô của cùng một mã, cùng độ đặc, ở đầu thấp của khoảng.
const SO_QC = [...new Set(rows.map((r) => `${r.trang}|${r.cap}`))]
  .map((key) => {
    const cung = rows.filter((r) => `${r.trang}|${r.cap}` === key);
    const p = cung.find(laPhuy);
    const x = cung.filter(laXo).sort((a, b) => b.thap_don_vi! - a.thap_don_vi!)[0];
    return p && x ? { ten: p.ten, phuy: p.thap_don_vi!, xo: x.thap_don_vi!, xoQc: x.quy_cach, chenh: Math.round((p.thap_don_vi! / x.thap_don_vi! - 1) * 100) } : null;
  })
  .filter((x): x is NonNullable<typeof x> => !!x)
  .sort((a, b) => a.chenh - b.chenh);

const vat = cauHinh.gom_vat ? 'đã gồm VAT' : 'chưa VAT';
const ngay = fmtNgay(cauHinh.ngay_ra_soat);
const NGAY_DANG = '2026-11-10';
const NGAY_SUA_NOI_DUNG = '2026-11-10';
const ngayCapNhat = [NGAY_SUA_NOI_DUNG, cauHinh.ngay_ra_soat].filter(Boolean).sort().at(-1)!;
const ARTICLE_ID = absUrl(pagePath) + '#article';

const title = 'Báo giá mỡ bôi trơn (mỡ bò) T 11/2026: bảng giá theo độ đặc NLGI và phân tích chi phí';
const hetHieuLuc = HIEU_LUC ? new Date().toISOString().slice(0, 10) > HIEU_LUC.den : false;
const seoTitle = 'Báo Giá Mỡ Bôi Trơn (Mỡ Bò) 11/2026: Theo Độ Đặc NLGI';
const description = `Báo giá mỡ bôi trơn, mỡ bò tháng 11/2026: ${nghin(tatCa.kgThap)}–${nghin(tatCa.kgCao)} đ/kg ${vat}, theo độ đặc NLGI, phuy 180 kg, xô 17 kg. Vì sao giá chênh, nên mua phuy hay xô.`;
const QUOTE = `/bao-gia?sp=${encodeURIComponent('Mỡ bôi trơn (mỡ bò)')}`;

const quyTrinh = [
  { buoc: 'Gửi yêu cầu', viec: 'Cho chúng tôi biết mã mỡ đang dùng (hoặc chụp nhãn xô, phuy), hoặc loại máy, vị trí bôi trơn và nhiệt độ làm việc. Chúng tôi đối chiếu TDS để gợi ý mã tương đương nếu bạn cần giảm chi phí.', nguoi: nguoiGia },
  { buoc: 'Nhận báo giá bằng văn bản', viec: 'Báo giá ghi rõ thời hạn hiệu lực, quy cách đóng gói, nơi giao, giá trước thuế, tiền thuế và các khoản phí, nếu có.', nguoi: nguoiGia },
  { buoc: 'Giao hàng', viec: 'Đơn đặt trước 16h ngày làm việc được giao trong ngày cho các KCN dọc đường 5 cũ nếu mã có sẵn; nơi khác trong 80 km giao theo lịch hẹn, miễn phí vận chuyển.', nguoi: nguoiKho },
  { buoc: 'Bàn giao chứng từ', viec: 'Hàng giao kèm phiếu giao hàng, hóa đơn VAT điện tử và CO/CQ theo lô với các hãng có cấp chứng từ này.', nguoi: nguoiGia },
];

const crumbs = [
  { name: 'Trang chủ', href: '/' },
  { name: 'Mỡ bôi trơn (mỡ bò)', href: HUB },
  { name: 'Báo giá mỡ bôi trơn', href: pagePath },
];
const citation = [
  ...new Set(rows.map((r) => tdsTheoTrang[r.trang ?? '']).filter(Boolean) as string[]),
].map((u) => (u.startsWith('http') ? u : absUrl(u))).concat([
  'https://www.lubesngreases.com/factbook/fb-article/grease-market-trends/',
  'https://www.stle.org/files/TLTArchives/2024/12_December/Cover_Story.aspx',
]);
const schemaData = [
  {
    '@context': 'https://schema.org', '@type': 'Article', '@id': ARTICLE_ID, headline: seoTitle, description, url: absUrl(pagePath),
    mainEntityOfPage: absUrl(pagePath), image: absUrl(IMAGE), inLanguage: 'vi-VN', author: personRef(nguoiGia), reviewedBy: personRef(nguoiDuyet),
    citation, datePublished: NGAY_DANG, dateModified: ngayCapNhat, publisher: { '@id': ORG_ID },
  },
  personSchema(nguoiGia),
  personSchema(nguoiDuyet),
  breadcrumbSchema(crumbs),
];
---

<Layout {title} {seoTitle} {description} type="article" image={IMAGE.replace('.webp', '-og.webp')} published={NGAY_DANG} modified={ngayCapNhat} author={nguoiGia.name} {schemaData}>
  <div class="container price-page">
    <Breadcrumbs items={crumbs} />

    <NoiDungBai articleId={ARTICLE_ID}>
    <header class="price-hero">
      <h1>{title}</h1>
      <p class="dong-duyet">
        Lập giá: <a href={personUrl(nguoiGia)}>{bylineLabel(nguoiGia)}</a> · Duyệt giá: <a href={personUrl(nguoiDuyet)}>{bylineLabel(nguoiDuyet)}</a> (GĐ HT VINA) · {GIA_DA_DUYET && HIEU_LUC ? (hetHieuLuc ? <>Kỳ giá đã kết thúc, đang rà lại</> : <>Hiệu lực: <time datetime={HIEU_LUC.tu}>{fmtNgay(HIEU_LUC.tu)}</time>–<time datetime={HIEU_LUC.den}>{fmtNgay(HIEU_LUC.den)}</time></>) : <>Kỳ giá đang chờ duyệt</>} · <a href="#cach-viet-bai">Cách chúng tôi lập giá</a>
      </p>
      <figure class="anh-dau">
        <img src={IMAGE} srcset={`${IMAGE.replace('.webp', '-600.webp')} 600w, ${IMAGE} 1200w`} sizes="(max-width: 760px) 100vw, 760px" alt={IMAGE_ALT} width="1200" height="900" loading="eager" fetchpriority="high" decoding="async" />
        <figcaption>Xô mỡ VHP Lithium Grease L4 17 kg tại kho HT VINA.</figcaption>
      </figure>

      <div class="summary">
        <p class="summary__label">Tóm tắt khung giá tháng 11/2026 ({vat}){ngay && <span class="summary__ngay"> · rà soát <time datetime={cauHinh.ngay_ra_soat}>{ngay}</time></span>}</p>
        <ul>
          <li><strong>Quy đổi theo khối lượng:</strong> từ <strong>{nghin(tatCa.kgThap)} đ/kg đến {nghin(tatCa.kgCao)} đ/kg</strong>, chênh gần 6 lần tùy nguồn gốc, thương hiệu và quy cách đóng gói.</li>
          <li><strong>Mỡ sản xuất trong nước (PVOIL, VHP, Calix):</strong> phuy 180 kg <strong>{fmtVnd(kTrongNuocPhuy.thap)} – {fmtVnd(kTrongNuocPhuy.cao)} đ</strong> ({nghin(kTrongNuocPhuy.kgThap)} – {nghin(kTrongNuocPhuy.kgCao)} đ/kg); xô 15–17 kg <strong>{fmtVnd(kTrongNuocXo.thap)} – {fmtVnd(kTrongNuocXo.cao)} đ</strong> ({nghin(kTrongNuocXo.kgThap)} – {nghin(kTrongNuocXo.kgCao)} đ/kg).</li>
          <li><strong>Mỡ nhập khẩu (Sinopec, Shell):</strong> phuy 180 kg <strong>{fmtVnd(kNhapPhuy.thap)} – {fmtVnd(kNhapPhuy.cao)} đ</strong> ({nghin(kNhapPhuy.kgThap)} – {nghin(kNhapPhuy.kgCao)} đ/kg); xô 17–18 kg <strong>{fmtVnd(kNhapXo.thap)} – {fmtVnd(kNhapXo.cao)} đ</strong> ({nghin(kNhapXo.kgThap)} – {nghin(kNhapXo.kgCao)} đ/kg).</li>
          {kOng && <li><strong>Mỡ đóng ống:</strong> thùng 30 ống 400 g (12 kg) <strong>{fmtVnd(kOng.thap)} – {fmtVnd(kOng.cao)} đ</strong> ({nghin(kOng.kgThap)} – {nghin(kOng.kgCao)} đ/kg).</li>}
          <li><strong><a href="/chinh-sach-giao-hang">Miễn phí vận chuyển 80 km</a></strong> từ 3 kho tại Hải Phòng và Hưng Yên, không yêu cầu đơn tối thiểu.</li>
        </ul>
      </div>
      <nav class="muc-luc" aria-label="Mục lục">
        <a href="#cach-lap-gia">1. Cách lập giá</a>
        <a href="#bang-gia">2. Bảng giá</a>
        <a href="#chua-gom">3. Chưa gồm</a>
        <a href="#giao-hang">4. Giao hàng</a>
        <a href="#vi-sao-chenh">5. Vì sao chênh</a>
        <a href="#phuy-hay-xo">6. Phuy hay xô</a>
        <a href="#doc-thong-so">7. Đọc thông số</a>
        <a href="#dat-hang">8. Đặt hàng</a>
        <a href="#hoi-dap">9. Hỏi đáp</a>
        <a href="#thong-tin-doanh-nghiep">10. Liên hệ</a>
      </nav>
    </header>

    <section class="price-body" id="cach-lap-gia">
      <h2>1. Cách lập giá và điều kiện áp dụng</h2>
      <div class="minh-bach" data-nosnippet>
        <p><strong>Minh bạch thương mại.</strong> Bảng giá và bài viết này do HT VINA lập với mục đích thương mại: cung cấp thông tin kỹ thuật tham khảo và chào giá trực tiếp từ kho của chính chúng tôi. Nội dung phản ánh mức giá tại kho HT VINA, <strong>không phải bảng khảo sát giá trung lập của một tổ chức độc lập</strong>. Chúng tôi công khai nguồn hàng, chứng từ CO/CQ và cách tính giá để bạn tự đối chiếu trước khi quyết định.</p>
      </div>
      <p>Để phòng vật tư và ban lãnh đạo nhà máy dễ đối chiếu, HT VINA công khai cách lập bảng giá này:</p>
      <ul>
        <li><strong>Nguồn giá:</strong> giá bán tại kho của HT VINA vào ngày rà soát {ngay}, không lấy từ giá niêm yết của hãng hay giá của nơi bán khác. Trang chỉ công bố khoảng giá, không công bố giá từng đơn.</li>
        <li><strong>Đơn vị tính:</strong> mỗi mức giá tính cho <strong>một đơn vị đóng gói</strong> (một phuy, một xô hoặc một thùng ống). <strong>Không có đơn tối thiểu</strong>; quy cách nhỏ nhất là thùng 30 ống 400 g.</li>
        <li><strong>Giá công bố không phải giá hợp đồng:</strong> mỡ bôi trơn làm từ dầu gốc và xà phòng kim loại (lithium, canxi), giá nguyên liệu đổi theo thị trường. Giá chính thức được chốt trên báo giá bằng văn bản có thời hạn do HT VINA gửi vào lúc chốt đơn.</li>
      </ul>
      <p><strong>Khi nào giá gần mức thấp, khi nào gần mức cao của khoảng:</strong></p>
      <div class="table-wrap">
        <table class="match">
          <thead><tr><th scope="col">Giá chốt gần mức thấp khi</th><th scope="col">Giá chốt gần mức cao khi</th></tr></thead>
          <tbody>
            <tr><td>Mua nhiều phuy một lần, hoặc có hợp đồng lấy hàng định kỳ</td><td>Mua lẻ một xô hoặc một thùng</td></tr>
            <tr><td>Nhận hàng tại kho hoặc giao gần kho có hàng</td><td>Giao xa, giao gấp hoặc giao theo khung giờ riêng</td></tr>
            <tr><td>Thanh toán ngay khi nhận hàng</td><td>Thanh toán sau theo thời hạn dài</td></tr>
            <tr><td>Lô đang có sẵn trong kho</td><td>Lô mới nhập sau khi giá dầu gốc hoặc tỷ giá tăng</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="price-body" id="bang-gia">
      <h2>2. Bảng giá mỡ bôi trơn theo độ đặc NLGI</h2>
      <p>Độ đặc NLGI (còn gọi là độ sệt) cho biết mỡ mềm hay cứng, từ 000 (gần như lỏng) tới 6 (rất cứng), xếp theo độ xuyên kim đo bằng phương pháp <a href="https://www.astm.org/Standards/D217.htm" target="_blank" rel="noopener">ASTM D217</a>. Vòng bi và gối đỡ trong nhà xưởng dùng nhiều nhất là mỡ có độ đặc <strong>NLGI 2</strong> và <strong>NLGI 3</strong>. Bảng dưới xếp từ mềm đến cứng; bấm nút lọc để chỉ xem phuy, xô, hàng nhập khẩu hoặc trong nước. Bấm tên mã để xem thông số, bấm "Tải TDS" hoặc "Xem TDS" để mở bảng thông số kỹ thuật của hãng.</p>
      <PriceTable rows={rows} {activePages} category="mo-boi-tron-cong-nghiep" gomVat={cauHinh.gom_vat} tds={tdsTheoTrang} {hrefSp} nhanPhuy="Phuy 180 kg" nhanXo="Xô 15–18 kg" boLoc gon />
      <ul class="notes">
        <li>Cột "Quy đổi" là giá cả gói chia cho khối lượng tịnh ghi trên bao bì, làm tròn tới trăm đồng. Thùng 30 ống 400 g được tính là 12 kg.</li>
        <li>NLGI 2 thường dùng cho vòng bi, moay-ơ, gối đỡ; NLGI 3 cho vòng bi trục đứng, chỗ rung lắc; T3 (loại riêng của Sinopec, giữa NLGI 3 và 4) và NLGI 4 cho vòng bi quay chậm, chỗ cần mỡ ít chảy.</li>
        <li>Mã ghi "NLGI 2, 3" có cùng khoảng giá cho hai độ đặc. Khi hỏi giá, hãy ghi rõ độ đặc cần mua.</li>
        <li>Mã không có trong bảng vẫn có thể nhận đặt: gửi tên mỡ đang dùng, chúng tôi báo giá mã đó hoặc mã có thông số tương đương.</li>
      </ul>
      <div class="ghi-chu-nhiet">
        <p><strong>Về mỡ chịu nhiệt:</strong> chúng tôi chỉ gọi một mã là mỡ chịu nhiệt khi TDS ghi chất làm đặc loại phức hợp (complex), polyurea hoặc bentonite <strong>và</strong> nhiệt độ nhỏ giọt từ 230 °C trở lên. Trong bảng hiện chỉ có <a href="/mo-chiu-nhiet/shell-gadus-s3-v220c-2">Shell Gadus S3 V220C 2</a> đạt (lithium complex, nhỏ giọt 240 °C). Cách chọn theo nhiệt độ vỏ ổ xem ở trang <a href={HUB_NHIET}>mỡ chịu nhiệt</a>.</p>
      </div>
    </section>

    <section class="price-body" id="chua-gom">
      <h2>3. Những khoản chưa gồm trong bảng giá</h2>
      <p>Để bộ phận mua hàng lập dự toán sát hơn, xin lưu ý các khoản dưới đây. Khoản nào phát sinh sẽ được ghi rõ trên báo giá chính thức trước khi bạn xác nhận đơn.</p>
      <div class="table-wrap">
        <table class="match">
          <tbody>
            <tr><th scope="row">Thuế VAT</th><td>Toàn bộ giá trong bài là giá <strong>chưa gồm VAT</strong>. Thuế tính theo thuế suất hiện hành và ghi riêng trên hóa đơn VAT điện tử.</td></tr>
            <tr><th scope="row">Chiết khấu đơn lớn</th><td>Bảng chưa trừ chiết khấu. Đơn nhiều phuy, hợp đồng lấy hàng theo tháng hoặc quý được báo giá riêng theo mã, sản lượng và thời hạn thanh toán.</td></tr>
            <tr><th scope="row">Bốc xếp đặc biệt</th><td>Phuy mỡ nặng khoảng 180 kg cả bì trở lên. Nếu nơi nhận không có xe nâng, lối vào hẹp hoặc cần đưa hàng lên tầng, vui lòng báo trước để chúng tôi bố trí xe và người bốc xếp phù hợp; chi phí, nếu có, ghi trên báo giá.</td></tr>
            <tr><th scope="row">Giao ngoài lịch thường</th><td>Giao gấp, giao ngoài giờ làm việc hoặc theo khung giờ riêng của nhà máy: liên hệ để thống nhất thời gian và chi phí, nếu có.</td></tr>
            <tr><th scope="row">Bảo hiểm hàng hóa</th><td>Chưa gồm. Nếu bạn cần mua bảo hiểm riêng cho đơn hàng, hai bên thỏa thuận trước khi giao.</td></tr>
            <tr><th scope="row">CO/CQ</th><td>Gửi theo lô với các hãng có cấp chứng từ này; TDS và SDS gửi kèm khi bạn yêu cầu.</td></tr>
            <tr><th scope="row">Đổi trả</th><td>Trong <strong>7 ngày tính từ ngày nhận hàng</strong> khi giao sai hàng, hư hỏng do vận chuyển hoặc lỗi chất lượng của nhà sản xuất; hàng còn nguyên nắp và niêm phong. Chi tiết ở <a href="/chinh-sach-doi-tra">chính sách đổi trả</a>.</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="price-body" id="giao-hang">
      <h2>4. Giao nhận và vận chuyển</h2>
      <div class="table-wrap">
        <table class="match">
          <tbody>
            <tr><th scope="row">Giao trong ngày</th><td>Các khu công nghiệp dọc <strong>đường 5 cũ</strong> thuộc địa phận Hà Nội, Hưng Yên và Hải Phòng (ví dụ KCN Đài Tư, Phố Nối A, Nomura, Đình Vũ), nếu đơn được đặt <strong>trước 16h ngày làm việc</strong> và mã có sẵn ở kho.</td></tr>
            <tr><th scope="row">Miễn phí vận chuyển</th><td><strong>80 km</strong> tính từ kho có hàng gần điểm giao nhất, không yêu cầu số lượng tối thiểu. Đơn từ <strong>3 phuy</strong> trở lên: mở rộng tới <strong>150 km</strong>. Đơn lớn ở xa hơn được xem xét miễn phí theo từng trường hợp; phí, nếu có, ghi rõ trên báo giá.</td></tr>
