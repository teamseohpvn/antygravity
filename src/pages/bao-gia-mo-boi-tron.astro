  .price-hero h1 { color: var(--color-primary); font-size: clamp(1.6rem, 4vw, 2.3rem); line-height: 1.25; margin-bottom: 10px; }
  .dong-duyet { margin: -4px 0 12px; font-size: 0.85rem; line-height: 1.5; color: var(--color-text-light); }
  .summary { background: #f1f5f9; border-left: 4px solid var(--color-primary); border-radius: 4px; padding: 14px 18px; margin-bottom: 14px; }
  .summary__label { font-weight: 700; color: var(--color-primary); margin-bottom: 6px; }
  .summary__ngay { font-weight: 400; font-size: 0.85em; color: var(--color-text-light); }
  .summary ul { margin: 0 0 0 20px; }
  .summary li { margin-bottom: 4px; }
  .price-body h2 { color: var(--color-primary); margin-bottom: 16px; }
  .price-body h3 { color: var(--color-primary); margin: 18px 0 6px; font-size: 1.05rem; }
  .price-body p, .price-body li { margin-bottom: 8px; }
  .price-body ul, .price-body ol { margin-left: 20px; }
  .price-body a, .price-hero a { color: var(--color-primary); text-decoration: underline; }
  .notes { font-size: 0.93rem; color: var(--color-text-light); margin-top: 8px; }
  .small { font-size: 0.93rem; color: var(--color-text-light); margin-top: 12px; }
  .table-wrap { overflow-x: auto; }
  .match { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .match th, .match td { border: 1px solid var(--border-color, #e2e8f0); padding: 10px 12px; text-align: left; vertical-align: top; }
  .match th { background: #f1f5f9; font-weight: 600; }
  .match td.num { white-space: nowrap; }
  .price-page section[id] { scroll-margin-top: 90px; }
  .discount { background: #fff7ed; border-color: #fed7aa; }
  .discount__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
  .price-body .discount__actions a { text-decoration: none; }
  .price-body ol.steps { list-style: none; margin: 16px 0 0; padding: 0; counter-reset: b; }
  .steps li { counter-increment: b; position: relative; padding: 0 0 14px 44px; margin: 0; }
  .steps li::before { content: counter(b); position: absolute; left: 0; top: 0; width: 30px; height: 30px; border-radius: 50%; background: var(--color-primary); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem; }
  .steps li p { margin: 2px 0 0; }
  .steps__who { font-size: 0.92rem; color: var(--color-text-light); }
  .reviews { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-bottom: 12px; }
  .reviews blockquote { margin: 0; border: 1px solid var(--border-color, #e2e8f0); border-radius: 6px; padding: 12px 14px; }
  .reviews p { margin-bottom: 4px; }
  .price-body .reviews__stars { color: #b45309; letter-spacing: 1px; margin: 0; }
  .reviews footer { font-size: 0.88rem; color: var(--color-text-light); }
  @media (max-width: 640px) {
    .match { font-size: 0.88rem; }
    .match th, .match td { padding: 8px; }
  }
</style>
