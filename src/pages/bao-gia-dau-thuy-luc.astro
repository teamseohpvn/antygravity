        </table>
      </div>
      <figure class="brent-chart">
        <figcaption class="brent-chart__tieu-de">Giá dầu Brent các phiên gần đây (USD/thùng)</figcaption>
        <svg viewBox={`0 0 ${BD.rong} ${BD.cao}`} role="img" aria-label={`Giá Brent giảm từ ${fmtUsd(diemBrent[0].gia)} USD/thùng ngày ${ngayNgan(diemBrent[0].ngay)} xuống ${fmtUsd(diemBrent.at(-1)!.gia)} USD/thùng ngày ${ngayNgan(diemBrent.at(-1)!.ngay)}.`}>
          <line x1={BD.trai} x2={BD.rong - BD.phai} y1={BD.cao - BD.duoi + 8} y2={BD.cao - BD.duoi + 8} class="brent-chart__truc" />
          <polyline points={duongBrent} class="brent-chart__duong" />
          {diemBrent.map((p, i) => (
            <g>
              <title>{`${fmtNgay(p.ngay)}: ${fmtUsd(p.gia)} USD/thùng (${p.loai === 'chot' ? 'giá chốt' : 'giá CFD tham khảo'})`}</title>
              <circle cx={p.x} cy={p.y} r="14" fill="transparent" />
              <circle cx={p.x} cy={p.y} r="5" class={p.loai === 'chot' ? 'brent-chart__diem' : 'brent-chart__diem brent-chart__diem--mo'} />
              {(i === 0 || i === diemBrent.length - 1) && <text x={p.x} y={p.y - 11} text-anchor="middle" class="brent-chart__gia">{fmtUsd(p.gia)}</text>}
              <text x={p.x} y={BD.cao - 6} text-anchor="middle" class="brent-chart__ngay">{ngayNgan(p.ngay)}</text>
            </g>
          ))}
        </svg>
        <figcaption class="brent-chart__ghi-chu">Chấm đặc là giá chốt phiên, chấm rỗng là giá CFD tham khảo trong ngày. HT VINA vẽ từ các mức giá có nguồn, trục giá không bắt đầu từ 0. <a href={TIN.tradingEconomics} rel="noopener" data-track="click_brent_chart">Xem biểu đồ đầy đủ trên Trading Economics</a>.</figcaption>
      </figure>
      <blockquote class="market-note">
        <p>Giá dầu tháng 11 diễn biến phức tạp và có khả năng tăng cao nếu chiến sự giữa Mỹ và Iran tái bùng phát.</p>
        <footer>Nhận định chủ quan của {displayName(nguoiGia)}, {nguoiGia.role.toLowerCase()}, ngày {fmtNgay(NGAY_NHAN_DINH)}. Đây không phải dự báo chắc chắn.</footer>
      </blockquote>
      </details>
    </section>

    <section class="price-body">
      <h2>Khoảng giá trên được lập thế nào</h2>
      <ul>
        <li>Khoảng giá lập từ giá bán tại kho HT VINA vào ngày rà soát ghi ở đầu trang. Biên độ của khoảng phản ánh số lượng, quy cách và điểm giao.</li>
        <li>{displayName(nguoiGia)} ({nguoiGia.role.toLowerCase()}) rà soát lại toàn bộ bảng mỗi tuần một lần, và cập nhật ngay trong ngày khi một mã bất kỳ đổi giá. Chi tiết ở mục <a href="#cach-viet-bai">cách chúng tôi viết và cập nhật bài</a>.</li>
        <li>Điều kiện giao hàng và thanh toán xem tại <a href="/chinh-sach-giao-hang">chính sách giao hàng</a> và <a href="/chinh-sach-thanh-toan">chính sách thanh toán</a>. Thông tin công ty, kho và đội ngũ ở trang <a href="/about">giới thiệu</a>.</li>
        {PROMO_ACTIVE && <li>Ưu đãi theo số lượng {PROMO.label} xem tại trang <a href={PROMO.path}>khuyến mại dầu thủy lực AW 68</a>.</li>}
      </ul>
    </section>

    <section class="price-body" id="hoi-dap">
      <h2>Câu hỏi thường gặp</h2>
      <h3>Giá trên bảng đã gồm VAT chưa?</h3>
      <p>Giá trên bảng {cauHinh.gom_vat ? 'đã gồm' : 'chưa gồm'} thuế VAT. Báo giá chính thức ghi rõ giá trước thuế, tiền thuế và tổng tiền.</p>
      <h3>Vì sao chỉ ghi khoảng giá, không ghi giá chính xác?</h3>
      <p>Giá thực tế phụ thuộc số lượng, quy cách và điểm giao. Khoảng giá giúp bạn dự trù ngân sách; giá chính xác được gửi trong ngày khi bạn cho biết số lượng.</p>
      <h3>Mua bao nhiêu thì được giá tốt?</h3>
      <p>Mua theo phuy tiết kiệm hơn mua xô. Đơn từ vài phuy trở lên hoặc hợp đồng định kỳ được báo giá riêng. Đừng mua vượt nhu cầu chỉ để được giá: cách tính lượng cần mua có ở mục <a href="#dat-bao-nhieu">nên đặt bao nhiêu dầu</a>. Doanh nghiệp cần mức riêng xem mục <a href="#chiet-khau">chiết khấu doanh nghiệp</a>.</p>
      <h3>Đơn nào được miễn phí vận chuyển?</h3>
      <p>Đơn giao trong bán kính 80 km tính từ kho có hàng gần điểm giao nhất được miễn phí vận chuyển, không yêu cầu đơn tối thiểu. Đơn từ 3 phuy trở lên được miễn phí tới 150 km. Xa hơn hoặc đơn số lượng lớn, vui lòng liên hệ trực tiếp để yêu cầu vận chuyển miễn phí theo từng trường hợp.</p>
      <h3>Có được thanh toán sau không?</h3>
      <p>Doanh nghiệp mua định kỳ được thỏa thuận thời hạn thanh toán và hạn mức công nợ trong hợp đồng hoặc đơn đặt hàng. Xem <a href="/chinh-sach-thanh-toan">chính sách thanh toán</a>.</p>
      <h3>Có giữ giá cho đơn đặt trước không?</h3>
      <p>Có. HT VINA nhận đặt cọc để chốt giá đầu tháng, sau đó bạn lấy hàng chia đợt với giá đã chốt. Mức cọc và thời hạn thỏa thuận theo số lượng, xem mục <a href="#giu-gia">cách giữ giá</a>.</p>
      <h3>Dầu thủy lực để trong kho được bao lâu?</h3>
      <p>Phuy còn nguyên niêm, để trong nhà khô ráo thường dùng tốt khoảng 5 năm theo khuyến cáo của ExxonMobil. Hạn trên nhãn phuy là con số chính thức. Phuy đã mở nên dùng hết sớm và luôn đậy kín.</p>
      <h3>Máy đang dùng dầu 46, có dùng dầu 68 cho rẻ được không?</h3>
      <p>Không nên. Cấp độ nhớt theo yêu cầu của máy và nhiệt độ làm việc, không theo giá. Các mã có cấp 46 có <a href="#bang-gia-46">bảng giá riêng</a>, dầu 32 vẫn nhận đặt; xem <a href="/ho-tro-ky-thuat/dau-thuy-luc-32-46-68-khac-nhau">hướng dẫn chọn độ nhớt</a> để biết khi nào được đổi cấp.</p>
      <h3>Bảng giá cập nhật khi nào?</h3>
      <p>Bảng được rà soát toàn bộ mỗi tuần một lần. Ngoài kỳ rà soát, chỉ cần một mã bất kỳ đổi giá là chúng tôi cập nhật ngay trong ngày. Ngày rà soát gần nhất ghi ở đầu trang.</p>
    </section>

    <CachVietBai tacGia={nguoiGia} nguoiDuyet={nguoiDuyet} ngayGia={cauHinh.ngay_ra_soat || undefined} ngayCapNhat={ngayCapNhat} />
    <ChinhSachGiaKho />
    <ThongTinDoanhNghiep />
    </NoiDungBai>
  </div>
</Layout>

<script>
  // Khối thông tin đầu trang trên điện thoại: bấm để mở hoặc thu gọn.
  const nutInfo = document.getElementById('info-them');
  nutInfo?.addEventListener('click', () => {
    const thuGon = nutInfo.parentElement!.classList.toggle('is-thu-gon');
    nutInfo.setAttribute('aria-expanded', String(!thuGon));
    nutInfo.textContent = thuGon ? '… Xem thêm' : 'Thu gọn';
  });
</script>

<script>
  import { tinhLuongDau, moTaMua } from '../lib/tinh-luong-dau';

  const form = document.getElementById('tinh-dau') as HTMLFormElement | null;
  if (form) {
    const el = (id: string) => document.getElementById(id) as HTMLElement;
    const so = (ten: string) => Number((form.elements.namedItem(ten) as HTMLInputElement).value);
    const fmt = (n: number) => n.toLocaleString('vi-VN', { maximumFractionDigits: 1 });
    let daGhiNhan = false;
    const capNhat = () => {
      const k = tinhLuongDau({
        soMay: so('soMay'),
        litBon: so('litBon'),
        litNgoaiBon: so('litNgoaiBon'),
        chamBuThang: so('chamBuThang'),
        soThang: so('soThang'),
        sucRua: (form.elements.namedItem('sucRua') as HTMLInputElement).checked,
      });
      const mua = moTaMua(k);
      const gui = el('tinh-gui') as HTMLAnchorElement;
      el('tinh-tong').textContent = `${fmt(k.tong)} L`;
      el('tinh-mua').textContent = mua || 'Hãy nhập số liệu của máy';
      el('tinh-du').textContent = k.du > 0
        ? `Dư ${fmt(k.du)} L${k.thangDu ? `, đủ thêm dầu khoảng ${fmt(k.thangDu)} tháng` : ''}.`
        : '';
      gui.hidden = !mua;
      gui.href = `/bao-gia?sp=${encodeURIComponent(`Dầu thủy lực 68: ${mua} (tính trên trang báo giá, tổng ${fmt(k.tong)} L)`)}`;
    };
    form.addEventListener('input', () => {
      capNhat();
      // Chỉ đếm lượt dùng, không gửi số liệu khách nhập.
      const gtag = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
      if (!daGhiNhan && typeof gtag === 'function') {
        gtag('event', 'use_oil_calculator', { page_path: location.pathname });
        daGhiNhan = true;
      }
    });
  }
</script>

