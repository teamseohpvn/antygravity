---
// Báo giá dầu thủy lực 68. Giá đọc từ src/data/gia-cong-khai.json (sinh bởi scripts/build-gia-json.py), xem src/lib/gia-json.ts.
// URL cũ /bang-gia-dau-thuy-luc và /bao-gia-dau-thuy-luc-68 chuyển 301 về đây (public/_redirects, 10/10/2026).
import { KHO_NGAN, TON_KHO, TON_KHO_CAP_NHAT } from '../data/ton-kho-dau-thuy-luc';
import Layout from '../layouts/Layout.astro';
import NoiDungBai from '../components/NoiDungBai.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteCta from '../components/QuoteCta.astro';
import CachVietBai from '../components/CachVietBai.astro';
import ChinhSachGiaKho from '../components/ChinhSachGiaKho.astro';
import ThongTinDoanhNghiep from '../components/ThongTinDoanhNghiep.astro';
import PriceTable from '../components/PriceTable.astro';
import { getActiveProducts } from '../lib/content';
import { fmtNgay, fmtVnd } from '../lib/gia-tinh';
import type { DongGiaCongKhai, CauHinh } from '../lib/gia';
import { bangGiaTuJson } from '../lib/gia-json';
import { timNhanSu, bylineLabel, personUrl, personRef, personSchema, displayName, credentialLine } from '../lib/nhan-su';
import { traTieuChuan } from '../lib/tieu-chuan';
import { tinhLuongDau, moTaMua, LIT_PHUY, LIT_XO } from '../lib/tinh-luong-dau';
import { PROMO, PROMO_ACTIVE } from '../lib/promo';
import { HIEU_LUC, CHUYEN_GIAO, DANH_GIA_GOOGLE } from '../data/bao-gia-dau-thuy-luc';
import { absUrl, LEGAL_SHORT, breadcrumbSchema, ORG_ID, BUSINESS, AREA_TEXT, KCN_NEAR, ADDRESS_TEXT, KHO_GIAO_HANG } from '../lib/site';

export const prerender = false;

const CATEGORY = 'dau-thuy-luc';
const pagePath = '/bao-gia-dau-thuy-luc';
const IMAGE = '/images/blog/kho-ht-vina-thanh-binh-1.webp';
const IMAGE_ALT = 'Lối đi trong kho HT VINA với xe nâng tay, hai bên là phuy và xô dầu các hãng';

// 01/11/2026 (quyết định của người dùng): báo giá là tài liệu kinh tế và trách nhiệm kinh doanh.
// Chị Hồng (quản lý bán hàng) là người viết và rà soát giá.
const nguoiGia = timNhanSu('nguyen-thi-hong')!;
// Giám đốc Vũ Minh Toàn là người chịu trách nhiệm duyệt.
// Anh Hữu phụ trách kho vận trong quy trình giao hàng.
const nguoiDuyet = timNhanSu('vu-minh-toan')!;
const nguoiKho = timNhanSu('pham-van-huu')!;

let all: DongGiaCongKhai[] = [];
let cauHinh: CauHinh = { he_so_tren: 1.15, gom_vat: false, ngay_ra_soat: '', nhan_dinh: '' };
let loiDb = false;
try {
  // 10/10/2026: giá lấy từ src/data/gia-cong-khai.json (scripts/build-gia-json.py), chưa dùng D1.
  // Khi app quản lý giá trên D1 xong, đổi lại thành: ({ rows: all, cauHinh } = await bangGiaCongKhai(CATEGORY));
  ({ rows: all, cauHinh } = bangGiaTuJson(CATEGORY));
} catch (e) {
  // Không để trang lỗi 500 khi dữ liệu giá có sự cố: vẫn hiện nội dung và nút báo giá.
  console.error('bao-gia-dau-thuy-luc: không đọc được dữ liệu giá', e);
  loiDb = true;
}

const sanPham = (await getActiveProducts()).filter((p) => p.data.category === CATEGORY);
const activePages = new Set(sanPham.map((p) => p.id));
// Mã đang có sẵn tại kho (trang ghi "N mã có sẵn tại kho"). Mã đặt hàng chỉ hiện giá trên trang sản phẩm của nó.
const coSan = new Set(sanPham.filter((p) => p.data.stock_status === 'co-san').map((p) => p.id));
const tdsTheoTrang = Object.fromEntries(sanPham.map((p) => [p.id, p.data.tds_url]));
const khoCuaDong = (r: DongGiaCongKhai) => (TON_KHO[`${r.trang}|${r.quy_cach}`] ?? []).map((k) => KHO_NGAN[k]);

// Trang chỉ nói về cấp ISO VG 68; mã 32 nhận đặt theo yêu cầu (xem FAQ). Cấp 46 ghi kèm ở các dòng phuy dưới đây.
const rows = all.filter((r) => /VG\s*68\b/i.test(r.cap ?? '') && (!r.trang || coSan.has(r.trang)));
// 12/11/2026 (yêu cầu của người dùng): cấp 46 tách thành bảng riêng, khoảng giá như cấp 68 của cùng mã.
// Mã nào đã có dòng giá VG 46 riêng trong dữ liệu giá (ví dụ ENEOS Super Mulpus DX 46) thì dùng dòng đó.
const MA_CO_46 = ['Castrol Hyspin AWS 68', 'X-One AW 68', 'ENEOS Super Hyrando 68', 'ENEOS Super Mulpus DX 68', 'EMI AW 68', 'VHP Spinax AW 68'];
const ten46 = (ten: string) => ten.replace(/68$/, '46');
const rowsBang = rows;
const rows46: DongGiaCongKhai[] = rows
  .filter((r) => MA_CO_46.includes(r.ten) && /phuy/i.test(r.quy_cach))
  .map((r) => all.find((x) => x.ten === ten46(r.ten) && /VG\s*46\b/i.test(x.cap ?? '') && x.quy_cach === r.quy_cach)
    ?? { ...r, ten: ten46(r.ten), cap: 'ISO VG 46' });
const phuy46 = rows46.filter((r) => r.thap && r.cao);
const coGia = !loiDb && rows.some((r) => r.thap);

// Tháng trên tiêu đề theo kỳ hiệu lực; ngày rà soát vẫn hiện riêng ở đầu trang.
const thang = fmtNgay(HIEU_LUC?.tu ?? cauHinh.ngay_ra_soat, 'thang');
const ngay = fmtNgay(cauHinh.ngay_ra_soat);

// Số tóm tắt tính từ chính bảng giá, không gõ tay.
const coSo = rows.filter((r) => r.thap && r.cao);
const phuy = coSo.filter((r) => /phuy/i.test(r.quy_cach));
const minOf = (xs: (number | null)[]) => Math.min(...(xs.filter(Boolean) as number[]));
const maxOf = (xs: (number | null)[]) => Math.max(...(xs.filter(Boolean) as number[]));
const phuyThap = phuy.length ? minOf(phuy.map((r) => r.thap)) : null;
const phuyCao = phuy.length ? maxOf(phuy.map((r) => r.cao)) : null;
const litThap = coSo.some((r) => r.thap_don_vi) ? minOf(coSo.map((r) => r.thap_don_vi)) : null;
const litCao = coSo.some((r) => r.cao_don_vi) ? maxOf(coSo.map((r) => r.cao_don_vi)) : null;
const soMa = new Set(coSo.map((r) => r.ten)).size;
// Hãng quốc tế (ENEOS, Castrol) lên trước: đó là tên khách hay tìm.
const hangs = [...new Set([...coSo].sort((a, b) => Number(a.nguon !== 'nhap-khau') - Number(b.nguon !== 'nhap-khau')).map((r) => r.hang))];
const vat = cauHinh.gom_vat ? 'đã gồm VAT' : 'chưa VAT';

const iso11158 = traTieuChuan('ISO 11158');

// Nguồn tin cho mục nhận định, đã đọc ngày 01/11/2026. Tin thay đổi nhanh: cập nhật cùng NGAY_NHAN_DINH.
const NGAY_NHAN_DINH = '2026-11-01';
const TIN = {
  reuters: 'https://finance.yahoo.com/news/oil-rises-supply-concerns-houthis-022725347.html',
  vietnamPlus: 'https://www.vietnamplus.vn/gia-dau-the-gioi-len-muc-cao-nhat-6-thang-do-lo-ngai-tinh-hinh-my-iran-post1145330.vnp',
  lubes: 'https://www.lubesngreases.com/bor-asia/weekly-asia-base-oil-price-report-125/',
  tyGia: 'https://vov.vn/thi-truong/ty-gia-usd-hom-nay-3110-ty-gia-trung-tam-o-muc-25637-dongusd-post1346036.vov',
  // Tin cập nhật 04/11/2026: giữ tin cũ, thêm khối mới theo ngày.
  reuters0211: 'https://www.reuters.com/business/energy/oil-slips-more-than-1-talks-continue-ending-iran-war-2026-11-01/',
  reuters0311: 'https://www.reuters.com/markets/commodities/oil-rises-after-report-us-strike-irans-qeshm-island-2026-11-03/',
  cnbc0211: 'https://www.cnbc.com/2026/11/02/oil-prices-fall-as-iran-us-pursue-diplomacy.html',
  cnbc0311: 'https://www.cnbc.com/2026/11/03/oil-prices-climb-after-us-reportedly-strikes-irans-qeshm-island.html',
  tradingEconomics: 'https://tradingeconomics.com/commodity/brent-crude-oil',
  financeFeeds: 'https://financefeeds.com/brent-crude-oil-price-106-tuesday-after-7-6-percent-plunge-qeshm-strike-report-midterms-bull-113-bear-100/',
  // Tin cập nhật 12/11/2026 (đọc lúc 09:00–09:30 giờ Việt Nam).
  cnbc0611: 'https://www.cnbc.com/2026/11/06/oil-price-today-brent-wti.html',
  reuters1111: 'https://www.reuters.com/business/energy/oil-rises-two-month-low-hormuz-shipping-attacks-offset-iran-truce-hopes-2026-11-11/',
  reuters1211: 'https://www.reuters.com/business/energy/oil-prices-drop-more-than-1-hopes-iran-ukraine-peace-talks-pressure-markets-2026-11-12/',
  lubes0211: 'https://www.lubesngreases.com/bor-asia/weekly-asia-base-oil-price-report-127/',
  lubes0911: 'https://www.lubesngreases.com/bor-asia/weekly-asia-base-oil-price-report-128/',
};

// Giá dầu gốc châu Á (FOB Asia, USD/tấn) theo báo cáo tuần của Lubes'N'Greases. Chỉ ghi số có trong báo cáo.
const DAU_GOC = [
  { loai: 'Nhóm I SN150', tuanTruoc: '1.310–1.350', tuanNay: '1.320–1.360', xuHuong: 'Tăng 10' },
  { loai: 'Nhóm I SN500', tuanTruoc: '1.340–1.380', tuanNay: '1.350–1.390', xuHuong: 'Tăng 10' },
  { loai: 'Nhóm II 150N', tuanTruoc: '1.520–1.560', tuanNay: '1.500–1.540', xuHuong: 'Giảm 20' },
  { loai: 'Nhóm II 500N', tuanTruoc: '1.560–1.600', tuanNay: '1.560–1.600', xuHuong: 'Đi ngang' },
  { loai: 'Nhóm III 4 cSt', tuanTruoc: '3.670–3.710', tuanNay: '3.680–3.720', xuHuong: 'Tăng 10' },
];

// Mỗi đợt tin có ngày riêng, mới nhất đứng đầu. capNhatLuc là lúc sửa thật, hiện trên trang và đưa vào schema, sitemap.
// Khi thêm tin: thêm một dòng ở đây, thêm khối tin trong mục #nhan-dinh, thêm phiên vào BRENT_PHIEN nếu có giá mới.
const CAP_NHAT_TIN = [
  {
    id: 'tin-2026-11-12',
    capNhatLuc: '2026-11-12T09:30:00+07:00',
    tieuDe: 'Cập nhật ngày 12/11/2026: Brent quanh 91–93 USD, giảm khoảng 21% từ đầu tháng; dầu gốc nhóm I vẫn tăng nhẹ',
    moTa: 'Brent chốt 92,76 USD/thùng phiên 11/11 sau khi chạm đáy 2 tháng phiên 10/11, sáng 12/11 giao dịch quanh 91,62 USD/thùng (Reuters). Từ đầu tháng Brent giảm khoảng 21%. Báo cáo dầu gốc châu Á ngày 9/11: nhóm I tăng khoảng 10 USD/tấn, nhóm II đi ngang hoặc giảm nhẹ, nhóm III vẫn chịu áp lực tăng (Lubes\'N\'Greases).',
    nguon: [TIN.cnbc0611, TIN.reuters1111, TIN.reuters1211, TIN.lubes0211, TIN.lubes0911],
  },
];
const TIN_MOI = CAP_NHAT_TIN[0];

// Biểu đồ tự vẽ, chỉ dùng mức giá có nguồn. loai 'chot' là giá chốt phiên, 'tham-khao' là giá CFD trong ngày.
const BRENT_PHIEN = [
  { ngay: '2026-10-30', gia: 113.43, loai: 'chot', nguon: 'Reuters', url: TIN.reuters },
  { ngay: '2026-11-02', gia: 104.77, loai: 'chot', nguon: 'Reuters', url: TIN.reuters0211 },
  { ngay: '2026-11-03', gia: 103.6, loai: 'chot', nguon: 'Reuters', url: TIN.reuters0311 },
  { ngay: '2026-11-04', gia: 102.61, loai: 'tham-khao', nguon: 'Trading Economics', url: TIN.tradingEconomics },
  { ngay: '2026-11-06', gia: 98.32, loai: 'chot', nguon: 'CNBC', url: TIN.cnbc0611 },
  // 10/11: Reuters ngày 11/11 ghi Brent chốt 92,76 USD, tăng 1,27 USD so với phiên trước, nên phiên 10/11 chốt 91,49 USD.
  { ngay: '2026-11-10', gia: 91.49, loai: 'chot', nguon: 'Reuters', url: TIN.reuters1111 },
  { ngay: '2026-11-11', gia: 92.76, loai: 'chot', nguon: 'Reuters', url: TIN.reuters1111 },
  { ngay: '2026-11-12', gia: 91.62, loai: 'tham-khao', nguon: 'Reuters', url: TIN.reuters1211 },
];
const fmtUsd = (n: number) => n.toFixed(2).replace('.', ',');
const ngayNgan = (iso: string) => fmtNgay(iso).slice(0, 5);
const BD = { rong: 300, cao: 150, trai: 26, phai: 30, tren: 24, duoi: 28 };
const giaMin = Math.min(...BRENT_PHIEN.map((p) => p.gia));
const giaMax = Math.max(...BRENT_PHIEN.map((p) => p.gia));
const diemBrent = BRENT_PHIEN.map((p, i) => ({
  ...p,
  x: BD.trai + (i * (BD.rong - BD.trai - BD.phai)) / Math.max(BRENT_PHIEN.length - 1, 1),
  y: BD.tren + ((giaMax - p.gia) * (BD.cao - BD.tren - BD.duoi)) / Math.max(giaMax - giaMin, 1),
}));
const duongBrent = diemBrent.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');

// Ngày đăng: trang lên web lần đầu 06/10/2026 (URL cũ /bang-gia-dau-thuy-luc, ngày commit đầu trong git). Không đổi.
// Ngày cập nhật: ngày sửa NỘI DUNG gần nhất (không phải ngày rà giá). Sửa đoạn văn, bảng, FAQ thì đổi ngày này.
const NGAY_DANG = '2026-10-06';
const NGAY_SUA_NOI_DUNG = '2026-11-13';
const ngaySua = [NGAY_SUA_NOI_DUNG, cauHinh.ngay_ra_soat].filter(Boolean).sort().at(-1)!;
const tacGia = nguoiGia;
// Ngày cập nhật cuối gồm cả đợt tin. Schema và thẻ meta dùng giờ thật của đợt tin nếu đó là thay đổi mới nhất, không gán giờ giả cho thay đổi khác.
const ngayCapNhat = [ngaySua, TIN_MOI.capNhatLuc.slice(0, 10)].sort().at(-1)!;
const lucSua = TIN_MOI.capNhatLuc.startsWith(ngayCapNhat) ? TIN_MOI.capNhatLuc : ngayCapNhat;
const ARTICLE_ID = absUrl(pagePath) + '#article';

// Hiệu lực tính theo giờ Việt Nam lúc khách xem trang.
const homNay = new Date(Date.now() + 7 * 3600 * 1000).toISOString().slice(0, 10);
const hetHieuLuc = HIEU_LUC ? homNay > HIEU_LUC.den : false;
const QUOTE_DN = `/bao-gia?sp=${encodeURIComponent('Dầu thủy lực 68 (đề nghị chiết khấu doanh nghiệp)')}`;
const QUOTE_THUONG = '/bao-gia?sp=D%E1%BA%A7u%20th%E1%BB%A7y%20l%E1%BB%B1c%2068';

// Giá trị mặc định của công cụ tính trùng ví dụ minh họa trong mục "Nên đặt bao nhiêu dầu".
const TINH_MAC_DINH = { soMay: 1, litBon: 200, litNgoaiBon: 40, chamBuThang: 36, soThang: 1, sucRua: false };
const kqMacDinh = tinhLuongDau(TINH_MAC_DINH);
const fmtLit = (n: number) => n.toLocaleString('vi-VN', { maximumFractionDigits: 1 });
const yeuCauTinh = (mua: string, tong: number) => `/bao-gia?sp=${encodeURIComponent(`Dầu thủy lực 68: ${mua} (tính trên trang báo giá, tổng ${fmtLit(tong)} L)`)}`;

// Ảnh kho do người dùng cung cấp, chụp cập nhật ngày 01/11/2026.
const ANH_KHO = [
  { src: '/images/blog/kho-ht-vina-thanh-binh-1.webp', alt: 'Lối đi trong kho với xe nâng tay, hai bên là phuy và xô dầu các hãng, kệ hàng ở cuối kho' },
  { src: '/images/blog/kho-ht-vina-thanh-binh-2.webp', alt: 'Phuy dầu ENEOS màu đỏ và phuy dầu Castrol màu xanh xếp trong kho, phía sau là kệ hàng' },
  { src: '/images/blog/kho-ht-vina-thanh-binh-3.webp', alt: 'Các xô dầu ENEOS màu xanh dương xếp chồng trong kho' },
];

const quyTrinh = [
  { buoc: 'Đặt hàng', viec: 'Gửi mã dầu đang dùng (hoặc loại máy), quy cách, số lượng và nơi giao qua điện thoại, Zalo hay form. Mã hết hàng hoặc giá cao thì được đề xuất mã cùng cấp ISO VG và tiêu chuẩn.', nguoi: nguoiGia },
  { buoc: 'Chốt giá', viec: 'Nhận báo giá ghi rõ giá trước thuế, tiền thuế, phí giao và thời hạn hiệu lực. Đơn được xác nhận khi bạn đồng ý qua tin nhắn, email hoặc đơn đặt hàng (PO).', nguoi: nguoiGia },
  { buoc: 'Lập hóa đơn', viec: 'Cung cấp tên công ty, mã số thuế, địa chỉ và email nhận hóa đơn. Hóa đơn VAT điện tử được gửi qua email.', nguoi: nguoiGia },
  { buoc: 'Giao kho', viec: 'Xuất hàng tại kho theo đơn đã xác nhận, kèm phiếu giao hàng và chứng từ của lô.', nguoi: nguoiKho },
  { buoc: 'Vận chuyển', viec: 'Xe chở hàng tới điểm giao. Nơi nhận không có xe nâng hoặc lối vào hạn chế thì báo trước để bố trí xe và người bốc xếp.', nguoi: nguoiKho },
  { buoc: 'Giao hàng', viec: 'Cùng kiểm tra tên hàng, số lượng, nắp và niêm phong. Có sai lệch thì ghi ngay trên phiếu giao hàng và báo trong ngày.', nguoi: nguoiKho },
  { buoc: 'Thanh toán', viec: 'Chuyển khoản vào tài khoản đứng tên công ty, hoặc trả tiền mặt với đơn lẻ tại TP Hải Phòng. Thanh toán sau áp dụng theo thời hạn và hạn mức ghi trong hợp đồng.', nguoi: nguoiGia },
];

// 12/11/2026 (người dùng chốt): tiêu đề nhắm "báo giá dầu thủy lực" + giá sỉ, H1 nhắm "giá dầu thủy lực 46, 68".
const thangText = thang ? ` Tháng ${thang}` : '';
const title = `Báo Giá Dầu Thủy Lực 46, 68${thangText}`;
const seoTitle = `Báo Giá Dầu Thủy Lực${thangText} – Giá Sỉ Phuy 200L, Xô 18L`;
// Giữ cụm miễn phí vận chuyển trong mô tả và ở dòng 2 tóm tắt để lọt vào đoạn Google hiển thị.
const BA_KHO = 'Hải Dương cũ, Kiến An, Như Quỳnh (Hưng Yên)';
// Làm tròn 1 chữ số thập phân: 5.410.000 -> 5.4; 10.590.000 -> 10.6.
const trieu = (n: number) => (n / 1_000_000).toFixed(1);
// Mô tả meta (người dùng chốt 12/11/2026): không lặp "báo giá dầu thủy lực" (tiêu đề, H1 đã có), chỉ ghi khoảng giá phuy, xô,
// vận chuyển, chứng từ và 3 kho. Số tự tính từ bảng giá dầu 68 (hàng có sẵn).
const xo = coSo.filter((r) => /xô/i.test(r.quy_cach));
const xoThap = xo.length ? minOf(xo.map((r) => r.thap)) : null;
const xoCao = xo.length ? maxOf(xo.map((r) => r.cao)) : null;
const tien = (n: number) => n >= 1_000_000 ? `${(Math.round(n / 100_000) / 10).toString().replace('.', ',')} triệu` : `${Math.round(n / 1000)} nghìn`;
const khoang = (a: number, b: number) => a >= 1_000_000 && b >= 1_000_000 ? `${tien(a).replace(' triệu', '')} – ${tien(b)}` : `${tien(a)} – ${tien(b)}`;
const description = coGia && phuyThap && phuyCao
  ? `Phuy 200L từ ${khoang(phuyThap, phuyCao)}${xoThap && xoCao ? `, xô 18L từ ${khoang(xoThap, xoCao)}` : ''} (${vat}). Miễn phí vận chuyển 80 km, đủ CO/CQ, VAT. Có sẵn tại 3 kho Kiến An, Hải Dương, Như Quỳnh. Giao trong ngày KCN gần kho, chiết khấu theo số phuy.`
  : `Phuy 200L, xô 18L dầu thủy lực 68, 46. Miễn phí vận chuyển 80 km, đủ CO/CQ, VAT. Có sẵn tại 3 kho Kiến An, Hải Dương, Như Quỳnh. Giao trong ngày KCN gần kho.`;

const crumbs = [
  { name: 'Trang chủ', href: '/' },
  { name: 'Dầu thủy lực', href: `/${CATEGORY}` },
  { name: 'Báo giá dầu thủy lực', href: pagePath },
];

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: absUrl(pagePath),
    inLanguage: 'vi-VN',
    datePublished: NGAY_DANG,
    dateModified: lucSua,
    ...(cauHinh.ngay_ra_soat ? { lastReviewed: cauHinh.ngay_ra_soat } : {}),
    author: personRef(tacGia),
    reviewedBy: personRef(nguoiDuyet),
    about: { '@type': 'Thing', name: 'Dầu thủy lực ISO VG 68' },
    primaryImageOfPage: { '@type': 'ImageObject', url: absUrl(IMAGE), caption: IMAGE_ALT },
    isPartOf: { '@id': absUrl('/') + '#website' },
    publisher: { '@id': ORG_ID },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': ARTICLE_ID,
    headline: title,
    description,
    url: absUrl(pagePath),
    mainEntityOfPage: absUrl(pagePath),
    image: absUrl(IMAGE),
    inLanguage: 'vi-VN',
    author: personRef(tacGia),
    reviewedBy: personRef(nguoiDuyet),
    citation: [
      // Chỉ các nguồn còn dẫn trên trang (12/11/2026: phần kỹ thuật chuyển sang /dau-thuy-luc, tin cũ đã bỏ).
      'https://www.yanmar.com/jp/construction/service_support/oil/cycle.html',
      'https://plc.petrolimex.com.vn/nd/tt-co-dong/bao-cao-thuong-nien-2025.html',
      ...new Set([...TIN_MOI.nguon, ...BRENT_PHIEN.map((p) => p.url), TIN.tradingEconomics]),
    ],
    datePublished: NGAY_DANG,
    dateModified: lucSua,
    publisher: { '@id': ORG_ID },
    hasPart: CAP_NHAT_TIN.map((t) => ({ '@id': `${absUrl(pagePath)}#${t.id}` })),
  },
  ...CAP_NHAT_TIN.map((t) => ({
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    '@id': `${absUrl(pagePath)}#${t.id}`,
    headline: t.tieuDe,
    description: t.moTa,
    url: `${absUrl(pagePath)}#${t.id}`,
    mainEntityOfPage: absUrl(pagePath),
    image: absUrl(IMAGE),
    inLanguage: 'vi-VN',
    datePublished: t.capNhatLuc,
    dateModified: t.capNhatLuc,
    author: personRef(tacGia),
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': ARTICLE_ID },
    citation: t.nguon,
  })),
  personSchema(tacGia),
  personSchema(nguoiDuyet),
  breadcrumbSchema(crumbs),
  ...(CHUYEN_GIAO?.video
    ? [{
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: CHUYEN_GIAO.tieuDe,
        description: CHUYEN_GIAO.video.moTa,
        thumbnailUrl: `https://i.ytimg.com/vi/${CHUYEN_GIAO.video.youtubeId}/maxresdefault.jpg`,
        uploadDate: CHUYEN_GIAO.video.ngayDang,
        duration: CHUYEN_GIAO.video.thoiLuong,
        embedUrl: `https://www.youtube.com/embed/${CHUYEN_GIAO.video.youtubeId}`,
      }]
    : []),
];
---

<Layout {title} {seoTitle} {description} type="article" image={IMAGE} published={NGAY_DANG} modified={lucSua} author={tacGia.name} {schemaData}>
  <div class="container price-page">
    <Breadcrumbs items={crumbs} />

    <NoiDungBai articleId={ARTICLE_ID}>
    <header class="price-hero">
      <h1>{title}</h1>
      <p class="sapo">Bảng giá sỉ dầu thủy lực chống mài mòn (ISO VG 68, 46) quy cách Phuy 200L và Xô 18L phân phối trực tiếp cho nhà máy, xưởng ép nhựa, đội xe cơ giới và công trình tại Hải Phòng, Hải Dương, Hưng Yên.</p>
      <div class="doc-wrap">
      {/* Thu gọn còn dòng tóm tắt, vẫn giữ tên người viết, người duyệt và ngày. Toàn bộ khối luôn nằm trong HTML. */}
      <script is:inline>document.currentScript.parentElement.classList.add('co-thu-gon', 'is-thu-gon');</script>
      <p class="doc-tomtat">
        <span class="doc-tomtat__dong">Người viết: <a href={personUrl(nguoiGia)}>{bylineLabel(nguoiGia)}</a> ({nguoiGia.role.toLowerCase()})</span>
        <span>Duyệt bởi: <a href={personUrl(nguoiDuyet)}>{bylineLabel(nguoiDuyet)}</a> (GĐ HT VINA) · Cập nhật: {fmtNgay(ngayCapNhat)}{HIEU_LUC && (hetHieuLuc ? <> · Kỳ giá đã kết thúc</> : <> · Hiệu lực: Tháng {fmtNgay(HIEU_LUC.tu, 'thang')}</>)}</span>
      </p>
      <dl class="doc-info" id="doc-info">
        <div><dt>Người viết</dt><dd><a href={personUrl(nguoiGia)} rel="author">{bylineLabel(nguoiGia)}</a>, {nguoiGia.role.toLowerCase()}</dd></div>
        <div><dt>Chịu trách nhiệm duyệt</dt><dd><a href={personUrl(nguoiDuyet)}>{bylineLabel(nguoiDuyet)}</a>, {nguoiDuyet.role.toLowerCase()} HT VINA</dd></div>
        {HIEU_LUC && (
          <div>
            <dt>Hiệu lực</dt>
            <dd>
              {hetHieuLuc
                ? <>Kỳ giá đã kết thúc ngày <time datetime={HIEU_LUC.den}>{fmtNgay(HIEU_LUC.den)}</time>, bảng đang được rà lại. Gọi để nhận giá hiện hành.</>
                : <>Từ <time datetime={HIEU_LUC.tu}>{fmtNgay(HIEU_LUC.tu)}</time> đến hết <time datetime={HIEU_LUC.den}>{fmtNgay(HIEU_LUC.den)}</time></>}
            </dd>
          </div>
        )}
        {coGia && ngay && <div><dt>Giá rà soát</dt><dd><time datetime={cauHinh.ngay_ra_soat}>{ngay}</time></dd></div>}
        <div><dt>Đăng / Cập nhật</dt><dd><time datetime={NGAY_DANG}>{fmtNgay(NGAY_DANG)}</time> / <time datetime={ngayCapNhat}>{fmtNgay(ngayCapNhat)}</time></dd></div>
        <div><dt>Đơn vị phát hành</dt><dd>{LEGAL_SHORT}, kho tại {AREA_TEXT}</dd></div>
        <div><dt>Quy trình</dt><dd><a href="#cach-viet-bai">Cách chúng tôi viết và cập nhật bài</a> · <a href="#chinh-sach-gia-kho">Chính sách kiểm chứng giá và tồn kho</a></dd></div>
      </dl>
      <button type="button" class="info-them" id="info-them" aria-controls="doc-info" aria-expanded="false" data-track="read_more_doc_info">… Xem thêm</button>
      </div>


      {coGia && (
        <div class="summary">
          <p class="summary__label">Tóm tắt giá{thang ? ` tháng ${thang}` : ''}</p>
          <ul>
            {phuyThap && <li>Phuy dầu thủy lực 68: <strong>{fmtVnd(phuyThap)} – {fmtVnd(phuyCao)} đ</strong> ({vat}), tùy mã.</li>}
            {phuy46.length > 0 && <li>Phuy dầu thủy lực 46: <strong>{fmtVnd(minOf(phuy46.map((r) => r.thap)))} – {fmtVnd(maxOf(phuy46.map((r) => r.cao)))} đ</strong> ({vat}), tùy mã. Xem <a href="#bang-gia-46">bảng giá dầu 46</a>.</li>}
            <li><strong><a href="/chinh-sach-giao-hang">Miễn phí vận chuyển 80 km</a></strong> từ 3 kho {BA_KHO}.</li>
            <li>Giao trong ngày các KCN gần kho khi chốt đơn trước {PROMO.sameDayCutoff}, thứ Hai đến thứ Sáu. KCN xa hơn theo lịch hẹn.</li>
            {litThap && <li>Quy đổi theo lít: <strong>{fmtVnd(litThap)} – {fmtVnd(litCao)} đ/lít</strong>, xô 18 L đắt hơn phuy khi tính theo lít.</li>}
            <li>{soMa} mã ISO VG 68 có hàng tại hệ thống 3 kho, tùy mã từng kho: {hangs.join(', ')}. {rows46.length} mã có thêm cấp 46, nhận đặt.</li>
            <li>Giá chính xác theo số phuy và nơi giao được gửi trong ngày làm việc. Có hóa đơn VAT, CO/CQ theo lô với hãng có cấp.</li>
          </ul>
        </div>
      )}

      {!coGia && (
        <ul class="trust">
          <li>Giao các KCN {KCN_NEAR.slice(0, 3).join(', ')} trong ngày</li>
          <li>Có hóa đơn VAT, CO/CQ theo lô với hãng có cấp</li>
        </ul>
      )}
      <QuoteCta item="Dầu thủy lực 68" compact />

    </header>

    <section class="price-body" id="bang-gia">
      <h2>Bảng giá dầu thủy lực 68 tại kho HT VINA</h2>

      {coGia ? (
        <>
          <PriceTable rows={rowsBang} {activePages} category={CATEGORY} gomVat={cauHinh.gom_vat} tds={tdsTheoTrang} {khoCuaDong} boLoc gon />
        </>
      ) : (
        <div class="empty">
          <p><strong>Bảng giá đang được cập nhật.</strong> Gửi tên dầu và số lượng cần mua để nhận báo giá trong ngày.</p>
          <QuoteCta item="Dầu thủy lực 68" compact />
        </div>
      )}

      <ul class="notes">
        <li>Đây là <strong>báo giá sơ bộ</strong>, ghi khoảng tham khảo cho một đơn vị đóng gói, {cauHinh.gom_vat ? 'đã gồm' : 'chưa gồm'} VAT. Giá chính xác phụ thuộc số lượng, quy cách và điểm giao.</li>
        <li>Cấp 46 của các mã trên có bảng giá riêng ngay bên dưới. Khi hỏi giá, hãy ghi rõ cấp 68 hay 46.</li>
        <li>Cột "Quy đổi" chia khoảng giá cho số lít trong phuy hoặc xô, để so sánh hai quy cách với nhau.</li>
        <li>"Có sẵn" không phải số tồn kho trực tiếp{TON_KHO_CAP_NHAT ? `, cập nhật ngày ${fmtNgay(TON_KHO_CAP_NHAT)}` : ''}. Hãy gọi xác nhận kho và số lượng trước khi chốt đơn.</li>
        <li>Mã không có trong bảng vẫn nhận đặt hàng. Gửi tên mã đang dùng, chúng tôi báo giá mã đó hoặc mã tương đương cùng cấp ISO VG.</li>
      </ul>

      {coGia && rows46.length > 0 && (
        <>
          <h2 id="bang-gia-46">Bảng giá dầu thủy lực 46</h2>
          <p>Dầu thủy lực 46 dùng cho máy xúc, máy đào, xe nâng và hệ thống thủy lực tải trung bình. Các mã dưới đây là cấp ISO VG 46 của cùng dòng dầu ở bảng 68, đóng phuy.</p>
          <PriceTable rows={rows46} {activePages} category={CATEGORY} gomVat={cauHinh.gom_vat} tds={tdsTheoTrang} gon />
          <ul class="notes">
            <li>Cấp 46 nhận đặt theo đơn. Gọi xác nhận kho và thời gian giao trước khi chốt.</li>
            <li>Máy đang dùng dầu 46 thì không thay bằng 68 cho rẻ. Xem <a href="/ho-tro-ky-thuat/dau-thuy-luc-32-46-68-khac-nhau">hướng dẫn chọn độ nhớt 32, 46 hay 68</a>.</li>
          </ul>
        </>
      )}

      <figure class="photo">
        <div class="delivery-grid">
          {ANH_KHO.map((a) => (
            <a href={a.src} target="_blank" rel="noopener">
              <img src={a.src} srcset={`${a.src.replace('.webp', '-600.webp')} 600w, ${a.src} 1200w`} sizes="(max-width: 700px) 50vw, 360px" alt={a.alt} width="1200" height="900" loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
        <figcaption>Ảnh kho 108 Đường Thanh Bình, P. Lê Thanh Nghị, TP Hải Phòng. Cập nhật ngày 01/11/2026.</figcaption>
      </figure>
    </section>

    <section class="price-body discount" id="chiet-khau">
      <h2>Doanh nghiệp cần chiết khấu hoặc giá linh hoạt</h2>
      <p>Bảng giá trên trang này là <strong>báo giá sơ bộ</strong>. Nếu muốn chiết khấu hoặc có chính sách giá linh hoạt riêng, bạn có thể liên lạc để đàm phán giá theo mã, sản lượng và thời hạn thanh toán. Để nhận được mức sát nhất ngay lần đầu, hãy gửi kèm:</p>
      <ul>
        <li>Mã dầu và sản lượng dự kiến mỗi tháng hoặc mỗi quý.</li>
        <li>Số điểm giao và lịch giao mong muốn.</li>
        <li>Thời hạn thanh toán đề nghị, tên công ty và mã số thuế.</li>
      </ul>
      <div class="discount__actions">
        <a href={QUOTE_DN} class="btn-primary" data-track="add_to_quote">Gửi yêu cầu riêng</a>
        <a href={`tel:${BUSINESS.phone}`} class="btn-secondary" data-track="click_tel">Gọi {BUSINESS.phoneDisplay}</a>
        <a href={BUSINESS.zaloUrl} class="btn-secondary" target="_blank" rel="noopener" data-track="click_zalo">Zalo</a>
      </div>
    </section>

    <section class="price-body" id="dat-bao-nhieu">
      <h2>Nên đặt bao nhiêu dầu? Tính theo máy của bạn</h2>
      <p>Mua ít quá thì máy dừng chờ dầu, lại phải mua lẻ từng xô với giá tính theo lít cao hơn phuy (xem cột "Quy đổi" ở bảng trên). Mua nhiều quá thì tiền nằm trong kho, chiếm chỗ, và phuy đã mở để lâu dễ hút ẩm. Số lượng hợp lý tính từ hai nhu cầu khác nhau của máy:</p>
      <form class="calc" id="tinh-dau" autocomplete="off" onsubmit="return false">
        <h3>Công cụ tính nhanh lượng dầu cần mua</h3>
        <div class="calc__grid">
          <label>Số máy thay dầu kỳ này<input type="number" name="soMay" min="0" step="1" inputmode="numeric" value={TINH_MAC_DINH.soMay} /></label>
          <label>Dung tích thùng dầu mỗi máy (L)<input type="number" name="litBon" min="0" inputmode="decimal" value={TINH_MAC_DINH.litBon} /></label>
          <label>Dầu ngoài thùng mỗi máy: ống, xi lanh (L)<input type="number" name="litNgoaiBon" min="0" inputmode="decimal" value={TINH_MAC_DINH.litNgoaiBon} /></label>
          <label>Thêm dầu cả xưởng mỗi tháng (L)<input type="number" name="chamBuThang" min="0" inputmode="decimal" value={TINH_MAC_DINH.chamBuThang} /></label>
          <label>Cần đủ dầu để thêm trong (tháng)<input type="number" name="soThang" min="0" step="1" inputmode="numeric" value={TINH_MAC_DINH.soThang} /></label>
          <label class="calc__check"><input type="checkbox" name="sucRua" /> Có súc rửa (dầu cũ nhiễm nước, đổi hãng hoặc đổi loại)</label>
        </div>
        <div class="calc__result" aria-live="polite">
          <p>Tổng cần: <strong id="tinh-tong">{fmtLit(kqMacDinh.tong)} L</strong></p>
          <p>Nên mua: <strong id="tinh-mua">{moTaMua(kqMacDinh)}</strong></p>
          <p class="small" id="tinh-du">Dư {fmtLit(kqMacDinh.du)} L, đủ thêm dầu khoảng {fmtLit(kqMacDinh.thangDu ?? 0)} tháng.</p>
        </div>
        <a id="tinh-gui" href={yeuCauTinh(moTaMua(kqMacDinh), kqMacDinh.tong)} class="btn-primary" data-track="click_tinh_dau_gui_yeu_cau">Gửi yêu cầu giá cho số lượng này</a>
        <p class="small">Kết quả là ước lượng theo phuy {LIT_PHUY} L và xô {LIT_XO} L. Hãy lấy dung tích từ tài liệu máy và đối chiếu lại trước khi đặt hàng.</p>
      </form>

      <div class="table-wrap">
        <table class="match">
          <thead>
            <tr><th scope="col">Nhu cầu</th><th scope="col">Cách tính</th><th scope="col">Lấy số ở đâu</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Thêm dầu hằng tháng</strong> (rò rỉ, hao hụt khi bảo trì)</td>
              <td>Tổng số lít thêm vào tất cả máy trong một tháng</td>
              <td>Ghi sổ mỗi lần thêm dầu trong 1–2 tháng, lấy số trung bình. Đừng ước lượng bằng mắt.</td>
            </tr>
            <tr>
              <td><strong>Thay dầu định kỳ</strong></td>
              <td>Tổng lượng dầu của máy (thùng + ống, xi lanh) × số máy thay trong kỳ, cộng một lượt súc rửa nếu dầu cũ nhiễm nước hoặc đổi hãng</td>
              <td>Tài liệu máy. Dầu ngoài thùng có thể chiếm phần lớn: theo <a href="https://www.yanmar.com/jp/construction/service_support/oil/cycle.html" rel="noopener">bảng bảo dưỡng của Yanmar</a>, máy xúc ViO80-1B có 60 L trong thùng và 56 L ngoài thùng.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3>Ví dụ minh họa: xưởng 3 máy ép, thùng dầu 200 L mỗi máy</h3>
      <p>Giả sử sổ ghi lượng dầu thêm trung bình 36 L/tháng cho cả 3 máy, và tháng này đến lịch thay dầu một máy (thùng 200 L, tài liệu máy ghi thêm khoảng 40 L nằm trong ống và xi lanh).</p>
      <ul>
        <li>Thay dầu một máy: 200 + 40 = 240 L.</li>
        <li>Thêm dầu tháng này: 36 L.</li>
        <li>Tổng cần khoảng 276 L. <strong>Đặt 2 phuy 200 L</strong>: một phuy cho lần thay dầu, phuy thứ hai dùng để thay nốt phần còn thiếu rồi thêm dầu trong khoảng ba tháng tiếp theo. Mua lẻ 4–5 xô thay cho phuy thứ hai sẽ tốn hơn khi tính theo lít.</li>
        <li>Không mở phuy thứ hai cho tới khi cần. Phuy còn nguyên niêm giữ chất lượng lâu hơn nhiều so với phuy đã mở.</li>
      </ul>

      <h3>Mức tồn kho gợi ý theo quy mô</h3>
      <div class="table-wrap">
        <table class="match">
          <thead>
            <tr><th scope="col">Xưởng của bạn</th><th scope="col">Nên mua</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>1–2 máy, thêm dưới một xô dầu mỗi tháng</td>
              <td>Xô 18 L để thêm dầu. Đến lịch thay dầu thì đặt đúng số phuy cho lần thay đó, không trữ sẵn.</td>
            </tr>
            <tr>
              <td>Nhiều máy dùng chung một loại dầu, thêm dầu đều đặn</td>
              <td>Giữ một phuy đang dùng và một phuy dự phòng còn niêm. Mở phuy dự phòng thì đặt phuy mới.</td>
            </tr>
            <tr>
              <td>Nhà máy dùng nhiều phuy mỗi tháng</td>
              <td>Hợp đồng giao định kỳ theo lịch. Tồn kho chỉ cần đủ dùng giữa hai lần giao, cộng vài ngày dự phòng.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>Kho HT VINA ở {AREA_TEXT}, giao trong ngày tới các KCN {KCN_NEAR.slice(0, 3).join(', ')}. Vì vậy xưởng gần kho không cần trữ nhiều dầu. Gửi số máy, dung tích thùng và lượng dầu thêm hằng tháng qua <a href={QUOTE_THUONG}>form báo giá</a>, chúng tôi tính giúp số phuy, số xô và lịch giao hợp lý.</p>
      <p>Các bước xả, súc rửa và nạp dầu mới có trong <a href="/ho-tro-ky-thuat/huong-dan-thay-dau-thuy-luc">hướng dẫn thay dầu thủy lực</a>. Chưa chắc dầu trong máy đã cần thay thì xem <a href="/ho-tro-ky-thuat/huong-dan-test-chat-luong-dau">hướng dẫn test chất lượng dầu tại xưởng</a> trước khi mua: không thay sớm cũng là một cách tiết kiệm.</p>
    </section>

    <section class="price-body" id="giao-hang">
      <h2>Giao hàng và chứng từ</h2>
      <div class="table-wrap">
        <table class="match">
          <tbody>
            <tr><th scope="row">Kho xuất hàng</th><td>Kho chính {ADDRESS_TEXT}. {KHO_GIAO_HANG.map((k) => `${k.name}: ${k.addressText}.`).join(' ')}</td></tr>
            <tr><th scope="row">Phí vận chuyển</th><td>Miễn phí trong bán kính 80 km tính từ kho có hàng gần điểm giao nhất, không yêu cầu đơn tối thiểu. Đơn từ 3 phuy trở lên được miễn phí tới 150 km. Xa hơn hoặc đơn số lượng lớn, vui lòng liên hệ trực tiếp để yêu cầu vận chuyển miễn phí theo từng trường hợp.</td></tr>
            <tr><th scope="row">Thời gian</th><td>Giao trong ngày tới các KCN {KCN_NEAR.join(', ')} khi chốt đơn trước {PROMO.sameDayCutoff}, thứ Hai đến thứ Sáu, với hàng có sẵn. KCN xa hơn và các tỉnh khác theo lịch hẹn.</td></tr>
            <tr><th scope="row">Chứng từ</th><td>Phiếu giao hàng, hóa đơn VAT điện tử, CO/CQ theo lô với các hãng có cấp chứng từ này. TDS và SDS gửi kèm khi bạn yêu cầu.</td></tr>
            <tr><th scope="row">Khi nhận hàng</th><td>Kiểm tra tên hàng, cấp độ nhớt, số lượng, nắp và niêm phong. Đổi trả trong 7 ngày theo <a href="/chinh-sach-doi-tra">chính sách đổi trả</a>.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="small">Chi tiết xem tại <a href="/chinh-sach-giao-hang">chính sách giao hàng</a>.</p>

