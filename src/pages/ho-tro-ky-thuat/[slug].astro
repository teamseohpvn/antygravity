---
// Bài viết blog tại /ho-tro-ky-thuat/<tên file>. Bài có `duong_dan` dựng ở src/pages/[...duong_dan].astro.
import BaiViet from '../../components/BaiViet.astro';
import { getActivePosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = (await getActivePosts()).filter((post) => !post.data.duong_dan);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BaiViet {post} />
