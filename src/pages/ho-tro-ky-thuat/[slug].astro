---
import Layout from '../../layouts/Layout.astro';
import ContentBody from '../../components/ContentBody.astro';
import { render } from 'astro:content';
import { getActivePosts } from '../../lib/content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { absUrl, breadcrumbSchema, ORG_ID, SITE_NAME } from '../../lib/site';
import { displayName, personRef, personSchema, personUrl, timNhanSu } from '../../lib/nhan-su';

export async function getStaticPaths() {
  const posts = await getActivePosts();
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const pagePath = `/ho-tro-ky-thuat/${post.id}`;
// Tác giả có hồ sơ trong nhan-su.ts (author = id hoặc họ tên) thì link tới trang hồ sơ và gắn schema Person đầy đủ.
const authorP = timNhanSu(post.data.author);
const crumbs = [
  { name: 'Trang chủ', href: '/' },
  { name: 'Hỗ trợ kỹ thuật', href: '/ho-tro-ky-thuat' },
  { name: post.data.title, href: pagePath },
];

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    url: absUrl(pagePath),
    ...(post.data.image ? { image: absUrl(post.data.image) } : {}),
    mainEntityOfPage: absUrl(pagePath),
    // Chưa có tác giả thật thì ghi doanh nghiệp, không dùng tên giả định.
    author: authorP
      ? personRef(authorP)
      : post.data.author
      ? { '@type': 'Person', name: post.data.author, ...(post.data.author_title ? { jobTitle: post.data.author_title } : {}) }
      : { '@id': ORG_ID },
    ...(post.data.date ? { datePublished: String(post.data.date) } : {}),
    ...(post.data.updated || post.data.date ? { dateModified: String(post.data.updated ?? post.data.date) } : {}),
    publisher: { '@id': ORG_ID },
  },
  ...(authorP ? [personSchema(authorP)] : []),
  breadcrumbSchema(crumbs),
];
---

<Layout 
  title={post.data.title}
  seoTitle={post.data.seo_title}
  description={post.data.description}
  image={post.data.image}
  type="article"
  schemaData={schemaData}
>
  <div class="container blog-container">
    <Breadcrumbs items={crumbs} />

    <article class="blog-post">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <div class="meta">
          Đăng ngày: <span>{post.data.date}</span>
          {post.data.updated && <> | Cập nhật: <span>{post.data.updated}</span></>}
          | Tác giả: {authorP
            ? <span><a href={personUrl(authorP)} rel="author">{displayName(authorP)}</a>, {authorP.degree}, {authorP.affiliation}</span>
            : <span>{post.data.author ?? SITE_NAME}{post.data.author_title && `, ${post.data.author_title}`}</span>}
        </div>
        {post.data.tags && (
          <div class="tags">
            {post.data.tags.map(tag => (
              <span class="badge">{tag}</span>
            ))}
          </div>
        )}
      </header>

      {post.data.image && (
        <div class="featured-image">
          <img src={post.data.image} alt={post.data.image_alt ?? post.data.title} loading="lazy" decoding="async" />
        </div>
      )}

      <div class="markdown-body">
        <ContentBody><Content /></ContentBody>
      </div>
    </article>
  </div>
</Layout>

<style>
  .blog-container { max-width: 900px; margin: 40px auto; }
  .breadcrumbs { margin-bottom: 30px; color: var(--color-text-light); font-size: 0.9rem; }
  .breadcrumbs a { color: var(--color-primary); }
  
  .blog-post { background: white; padding: 50px; border-radius: 8px; border: 1px solid var(--border-color); }
  .post-header { margin-bottom: 30px; text-align: center; }
  .post-header h1 { color: var(--color-primary); font-size: 2.5rem; line-height: 1.3; margin-bottom: 15px; }
  .meta { color: var(--color-text-light); font-size: 0.95rem; margin-bottom: 15px; }
  
  .tags { display: flex; justify-content: center; gap: 10px; margin-bottom: 20px; }
  .badge { background: #e2e8f0; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 500; }
  
  .featured-image { margin-bottom: 40px; }
  .featured-image img { width: 100%; border-radius: 8px; }
  
  /* Markdown Content Styles */
  .markdown-body { font-size: 1.1rem; line-height: 1.8; color: var(--color-text); }
  .markdown-body h2 { color: var(--color-primary); margin: 30px 0 15px; font-size: 1.8rem; }
  .markdown-body h3 { color: var(--color-primary); margin: 25px 0 10px; font-size: 1.4rem; }
  .markdown-body p { margin-bottom: 20px; }
  .markdown-body ul, .markdown-body ol { margin-left: 20px; margin-bottom: 20px; }
  .markdown-body li { margin-bottom: 10px; }
  .markdown-body strong { color: #111; }
</style>
