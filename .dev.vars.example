# Sao chép thành .dev.vars khi chạy local (không commit .dev.vars).
# Biến PUBLIC_* đọc lúc build; đặt trong môi trường build cho production.
PUBLIC_SITE_URL=https://daucongnghiephp.com.vn
# Chỉ đặt true trên bản production khi ra mắt. Mọi môi trường khác giữ false (noindex).
PUBLIC_INDEXABLE=false
PUBLIC_GA4_ID=
QUOTE_TELEGRAM_BOT_TOKEN=
QUOTE_TELEGRAM_CHAT_ID=
QUOTE_WEBHOOK_URL=
# Trang quản trị giá /quan-tri (production: đặt bằng `wrangler secret put` hoặc Dashboard).
ADMIN_PASSWORD=
# Chuỗi ngẫu nhiên ≥ 32 ký tự: openssl rand -hex 32
ADMIN_SECRET=
